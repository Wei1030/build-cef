index 0000000..f914f3c
--- /dev/null
+++ b/cef/include/cef_external_video.h
@@ -0,0 +1,365 @@
+// Copyright (c) 2026. All rights reserved.
+//
+// External video source API (custom extension, not part of upstream CEF).
+//
+// Lets the host application push decoded YUV 4:2:0 frames (YV12 / I420) into
+// Chromium. Each source is registered as a virtual video capture device, so a
+// page can show it with:
+//
+//   const d = (await navigator.mediaDevices.enumerateDevices())
+//                 .find(x => x.kind === 'videoinput' && x.label === label);
+//   video.srcObject = await navigator.mediaDevices.getUserMedia(
+//       {video: {deviceId: {exact: d.deviceId}}, audio: false});
+//
+// Rendering then goes through the regular <video> / compositor path, so all
+// CSS (transform, object-fit, border-radius, filter, ...) applies.
+//
+// Usage notes:
+// - Call only after CefInitialize() and before CefShutdown(). Destroy every
+//   source before calling CefShutdown().
+// - All functions may be called from any thread.
+// - The page must be allowed to use the camera: either pass the
+//   "--enable-media-stream" command-line switch or implement
+//   CefPermissionHandler::OnRequestMediaAccessPermission().
+// - The page must be a secure context (file:// or a scheme registered as
+//   secure).
+// - This is a live-stream path: the newest frame is shown as soon as it
+//   arrives. Frames pushed faster than they can be delivered are dropped.
+// - Only 8-bit 4:2:0 SDR content is supported.
+
+#ifndef CEF_INCLUDE_CEF_EXTERNAL_VIDEO_H_
+#define CEF_INCLUDE_CEF_EXTERNAL_VIDEO_H_
+#pragma once
+
+#include <stdint.h>
+
+#include "include/internal/cef_export.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+///
+/// Opaque handle to an external video source.
+///
+typedef struct _cef_external_video_t cef_external_video_t;
+
+// ---------------------------------------------------------------------------
+// Color description
+// ---------------------------------------------------------------------------
+//
+// YUV numbers only become colors once you know how they were encoded. That is
+// described by four independent parameters (see cef_external_video_color_t):
+//
+//   matrix     YUV <-> RGB conversion coefficients. Wrong value: slight hue
+//              shift (reds/greens/skin tones).
+//   range      Limited (Y 16..235) or full (Y 0..255). Wrong value: very
+//              visible (washed-out grey, or crushed blacks / blown highlights).
+//   primaries  Which red/green/blue the RGB values refer to (color gamut).
+//              Wrong value: colors too dull or too saturated.
+//   transfer   Brightness curve (gamma). Wrong value: brightness/contrast off.
+//
+// The numeric values of primaries / transfer / matrix are the code points of
+// ITU-T H.273 (ISO/IEC 23091-2). They are the same numbers that are carried
+// in the bitstream and exposed by most decoders, so they can usually be passed
+// through unchanged:
+//
+//   H.264 / H.265 VUI (SPS):
+//       colour_primaries          -> primaries
+//       transfer_characteristics  -> transfer
+//       matrix_coefficients       -> matrix
+//       video_full_range_flag     -> range (0 -> LIMITED, 1 -> FULL)
+//     If video_signal_type_present_flag or colour_description_present_flag is
+//     0, the stream says nothing: use UNSPECIFIED (2) for the missing fields
+//     (and range UNSPECIFIED if video_signal_type_present_flag is 0).
+//   AV1 sequence header color_config: color_primaries, transfer_characteristics,
+//     matrix_coefficients, color_range (0 -> LIMITED, 1 -> FULL).
+//   FFmpeg: AVFrame::color_primaries, color_trc, colorspace, color_range. All
+//     four use exactly the numbers below (AVColorRange: 0 unspecified,
+//     1 MPEG = limited, 2 JPEG = full); cast directly. Note that the
+//     "yuvj420p" pixel format also means full range.
+//   Intel oneVPL / Media SDK (mfxExtVideoSignalInfo): ColourPrimaries,
+//     TransferCharacteristics, MatrixCoefficients (H.273 numbers),
+//     VideoFullRange (0 -> LIMITED, 1 -> FULL).
+//   NVIDIA Video Codec SDK (CUVIDEOFORMAT::video_signal_description):
+//     color_primaries, transfer_characteristics, matrix_coefficients (H.273
+//     numbers), video_full_range_flag (0 -> LIMITED, 1 -> FULL).
+//   Windows Media Foundation (MF_MT_VIDEO_PRIMARIES, MF_MT_TRANSFER_FUNCTION,
+//     MF_MT_YUV_MATRIX, MF_MT_VIDEO_NOMINAL_RANGE) and DXGI_COLOR_SPACE_TYPE
+//     use their OWN numbering: convert by name (e.g. MFVideoTransferMatrix_BT709
+//     -> MATRIX_BT709, MFVideoTransferMatrix_BT601 -> MATRIX_SMPTE170M,
+//     MFNominalRange_16_235 -> RANGE_LIMITED, MFNominalRange_0_255 ->
+//     RANGE_FULL); do NOT cast the numbers.
+//   libvpx (VP9) vpx_image_t::cs also uses its own enum: VPX_CS_BT_601 ->
+//     MATRIX_SMPTE170M, VPX_CS_BT_709 -> MATRIX_BT709, VPX_CS_SMPTE_170 ->
+//     MATRIX_SMPTE170M, VPX_CS_SMPTE_240 -> MATRIX_SMPTE240M, VPX_CS_BT_2020 ->
+//     MATRIX_BT2020_NCL; vpx_image_t::range: VPX_CR_STUDIO_RANGE -> LIMITED,
+//     VPX_CR_FULL_RANGE -> FULL. Primaries/transfer: UNSPECIFIED.
+//   Decoders that give you only pixels (e.g. many camera vendor playback SDKs
+//     that call back with YV12): you know nothing, use UNSPECIFIED for all
+//     four and verify the range visually (see below).
+//
+// Unknown / unspecified handling: values not listed below (0, 3, reserved
+// numbers, ...) are treated as UNSPECIFIED. Unspecified fields are guessed
+// from the specified ones. If primaries, transfer and matrix are all
+// unspecified, the frame size decides: height >= 720 -> BT.709, otherwise
+// BT.601 (SMPTE 170M), which is what FFmpeg and most players do. Unspecified
+// range means LIMITED.
+//
+// Practical advice when nothing is signaled:
+// - HD (720p and up) content: BT.709 + LIMITED is by far the most common.
+// - SD content: BT.601 (SMPTE170M) + LIMITED.
+// - Many IP / surveillance cameras encode FULL range ("yuvj420p" in FFmpeg).
+//   If the picture looks too contrasty with black areas crushed, it is full
+//   range shown as limited; if it looks grey and washed out, it is limited
+//   range shown as full.
+// - Do NOT label everything BT.2020 "to be safe": the label must describe how
+//   the pixels were actually encoded. BT.709 content labeled BT.2020 is shown
+//   with shifted hues and oversaturated colors.
+
+///
+/// Color primaries (ITU-T H.273 Table 2, "ColourPrimaries").
+///
+typedef enum {
+  /// BT.709 / sRGB / sYCC / IEC 61966-2-1. HD video, most cameras, the web.
+  CEF_EXTERNAL_VIDEO_PRIMARIES_BT709 = 1,
+  /// Unknown: guessed (see above).
+  CEF_EXTERNAL_VIDEO_PRIMARIES_UNSPECIFIED = 2,
+  /// BT.470 System M (1953 NTSC), FCC Title 47.
+  CEF_EXTERNAL_VIDEO_PRIMARIES_BT470M = 4,
+  /// BT.470 System B/G, BT.601 625-line (PAL/SECAM SD), BT.1700 625 PAL.
+  CEF_EXTERNAL_VIDEO_PRIMARIES_BT470BG = 5,
+  /// SMPTE 170M, BT.601 525-line (NTSC SD), BT.1700 NTSC.
+  CEF_EXTERNAL_VIDEO_PRIMARIES_SMPTE170M = 6,
+  /// SMPTE 240M (same primaries as SMPTE 170M).
+  CEF_EXTERNAL_VIDEO_PRIMARIES_SMPTE240M = 7,
+  /// Generic film (color filters using Illuminant C).
+  CEF_EXTERNAL_VIDEO_PRIMARIES_FILM = 8,
+  /// BT.2020 / BT.2100. UHD wide color gamut (normally 10-bit HDR).
+  CEF_EXTERNAL_VIDEO_PRIMARIES_BT2020 = 9,
+  /// SMPTE ST 428-1 (CIE 1931 XYZ, digital cinema).
+  CEF_EXTERNAL_VIDEO_PRIMARIES_SMPTEST428_1 = 10,
+  /// SMPTE RP 431-2 (DCI-P3, DCI white point).
+  CEF_EXTERNAL_VIDEO_PRIMARIES_SMPTEST431_2 = 11,
+  /// SMPTE EG 432-1 (Display P3, D65 white point).
+  CEF_EXTERNAL_VIDEO_PRIMARIES_SMPTEST432_1 = 12,
+  /// EBU Tech 3213-E (JEDEC P22 phosphors).
+  CEF_EXTERNAL_VIDEO_PRIMARIES_EBU3213E = 22,
+} cef_external_video_primaries_t;
+
+///
+/// Transfer characteristics (ITU-T H.273 Table 3,
+/// "TransferCharacteristics").
+///
+typedef enum {
+  /// BT.709. Also the curve used by BT.601 and SDR BT.2020 content.
+  CEF_EXTERNAL_VIDEO_TRANSFER_BT709 = 1,
+  /// Unknown: guessed (see above).
+  CEF_EXTERNAL_VIDEO_TRANSFER_UNSPECIFIED = 2,
+  /// Assumed display gamma 2.2 (BT.470 System M).
+  CEF_EXTERNAL_VIDEO_TRANSFER_GAMMA22 = 4,
+  /// Assumed display gamma 2.8 (BT.470 System B/G).
+  CEF_EXTERNAL_VIDEO_TRANSFER_GAMMA28 = 5,
+  /// SMPTE 170M / BT.601 (functionally the same curve as BT709 = 1).
+  CEF_EXTERNAL_VIDEO_TRANSFER_SMPTE170M = 6,
+  /// SMPTE 240M.
+  CEF_EXTERNAL_VIDEO_TRANSFER_SMPTE240M = 7,
+  /// Linear light.
+  CEF_EXTERNAL_VIDEO_TRANSFER_LINEAR = 8,
+  /// Logarithmic, 100:1 range.
+  CEF_EXTERNAL_VIDEO_TRANSFER_LOG = 9,
+  /// Logarithmic, 100 * sqrt(10) : 1 range.
+  CEF_EXTERNAL_VIDEO_TRANSFER_LOG_SQRT = 10,
+  /// IEC 61966-2-4 (xvYCC).
+  CEF_EXTERNAL_VIDEO_TRANSFER_IEC61966_2_4 = 11,
+  /// BT.1361 extended color gamut.
+  CEF_EXTERNAL_VIDEO_TRANSFER_BT1361_ECG = 12,
+  /// IEC 61966-2-1 (sRGB / sYCC). Typical for JPEG-like full range sources.
+  CEF_EXTERNAL_VIDEO_TRANSFER_IEC61966_2_1 = 13,
+  /// BT.2020 10-bit (same curve as BT709 = 1).
+  CEF_EXTERNAL_VIDEO_TRANSFER_BT2020_10 = 14,
+  /// BT.2020 12-bit (same curve as BT709 = 1).
+  CEF_EXTERNAL_VIDEO_TRANSFER_BT2020_12 = 15,
+  /// SMPTE ST 2084 / BT.2100 PQ (HDR10). HDR: not meaningful for this 8-bit
+  /// path, avoid.
+  CEF_EXTERNAL_VIDEO_TRANSFER_SMPTEST2084 = 16,
+  /// SMPTE ST 428-1.
+  CEF_EXTERNAL_VIDEO_TRANSFER_SMPTEST428_1 = 17,
+  /// ARIB STD-B67 / BT.2100 HLG. HDR: not meaningful for this 8-bit path,
+  /// avoid.
+  CEF_EXTERNAL_VIDEO_TRANSFER_ARIB_STD_B67 = 18,
+} cef_external_video_transfer_t;
+
+///
+/// Matrix coefficients (ITU-T H.273 Table 4, "MatrixCoefficients").
+/// Values 0 (identity / RGB), 12, 13 and 14 are not usable for YUV 4:2:0 input
+/// in this Chromium version and are treated as UNSPECIFIED.
+///
+typedef enum {
+  /// BT.709. HD video, most cameras.
+  CEF_EXTERNAL_VIDEO_MATRIX_BT709 = 1,
+  /// Unknown: guessed (see above).
+  CEF_EXTERNAL_VIDEO_MATRIX_UNSPECIFIED = 2,
+  /// FCC Title 47 (old NTSC).
+  CEF_EXTERNAL_VIDEO_MATRIX_FCC = 4,
+  /// BT.470 System B/G, BT.601 625-line (same coefficients as SMPTE170M = 6).
+  CEF_EXTERNAL_VIDEO_MATRIX_BT470BG = 5,
+  /// SMPTE 170M, BT.601 525-line. "BT.601" in most libraries means this.
+  CEF_EXTERNAL_VIDEO_MATRIX_SMPTE170M = 6,
+  /// SMPTE 240M.
+  CEF_EXTERNAL_VIDEO_MATRIX_SMPTE240M = 7,
+  /// YCgCo.
+  CEF_EXTERNAL_VIDEO_MATRIX_YCOCG = 8,
+  /// BT.2020 non-constant luminance (the common BT.2020 / BT.2100 YCbCr).
+  CEF_EXTERNAL_VIDEO_MATRIX_BT2020_NCL = 9,
+  /// BT.2020 constant luminance (rare).
+  CEF_EXTERNAL_VIDEO_MATRIX_BT2020_CL = 10,
+  /// SMPTE ST 2085 (Y'D'zD'x, rare).
+  CEF_EXTERNAL_VIDEO_MATRIX_YDZDX = 11,
+} cef_external_video_matrix_t;
+
+///
+/// Value range. NOTE: this is not an H.273 code point; convert from
+/// video_full_range_flag as 0 -> LIMITED, 1 -> FULL. The numbers do match
+/// FFmpeg's AVColorRange.
+///
+typedef enum {
+  /// Unknown: treated as LIMITED.
+  CEF_EXTERNAL_VIDEO_RANGE_UNSPECIFIED = 0,
+  /// Limited / "TV" / "MPEG" / studio range: Y 16..235, U/V 16..240.
+  /// Used by almost all broadcast and internet video.
+  CEF_EXTERNAL_VIDEO_RANGE_LIMITED = 1,
+  /// Full / "PC" / "JPEG" range: Y, U, V 0..255. Used by JPEG/MJPEG and many
+  /// IP / surveillance cameras ("yuvj420p").
+  CEF_EXTERNAL_VIDEO_RANGE_FULL = 2,
+} cef_external_video_range_t;
+
+///
+/// Color description of a frame. Each field takes a value of the enum named
+/// in its comment; plain ints are used so values coming from other libraries
+/// can be assigned without casts.
+///
+typedef struct _cef_external_video_color_t {
+  /// cef_external_video_primaries_t (H.273 ColourPrimaries).
+  int primaries;
+  /// cef_external_video_transfer_t (H.273 TransferCharacteristics).
+  int transfer;
+  /// cef_external_video_matrix_t (H.273 MatrixCoefficients).
+  int matrix;
+  /// cef_external_video_range_t.
+  int range;
+} cef_external_video_color_t;
+
+///
+/// Defaults used by cef_external_video_create() when 0 is passed.
+/// 8192 x 8192 covers 4K, 8K UHD (7680x4320), DCI 8K (8192x4320) and their
+/// portrait variants, matches the largest picture common hardware decoders
+/// accept, and stays within the 8192 texture limit of Direct3D 10 class GPUs.
+///
+#define CEF_EXTERNAL_VIDEO_DEFAULT_MAX_WIDTH 8192
+#define CEF_EXTERNAL_VIDEO_DEFAULT_MAX_HEIGHT 8192
+#define CEF_EXTERNAL_VIDEO_DEFAULT_MAX_FPS 30.0f
+
+///
+/// Creates a source and registers it as a virtual video capture device.
+///
+/// |device_id| must be unique among all sources (UTF-8). |label| is the
+/// device label the page sees in enumerateDevices() (UTF-8); it is the value
+/// the page should match on, because the deviceId seen by the page is hashed
+/// per origin.
+///
+/// |max_width| x |max_height| @ |max_fps| is registered as the device's only
+/// supported format. Pass 0 for any of them to use the defaults above. What
+/// they affect:
+/// - Upper bound of the frame size: cef_external_video_push_frame() rejects
+///   larger frames. Smaller frames are shown unchanged (never upscaled), so a
+///   large value costs nothing; buffers are sized per actual frame.
+/// - getUserMedia() constraints are checked against this format (e.g. asking
+///   for {width: {min: 3840}} fails if max_width is 1920), and
+///   track.getSettings() reports it as width/height. Use video.videoWidth /
+///   video.videoHeight in the page for the real frame size.
+/// - |max_fps| sets the "no signal" timeout: when no frame arrives for
+///   25 / max_fps seconds (100 / max_fps before the first frame) the track
+///   becomes muted (track.onmute), and unmuted again with the next frame. The
+///   last frame stays on screen. Use the stream's nominal frame rate.
+///
+/// Returns NULL if the arguments are invalid (negative values, a size above
+/// 32767 per side or 16384 x 16384 pixels in total, max_fps above 1000) or CEF
+/// is not initialized.
+///
+CEF_EXPORT cef_external_video_t* cef_external_video_create(
+    const char* device_id,
+    const char* label,
+    int max_width,
+    int max_height,
+    float max_fps);
+
+///
+/// Pushes one YUV 4:2:0 planar 8-bit frame. The planes are given explicitly,
+/// so the same call works for YV12 (plane order Y, V, U in memory) and I420
+/// (Y, U, V): just pass the right pointers. Chroma planes are
+/// ((width + 1) / 2) x ((height + 1) / 2).
+///
+/// |color| describes how this frame was encoded and may differ from frame to
+/// frame (normally it only changes when the stream's SPS changes, but passing
+/// the same value with every frame is cheap). NULL means "all unspecified".
+///
+/// The data is copied before this function returns. |timestamp_us| is the
+/// presentation timestamp in microseconds and should increase monotonically.
+/// |width| and |height| may change between calls but must not exceed the
+/// maximum given to cef_external_video_create().
+///
+/// Returns 1 if the frame was accepted, 0 if it was rejected (invalid
+/// arguments, the source is being destroyed, or the connection to the video
+/// capture service was lost; in the last case destroy the source and create a
+/// new one). An accepted frame may still be dropped later in favour of a newer
+/// one. Do not call this concurrently with cef_external_video_destroy() on the
+/// same source.
+///
+CEF_EXPORT int cef_external_video_push_frame(
+    cef_external_video_t* source,
+    const uint8_t* y,
+    int y_stride,
+    const uint8_t* u,
+    int u_stride,
+    const uint8_t* v,
+    int v_stride,
+    int width,
+    int height,
+    int64_t timestamp_us,
+    const cef_external_video_color_t* color);
+
+///
+/// Unregisters the device and frees the source. Pages that are showing it see
+/// the track end. |source| must not be used afterwards.
+///
+CEF_EXPORT void cef_external_video_destroy(cef_external_video_t* source);
+
+///
+/// Convenience helper for a contiguous YV12 buffer: Y plane (stride |y_stride|)
+/// followed by the V plane and then the U plane (both with stride
+/// |y_stride| / 2), with no padding rows.
+///
+static inline int cef_external_video_push_yv12(
+    cef_external_video_t* source,
+    const uint8_t* buffer,
+    int y_stride,
+    int width,
+    int height,
+    int64_t timestamp_us,
+    const cef_external_video_color_t* color) {
+  const int c_stride = y_stride / 2;
+  const int c_height = (height + 1) / 2;
+  const uint8_t* y = buffer;
+  const uint8_t* v = y + (int64_t)y_stride * height;
+  const uint8_t* u = v + (int64_t)c_stride * c_height;
+  return cef_external_video_push_frame(source, y, y_stride, u, c_stride, v,
+                                       c_stride, width, height, timestamp_us,
+                                       color);
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // CEF_INCLUDE_CEF_EXTERNAL_VIDEO_H_
