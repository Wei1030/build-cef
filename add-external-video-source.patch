+namespace cef_external_video {
+
+// Converts the color description of the C API into a gfx::ColorSpace. NULL or
+// unspecified fields are resolved as documented in
+// include/cef_external_video.h; |height| is the frame height.
+gfx::ColorSpace ToGfxColorSpace(const cef_external_video_color_t* color,
+                                int height);
+
+// One external video source. Registered with the video capture service as a
+// shared-memory virtual device.
+//
+// Threading:
+// - Create(), PushFrame() and Shutdown() may be called on any thread.
+// - All mojo state lives on |task_runner_|, a dedicated sequence, so the
+//   per-frame copy into shared memory never runs on the browser UI thread.
+// - The object is ref-counted and always deleted on |task_runner_|.
+class ExternalVideoSource
+    : public base::RefCountedDeleteOnSequence<ExternalVideoSource>,
+      public video_capture::mojom::Producer {
+ public:
+  // Returns nullptr if the arguments are invalid or CEF is not initialized.
+  static scoped_refptr<ExternalVideoSource> Create(const std::string& device_id,
+                                                   const std::string& label,
+                                                   const gfx::Size& max_size,
+                                                   float max_fps);
+
+  ExternalVideoSource(const ExternalVideoSource&) = delete;
+  ExternalVideoSource& operator=(const ExternalVideoSource&) = delete;
+
+  // Copies the frame. |color_space| describes this frame. Returns false if it
+  // was rejected.
+  bool PushFrame(const uint8_t* y,
+                 int y_stride,
+                 const uint8_t* u,
+                 int u_stride,
+                 const uint8_t* v,
+                 int v_stride,
+                 int width,
+                 int height,
+                 int64_t timestamp_us,
+                 const gfx::ColorSpace& color_space);
+
+  // Unregisters the device. Further PushFrame() calls are rejected.
+  void Shutdown();
+
+  // video_capture::mojom::Producer implementation (|task_runner_| only).
+  void OnNewBuffer(int32_t buffer_id,
+                   media::mojom::VideoBufferHandlePtr buffer_handle,
+                   OnNewBufferCallback callback) override;
+  void OnBufferRetired(int32_t buffer_id) override;
+
+ private:
+  friend class base::RefCountedDeleteOnSequence<ExternalVideoSource>;
+  friend class base::DeleteHelper<ExternalVideoSource>;
+
+  ExternalVideoSource(scoped_refptr<base::SequencedTaskRunner> task_runner,
+                      const media::VideoCaptureDeviceInfo& device_info,
+                      float max_fps);
+  ~ExternalVideoSource() override;
+
+  // |task_runner_| only.
+  void InitOnSequence(
+      mojo::PendingRemote<video_capture::mojom::VideoSourceProvider> provider);
+  void ShutdownOnSequence();
+  void RequestBufferOnSequence();
+  void OnBufferReady(scoped_refptr<media::VideoFrame> frame, int32_t buffer_id);
+  bool CopyToBuffer(const media::VideoFrame& frame,
+                    base::WritableSharedMemoryMapping& mapping);
+  void OnConnectionError();
+
+  // Immutable after construction.
+  const scoped_refptr<base::SequencedTaskRunner> task_runner_;
+  const media::VideoCaptureDeviceInfo device_info_;
+  const gfx::Size max_size_;
+  const float max_fps_;
+
+  // Shared between the pushing thread(s) and |task_runner_|.
+  base::Lock lock_;
+  // Newest frame that has not been handed to a buffer request yet.
+  scoped_refptr<media::VideoFrame> pending_frame_ GUARDED_BY(lock_);
+  // True while a RequestFrameBuffer() round trip is outstanding or scheduled.
+  bool request_in_flight_ GUARDED_BY(lock_) = false;
+  bool shut_down_ GUARDED_BY(lock_) = false;
+
+  // |task_runner_| only.
+  mojo::Remote<video_capture::mojom::VideoSourceProvider> provider_;
+  mojo::Remote<video_capture::mojom::SharedMemoryVirtualDevice> device_;
+  mojo::Receiver<video_capture::mojom::Producer> producer_receiver_{this};
+  std::map<int32_t, base::WritableSharedMemoryMapping> buffers_;
+};
+
+}  // namespace cef_external_video
+
+#endif  // CEF_LIBCEF_BROWSER_EXTERNAL_VIDEO_SOURCE_H_
