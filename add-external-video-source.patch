+
+#if defined(ARCH_CPU_X86_FAMILY) && !BUILDFLAG(IS_NACL)
+
+__attribute__((target("avx2"))) void StreamCopyBytes_AVX2(const uint8_t* src,
+                                                          uint8_t* dst,
+                                                          size_t count) {
+  if (count < 64) {
+    std::memcpy(dst, src, count);
+    return;
+  }
+
+  const uintptr_t misalign = reinterpret_cast<uintptr_t>(dst) & 31u;
+  if (misalign != 0) {
+    const size_t peel = 32u - misalign;
+    std::memcpy(dst, src, peel);
+    src += peel;
+    dst += peel;
+    count -= peel;
+  }
+
+  while (count >= 64) {
+    const __m256i v0 =
+        _mm256_loadu_si256(reinterpret_cast<const __m256i*>(src));
+    const __m256i v1 =
+        _mm256_loadu_si256(reinterpret_cast<const __m256i*>(src + 32));
+    _mm256_stream_si256(reinterpret_cast<__m256i*>(dst), v0);
+    _mm256_stream_si256(reinterpret_cast<__m256i*>(dst + 32), v1);
+    src += 64;
+    dst += 64;
+    count -= 64;
+  }
+
+  if (count > 0) {
+    std::memcpy(dst, src, count);
+  }
+}
+
+void StreamCopyBytes_SSE2(const uint8_t* src, uint8_t* dst, size_t count) {
+  if (count < 64) {
+    std::memcpy(dst, src, count);
+    return;
+  }
+
+  const uintptr_t misalign = reinterpret_cast<uintptr_t>(dst) & 15u;
+  if (misalign != 0) {
+    const size_t peel = 16u - misalign;
+    std::memcpy(dst, src, peel);
+    src += peel;
+    dst += peel;
+    count -= peel;
+  }
+
+  while (count >= 64) {
+    const __m128i v0 = _mm_loadu_si128(reinterpret_cast<const __m128i*>(src));
+    const __m128i v1 =
+        _mm_loadu_si128(reinterpret_cast<const __m128i*>(src + 16));
+    const __m128i v2 =
+        _mm_loadu_si128(reinterpret_cast<const __m128i*>(src + 32));
+    const __m128i v3 =
+        _mm_loadu_si128(reinterpret_cast<const __m128i*>(src + 48));
+    _mm_stream_si128(reinterpret_cast<__m128i*>(dst), v0);
+    _mm_stream_si128(reinterpret_cast<__m128i*>(dst + 16), v1);
+    _mm_stream_si128(reinterpret_cast<__m128i*>(dst + 32), v2);
+    _mm_stream_si128(reinterpret_cast<__m128i*>(dst + 48), v3);
+    src += 64;
+    dst += 64;
+    count -= 64;
+  }
+
+  if (count > 0) {
+    std::memcpy(dst, src, count);
+  }
+}
+
+[[maybe_unused]] __attribute__((target("avx2"))) void
+StreamInterleaveUVPairs_AVX2(const uint8_t* u,
+                             const uint8_t* v,
+                             uint8_t* dst_uv,
+                             size_t uv_pairs) {
+  const uintptr_t addr = reinterpret_cast<uintptr_t>(dst_uv);
+  if (uv_pairs < 32 || (addr & 1u) != 0) {
+    for (size_t i = 0; i < uv_pairs; ++i) {
+      dst_uv[2 * i] = u[i];
+      dst_uv[2 * i + 1] = v[i];
+    }
+    return;
+  }
+
+  const size_t misalign = addr & 31u;
+  if (misalign != 0) {
+    const size_t peel_pairs = (32u - misalign) / 2u;
+    for (size_t i = 0; i < peel_pairs; ++i) {
+      dst_uv[2 * i] = u[i];
+      dst_uv[2 * i + 1] = v[i];
+    }
+    u += peel_pairs;
+    v += peel_pairs;
+    dst_uv += peel_pairs * 2u;
+    uv_pairs -= peel_pairs;
+  }
+
+  while (uv_pairs >= 32) {
+    const __m256i u_vec =
+        _mm256_loadu_si256(reinterpret_cast<const __m256i*>(u));
+    const __m256i v_vec =
+        _mm256_loadu_si256(reinterpret_cast<const __m256i*>(v));
+    const __m256i lo = _mm256_unpacklo_epi8(u_vec, v_vec);
+    const __m256i hi = _mm256_unpackhi_epi8(u_vec, v_vec);
+    const __m256i out0 = _mm256_permute2x128_si256(lo, hi, 0x20);
+    const __m256i out1 = _mm256_permute2x128_si256(lo, hi, 0x31);
+    _mm256_stream_si256(reinterpret_cast<__m256i*>(dst_uv), out0);
+    _mm256_stream_si256(reinterpret_cast<__m256i*>(dst_uv + 32), out1);
+    u += 32;
+    v += 32;
+    dst_uv += 64;
+    uv_pairs -= 32;
+  }
+
+  for (size_t i = 0; i < uv_pairs; ++i) {
+    dst_uv[2 * i] = u[i];
+    dst_uv[2 * i + 1] = v[i];
+  }
+}
+
+[[maybe_unused]] void StreamInterleaveUVPairs_SSE2(const uint8_t* u,
+                                                   const uint8_t* v,
+                                                   uint8_t* dst_uv,
+                                                   size_t uv_pairs) {
+  const uintptr_t addr = reinterpret_cast<uintptr_t>(dst_uv);
+  if (uv_pairs < 16 || (addr & 1u) != 0) {
+    for (size_t i = 0; i < uv_pairs; ++i) {
+      dst_uv[2 * i] = u[i];
+      dst_uv[2 * i + 1] = v[i];
+    }
+    return;
+  }
+
+  const size_t misalign = addr & 15u;
+  if (misalign != 0) {
+    const size_t peel_pairs = (16u - misalign) / 2u;
+    for (size_t i = 0; i < peel_pairs; ++i) {
+      dst_uv[2 * i] = u[i];
+      dst_uv[2 * i + 1] = v[i];
+    }
+    u += peel_pairs;
+    v += peel_pairs;
+    dst_uv += peel_pairs * 2u;
+    uv_pairs -= peel_pairs;
+  }
+
+  while (uv_pairs >= 16) {
+    const __m128i u_vec = _mm_loadu_si128(reinterpret_cast<const __m128i*>(u));
+    const __m128i v_vec = _mm_loadu_si128(reinterpret_cast<const __m128i*>(v));
+    const __m128i out0 = _mm_unpacklo_epi8(u_vec, v_vec);
+    const __m128i out1 = _mm_unpackhi_epi8(u_vec, v_vec);
+    _mm_stream_si128(reinterpret_cast<__m128i*>(dst_uv), out0);
+    _mm_stream_si128(reinterpret_cast<__m128i*>(dst_uv + 16), out1);
+    u += 16;
+    v += 16;
+    dst_uv += 32;
+    uv_pairs -= 16;
+  }
+
+  for (size_t i = 0; i < uv_pairs; ++i) {
+    dst_uv[2 * i] = u[i];
+    dst_uv[2 * i + 1] = v[i];
+  }
+}
+
+inline bool CpuHasAvx2() {
+  static const bool kHasAvx2 =
+      base::CPU::GetInstanceNoAllocation().has_avx2();
