+bool IsHardwareGpuInfoUsable(const gpu::GPUInfo& gpu_info) {
+  if (gpu_info.software_rendering || gpu_info.UsesSwiftShader() ||
+      gpu_info.active_gpu().IsSoftwareRenderer()) {
+    return false;
+  }
+  if (gpu_info.gl_renderer.find("SwiftShader") != std::string::npos ||
+      gpu_info.gl_renderer.find("Basic Render") != std::string::npos ||
+      gpu_info.gl_renderer.find("llvmpipe") != std::string::npos ||
+      gpu_info.gl_renderer.find("softpipe") != std::string::npos) {
+    return false;
+  }
+#if BUILDFLAG(IS_WIN)
+  // D3DImageBackingFactory in the GPU process requires ANGLE D3D11.
+  if (gpu_info.gl_renderer.find("Direct3D11") == std::string::npos) {
+    return false;
+  }
+#endif
+  return true;
+}
