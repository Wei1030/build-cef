+// ---------------------------------------------------------------------------
+// ExternalVideoSource implementation
+// ---------------------------------------------------------------------------
+
+// static
+scoped_refptr<ExternalVideoSource> ExternalVideoSource::Create(
+    const std::string& device_id,
+    const std::string& label,
+    const gfx::Size& max_size,
+    float max_fps) {
+  if (!CONTEXT_STATE_VALID()) {
+    LOG(ERROR) << "cef_external_video: CEF is not initialized";
+    return nullptr;
+  }
+  const media::VideoCaptureFormat format(max_size, max_fps,
+                                         media::PIXEL_FORMAT_I420);
+  if (device_id.empty() || max_size.IsEmpty() || !(max_fps > 0.f) ||
+      !format.IsValid()) {
+    LOG(ERROR) << "cef_external_video: invalid arguments";
+    return nullptr;
+  }
+
+  media::VideoCaptureDeviceInfo device_info(media::VideoCaptureDeviceDescriptor(
+      label.empty() ? device_id : label, device_id,
+      media::VideoCaptureApi::VIRTUAL_DEVICE));
+  device_info.supported_formats.push_back(format);
+
+  scoped_refptr<base::SequencedTaskRunner> task_runner =
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::TaskPriority::USER_BLOCKING, base::WithBaseSyncPrimitives(),
+           base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN});
+
+  scoped_refptr<ExternalVideoSource> source(
+      new ExternalVideoSource(task_runner, device_info, max_fps));
+
+  content::GetUIThreadTaskRunner({})->PostTask(
+      FROM_HERE, base::BindOnce(&ExternalVideoSource::BootstrapOnUIThread,
+                                source));
+  return source;
+}
+
+ExternalVideoSource::ExternalVideoSource(
+    scoped_refptr<base::SequencedTaskRunner> task_runner,
+    const media::VideoCaptureDeviceInfo& device_info,
+    float max_fps)
+    : base::RefCountedDeleteOnSequence<ExternalVideoSource>(task_runner),
+      task_runner_(std::move(task_runner)),
+      device_info_(device_info),
+      max_size_(device_info.supported_formats[0].frame_size),
+      max_fps_(max_fps) {}
+
+ExternalVideoSource::~ExternalVideoSource() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  ShutdownOnSequence();
+}
+
+// static
+void ExternalVideoSource::BootstrapOnUIThread(
+    scoped_refptr<ExternalVideoSource> source) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+
+  mojo::PendingRemote<video_capture::mojom::VideoSourceProvider> provider;
+  content::GetVideoCaptureService().ConnectToVideoSourceProvider(
+      provider.InitWithNewPipeAndPassReceiver());
+
+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+  auto* gpu_data_mgr = content::GpuDataManagerImpl::GetInstance();
+  auto* gpu_factory = content::BrowserGpuChannelHostFactory::instance();
+  if (gpu_data_mgr && gpu_factory &&
+      gpu_data_mgr->HardwareAccelerationEnabled() &&
+      !gpu_data_mgr->IsGpuCompositingDisabled()) {
+    gpu_factory->EstablishGpuChannel(base::BindOnce(
+        &ExternalVideoSource::OnGpuChannelEstablishedOnUIThread,
+        std::move(source), std::move(provider)));
+    return;
+  }
+#endif
+
+  source->task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(&ExternalVideoSource::InitOnSequence, source,
+                     std::move(provider), nullptr, nullptr));
+}
+
+// static
+void ExternalVideoSource::OnGpuChannelEstablishedOnUIThread(
+    scoped_refptr<ExternalVideoSource> source,
+    mojo::PendingRemote<video_capture::mojom::VideoSourceProvider> provider,
+    scoped_refptr<gpu::GpuChannelHost> gpu_channel) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+
+  auto* gpu_data_mgr = content::GpuDataManagerImpl::GetInstance();
+  auto* gpu_factory = content::BrowserGpuChannelHostFactory::instance();
+  gpu::GpuMemoryBufferManager* gmb_manager =
+      gpu_factory ? gpu_factory->GetGpuMemoryBufferManager() : nullptr;
+
+  if (!gpu_channel || gpu_channel->IsLost() || !gpu_data_mgr ||
+      !gpu_data_mgr->HardwareAccelerationEnabled() ||
+      gpu_data_mgr->IsGpuCompositingDisabled()) {
+    gpu_channel = nullptr;
+    gmb_manager = nullptr;
+  }
+
+  source->task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(&ExternalVideoSource::InitOnSequence, source,
+                     std::move(provider), std::move(gpu_channel), gmb_manager));
+}
+
+bool ExternalVideoSource::PushFrame(const uint8_t* y,
+                                    int y_stride,
+                                    const uint8_t* u,
+                                    int u_stride,
+                                    const uint8_t* v,
+                                    int v_stride,
+                                    int width,
+                                    int height,
+                                    int64_t timestamp_us,
+                                    const gfx::ColorSpace& color_space) {
+  const int chroma_width = (width + 1) / 2;
+  if (!y || !u || !v || width <= 0 || height <= 0 ||
+      width > max_size_.width() || height > max_size_.height() ||
+      y_stride < width || u_stride < chroma_width ||
+      v_stride < chroma_width) {
+    return false;
+  }
+
+  const gfx::Size coded_size((width + 1) & ~1, (height + 1) & ~1);
+  scoped_refptr<TextureSlot> tex_slot;
+  scoped_refptr<SharedBufferSlot> shmem_slot;
+  gfx::Size shmem_slot_coded_size;
+  bool need_cold_start_copy = false;
+  bool post_texture_alloc = false;
+  bool post_shmem_reserve = false;
+
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_) {
+      return false;
+    }
+
+    desired_coded_size_ = coded_size;
+    desired_color_space_ = color_space;
+
+    switch (mode_) {
+      case BackendMode::kPendingInit: {
+        if (!cold_start_frame_ ||
+            cold_start_frame_->coded_size() != coded_size) {
+          need_cold_start_copy = true;
+        }
+        break;
+      }
+
+      case BackendMode::kTexture: {
+        if (texture_pool_coded_size_ == coded_size) {
+          if (!free_texture_slots_.empty()) {
+            tex_slot = std::move(free_texture_slots_.front());
+            free_texture_slots_.pop_front();
+            in_flight_texture_slots_[tex_slot->buffer_id] = tex_slot;
+          } else {
+            // All 3 GPU texture slots are currently in flight: drop in O(1) at
+            // entry without touching CPU or PCIe bandwidth.
+            return true;
+          }
+        } else {
+          if (!has_completed_initial_setup_ &&
+              (!cold_start_frame_ ||
+               cold_start_frame_->coded_size() != coded_size)) {
+            need_cold_start_copy = true;
+          }
+          if (device_ready_ && !texture_alloc_in_flight_) {
+            texture_alloc_in_flight_ = true;
+            post_texture_alloc = true;
+          }
+          if (!need_cold_start_copy && !post_texture_alloc) {
+            return true;
+          }
+        }
+        break;
+      }
+
+      case BackendMode::kSharedMemory: {
+        if (reserved_slot_) {
+          shmem_slot = std::move(reserved_slot_);
+          shmem_slot_coded_size = reserved_coded_size_;
+          reserve_in_flight_ = true;
+          consecutive_empty_reserves_ = 0;
+        } else if (!has_completed_initial_setup_) {
+          if (!cold_start_frame_ ||
+              cold_start_frame_->coded_size() != coded_size) {
+            need_cold_start_copy = true;
+          }
+          if (device_ready_ && !reserve_in_flight_) {
+            reserve_in_flight_ = true;
+            post_shmem_reserve = true;
+          }
+        } else {
+          if (device_ready_ && !reserve_in_flight_) {
+            reserve_in_flight_ = true;
+            consecutive_empty_reserves_ = 0;
+            post_shmem_reserve = true;
+          }
+          if (!post_shmem_reserve) {
+            return true;
+          }
+        }
+        break;
+      }
+    }
+  }
+
+  if (tex_slot) {
+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+    const base::TimeTicks ref_time = base::TimeTicks::Now();
+    const gfx::Rect visible_rect(width, height);
+#endif
+#if BUILDFLAG(IS_WIN)
+    const int32_t buf_id = tex_slot->buffer_id;
+    const gfx::Size slot_size = tex_slot->coded_size;
+    scoped_refptr<ExternalVideoSource> self = base::WrapRefCounted(this);
+    auto on_dma_done = base::BindOnce(
+        [](scoped_refptr<ExternalVideoSource> src, int32_t id, gfx::Size sz,
+           gfx::Rect vis_rect, int64_t ts_us, base::TimeTicks rt,
+           gfx::ColorSpace cs, bool ok) {
+          if (ok) {
+            src->task_runner_->PostTask(
+                FROM_HERE,
+                base::BindOnce(
+                    &ExternalVideoSource::SubmitTextureFrameOnSequence, src, id,
+                    sz, vis_rect, ts_us, rt, cs));
+          } else {
+            src->task_runner_->PostTask(
+                FROM_HERE,
+                base::BindOnce(
+                    &ExternalVideoSource::HandleTextureUploadFailureOnSequence,
+                    src, id));
+          }
+        },
+        self, buf_id, slot_size, visible_rect, timestamp_us, ref_time,
+        color_space);
+
+    if (!tex_slot->uploader ||
+        !tex_slot->uploader->SubmitAsyncUploadNV12(
+            tex_slot->d3d12_resource, tex_slot->footprints,
+            tex_slot->upload_total_bytes, slot_size, y, y_stride, u, u_stride,
+            v, v_stride, width, height, std::move(on_dma_done))) {
+      task_runner_->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              &ExternalVideoSource::HandleTextureUploadFailureOnSequence,
+              base::WrapRefCounted(this), buf_id));
+    }
+    return true;
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+    bool ok = false;
+    if (tex_slot->gmb && tex_slot->gmb->Map()) {
+      uint8_t* dst_y = static_cast<uint8_t*>(tex_slot->gmb->memory(0));
+      uint8_t* dst_uv = static_cast<uint8_t*>(tex_slot->gmb->memory(1));
+      if (dst_y && dst_uv) {
+        StreamCopyI420ToNV12Planes(
+            y, y_stride, u, u_stride, v, v_stride, width, height,
+            tex_slot->coded_size, dst_y, tex_slot->gmb->stride(0), dst_uv,
+            tex_slot->gmb->stride(1));
+        ok = true;
+      }
+      tex_slot->gmb->Unmap();
+    }
+    if (!ok) {
+      task_runner_->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              &ExternalVideoSource::HandleTextureUploadFailureOnSequence,
+              base::WrapRefCounted(this), tex_slot->buffer_id));
+      return true;
+    }
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ExternalVideoSource::SubmitTextureFrameOnSequence,
+                       base::WrapRefCounted(this), tex_slot->buffer_id,
+                       tex_slot->coded_size, visible_rect, timestamp_us,
+                       ref_time, color_space));
+    return true;
+#else
+    return false;
+#endif
+  }
+
+  if (shmem_slot) {
+    const size_t needed =
+        media::VideoFrame::AllocationSize(media::PIXEL_FORMAT_I420, coded_size);
+    gfx::Size submit_coded = coded_size;
+    gfx::Rect submit_visible(width, height);
+
+    if (shmem_slot->mapping.IsValid() && shmem_slot->mapping.size() >= needed) {
+      StreamCopyI420ToMapping(
+          y, y_stride, u, u_stride, v, v_stride, width, height, coded_size,
+          static_cast<uint8_t*>(shmem_slot->mapping.memory()));
+    } else if (shmem_slot->mapping.IsValid() &&
+               !shmem_slot_coded_size.IsEmpty()) {
+      const int dw = shmem_slot_coded_size.width();
+      const int dh = shmem_slot_coded_size.height();
+      const int dcw = dw / 2;
+      const int dch = dh / 2;
+      uint8_t* dst_y = static_cast<uint8_t*>(shmem_slot->mapping.memory());
+      uint8_t* dst_u = dst_y + static_cast<size_t>(dw) * dh;
+      uint8_t* dst_v = dst_u + static_cast<size_t>(dcw) * dch;
+      libyuv::I420Scale(y, y_stride, u, u_stride, v, v_stride, width, height,
+                        dst_y, dw, dst_u, dcw, dst_v, dcw, dw, dh,
+                        libyuv::kFilterBilinear);
+      submit_coded = shmem_slot_coded_size;
+      submit_visible = gfx::Rect(dw, dh);
+    }
+
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ExternalVideoSource::SubmitShmemFrameOnSequence,
+                       base::WrapRefCounted(this), shmem_slot->buffer_id,
+                       submit_coded, submit_visible, timestamp_us,
+                       base::TimeTicks::Now(), color_space));
+    return true;
+  }
+
+  if (need_cold_start_copy) {
+    scoped_refptr<media::VideoFrame> frame = media::VideoFrame::CreateFrame(
+        media::PIXEL_FORMAT_I420, coded_size, gfx::Rect(width, height),
+        gfx::Size(width, height), base::Microseconds(timestamp_us));
+    if (frame) {
+      libyuv::I420Copy(y, y_stride, u, u_stride, v, v_stride,
+                       frame->writable_data(media::VideoFrame::kYPlane),
+                       frame->stride(media::VideoFrame::kYPlane),
+                       frame->writable_data(media::VideoFrame::kUPlane),
+                       frame->stride(media::VideoFrame::kUPlane),
+                       frame->writable_data(media::VideoFrame::kVPlane),
+                       frame->stride(media::VideoFrame::kVPlane), width, height);
+      frame->metadata().reference_time = base::TimeTicks::Now();
+      frame->set_color_space(color_space);
+
+      base::AutoLock lock(lock_);
+      if (shut_down_) {
+        return false;
+      }
+      if (!has_completed_initial_setup_) {
+        cold_start_frame_ = std::move(frame);
+      }
+      if (device_ready_) {
+        if (mode_ == BackendMode::kTexture && !texture_alloc_in_flight_ &&
+            texture_pool_coded_size_ != desired_coded_size_) {
+          texture_alloc_in_flight_ = true;
+          post_texture_alloc = true;
+        } else if (mode_ == BackendMode::kSharedMemory && !reserve_in_flight_ &&
+                   !reserved_slot_) {
+          reserve_in_flight_ = true;
+          post_shmem_reserve = true;
+        }
+      }
+    }
+  }
+
+  if (post_texture_alloc) {
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ExternalVideoSource::EnsureTexturePoolOnSequence,
+                       base::WrapRefCounted(this)));
+  }
+  if (post_shmem_reserve) {
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ExternalVideoSource::ReserveBufferOnSequence,
+                       base::WrapRefCounted(this)));
+  }
+  return true;
+}
+
+void ExternalVideoSource::Shutdown() {
+  {
+    base::AutoLock lock(lock_);
+    shut_down_ = true;
+    device_ready_ = false;
+    cold_start_frame_ = nullptr;
+    reserved_slot_ = nullptr;
+    shmem_buffers_.clear();
+    free_texture_slots_.clear();
+  }
+  task_runner_->PostTask(
+      FROM_HERE, base::BindOnce(&ExternalVideoSource::ShutdownOnSequence,
+                                base::WrapRefCounted(this)));
+}
+
+void ExternalVideoSource::InitOnSequence(
+    mojo::PendingRemote<video_capture::mojom::VideoSourceProvider> provider,
+    scoped_refptr<gpu::GpuChannelHost> gpu_channel,
+    gpu::GpuMemoryBufferManager* gmb_manager) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_) {
+      return;
+    }
+  }
+
+  provider_.Bind(std::move(provider));
+  provider_.set_disconnect_handler(base::BindOnce(
+      &ExternalVideoSource::OnProviderError, base::Unretained(this)));
+
+  if (TryInitTextureBackendOnSequence(std::move(gpu_channel), gmb_manager)) {
+    return;
+  }
+
+  InitSharedMemoryBackendOnSequence(
+      "GPU compositing disabled, software renderer, or native NV12 unsupported");
+}
+
+bool ExternalVideoSource::TryInitTextureBackendOnSequence(
+    scoped_refptr<gpu::GpuChannelHost> gpu_channel,
+    gpu::GpuMemoryBufferManager* gmb_manager) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+
+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+  if (!gpu_channel || gpu_channel->IsLost() ||
+      !IsHardwareGpuInfoUsable(gpu_channel->gpu_info())) {
+    return false;
+  }
+
+  std::unique_ptr<gpu::ClientSharedImageInterface> sii =
+      gpu_channel->CreateClientSharedImageInterface();
+  if (!sii) {
+    return false;
+  }
+
+#if BUILDFLAG(IS_WIN)
+  auto uploader = SharedD3D12CopyUploader::GetOrCreate(
+      gpu_channel->gpu_info().active_gpu().luid);
+  if (!uploader) {
+    return false;
+  }
+  d3d12_uploader_ = std::move(uploader);
+  const char* backend_detail =
+      "Windows D3D12 CopyQueue DMA + keyless DXGI NV12 SharedImage";
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+  const int probe_mode =
+      ProbeLinuxNativePixmapNV12(gpu_channel->channel_id(), gmb_manager);
+  if (probe_mode < 0) {
+    return false;
+  }
+  linux_use_scanout_gmb_ = (probe_mode == 1);
+  const char* backend_detail = linux_use_scanout_gmb_
+                                   ? "Linux NativePixmap DMA-BUF NV12 (scanout)"
+                                   : "Linux NativePixmap DMA-BUF NV12 (linear)";
+#endif
+
+  gpu_channel_ = std::move(gpu_channel);
+  sii_ = std::move(sii);
+  gmb_manager_ = gmb_manager;
+
+  media::VideoCaptureDeviceInfo tex_device_info = device_info_;
+  for (auto& fmt : tex_device_info.supported_formats) {
+    fmt.pixel_format = media::PIXEL_FORMAT_NV12;
+  }
+
+  provider_->AddTextureVirtualDevice(
+      tex_device_info, texture_device_.BindNewPipeAndPassReceiver());
+  texture_device_.set_disconnect_handler(base::BindOnce(
+      &ExternalVideoSource::OnTextureDeviceError, base::Unretained(this)));
+  texture_device_->OnFrameAccessHandlerReady(
+      access_handler_receiver_.BindNewPipeAndPassRemote());
+
+  LogTextureBackendActivatedOnce(backend_detail);
+
+  bool should_allocate_pool = false;
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_) {
+      return true;
+    }
+    mode_ = BackendMode::kTexture;
+    device_ready_ = true;
+    if (!desired_coded_size_.IsEmpty() && !texture_alloc_in_flight_) {
+      texture_alloc_in_flight_ = true;
+      should_allocate_pool = true;
+    }
+  }
+
+  if (should_allocate_pool) {
+    EnsureTexturePoolOnSequence();
+  }
+  return true;
+#else
+  (void)gpu_channel;
+  (void)gmb_manager;
+  return false;
+#endif
+}
+
+void ExternalVideoSource::InitSharedMemoryBackendOnSequence(
+    const char* fallback_reason) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  if (!provider_.is_bound()) {
+    return;
+  }
+
+  LogSharedMemoryFallbackOnce(fallback_reason);
+
+  producer_receiver_.reset();
+  shmem_device_.reset();
+  provider_->AddSharedMemoryVirtualDevice(
+      device_info_, producer_receiver_.BindNewPipeAndPassRemote(),
+      shmem_device_.BindNewPipeAndPassReceiver());
+  shmem_device_.set_disconnect_handler(base::BindOnce(
+      &ExternalVideoSource::OnShmemDeviceError, base::Unretained(this)));
+
+  bool should_reserve = false;
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_) {
+      return;
+    }
+    mode_ = BackendMode::kSharedMemory;
+    device_ready_ = true;
+    texture_alloc_in_flight_ = false;
+    texture_pool_coded_size_ = gfx::Size();
+    free_texture_slots_.clear();
+    in_flight_texture_slots_.clear();
+    if (!desired_coded_size_.IsEmpty() && !reserve_in_flight_) {
+      reserve_in_flight_ = true;
+      consecutive_empty_reserves_ = 0;
+      should_reserve = true;
+    }
+  }
+
+  if (should_reserve) {
+    ReserveBufferOnSequence();
+  }
+}
+
+void ExternalVideoSource::FallbackToSharedMemoryOnSequence(const char* reason) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_ || mode_ == BackendMode::kSharedMemory) {
+      return;
+    }
+  }
+  ReleaseAllTextureResourcesOnSequence(/*retire_on_device=*/false);
+  access_handler_receiver_.reset();
+  texture_device_.reset();
+  sii_.reset();
+  gpu_channel_.reset();
+  gmb_manager_ = nullptr;
+#if BUILDFLAG(IS_WIN)
+  d3d12_uploader_.reset();
+#endif
+
+  InitSharedMemoryBackendOnSequence(reason);
+}
+
+void ExternalVideoSource::EnsureTexturePoolOnSequence() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+
+  gfx::Size target_size;
+  gfx::ColorSpace target_cs;
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_ || mode_ != BackendMode::kTexture ||
+        !texture_device_.is_bound() || desired_coded_size_.IsEmpty() ||
+        texture_pool_coded_size_ == desired_coded_size_) {
+      texture_alloc_in_flight_ = false;
+      return;
+    }
+    target_size = desired_coded_size_;
+    target_cs = desired_color_space_;
+  }
+
+  if (!gpu_channel_ || gpu_channel_->IsLost() || !sii_) {
+    FallbackToSharedMemoryOnSequence("GPU channel lost before pool allocation");
+    return;
+  }
+
+  if (!target_cs.IsValid()) {
+    target_cs = ToGfxColorSpace(nullptr, target_size.height());
+  }
+
+  std::deque<scoped_refptr<TextureSlot>> old_idle_slots;
+  {
+    base::AutoLock lock(lock_);
+    old_idle_slots.swap(free_texture_slots_);
+    texture_pool_coded_size_ = gfx::Size();
+  }
+  for (const auto& old_slot : old_idle_slots) {
+    if (registered_texture_buffer_ids_.erase(old_slot->buffer_id) > 0 &&
+        texture_device_.is_bound()) {
+      texture_device_->OnBufferRetired(old_slot->buffer_id);
+    }
+    DestroySlotSharedImagesOnSequence(*old_slot);
+  }
+  old_idle_slots.clear();
+
+  std::vector<scoped_refptr<TextureSlot>> new_slots;
+  new_slots.reserve(kTexturePoolSlots);
+  for (size_t i = 0; i < kTexturePoolSlots; ++i) {
+    const int32_t buffer_id = next_texture_buffer_id_++;
+    scoped_refptr<TextureSlot> slot =
+        CreateTextureSlotOnSequence(buffer_id, target_size, target_cs);
+    if (!slot) {
+      for (const auto& partial : new_slots) {
+        DestroySlotSharedImagesOnSequence(*partial);
+      }
+      FallbackToSharedMemoryOnSequence(
+          "failed to allocate GPU NV12 texture slot");
+      return;
+    }
+    new_slots.push_back(std::move(slot));
+  }
+
+  const gpu::SyncToken sync_token = sii_->GenVerifiedSyncToken();
+  if (!sync_token.HasData() || gpu_channel_->IsLost()) {
+    for (const auto& partial : new_slots) {
+      DestroySlotSharedImagesOnSequence(*partial);
+    }
+    FallbackToSharedMemoryOnSequence(
+        "failed to verify SharedImage SyncToken on GPU channel");
+    return;
+  }
+
+  for (const auto& slot : new_slots) {
+    auto handle_set = media::mojom::MailboxBufferHandleSet::New();
+    handle_set->mailbox_holder.resize(media::VideoFrame::kMaxPlanes);
+    handle_set->mailbox_holder[0] =
+        gpu::MailboxHolder(slot->mailbox_y, sync_token, slot->texture_target);
+    handle_set->mailbox_holder[1] =
+        gpu::MailboxHolder(slot->mailbox_uv, sync_token, slot->texture_target);
+    texture_device_->OnNewMailboxHolderBufferHandle(slot->buffer_id,
+                                                    std::move(handle_set));
+    registered_texture_buffer_ids_.insert(slot->buffer_id);
+  }
+
+  scoped_refptr<media::VideoFrame> cold_frame;
+  scoped_refptr<TextureSlot> cold_slot;
+  bool size_changed_again = false;
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_ || mode_ != BackendMode::kTexture) {
+      texture_alloc_in_flight_ = false;
+      return;
+    }
+
+    texture_pool_coded_size_ = target_size;
+    has_completed_initial_setup_ = true;
+
+    if (cold_start_frame_ && cold_start_frame_->coded_size() == target_size) {
+      cold_frame = std::move(cold_start_frame_);
+      cold_slot = new_slots[0];
+      in_flight_texture_slots_[cold_slot->buffer_id] = cold_slot;
+      for (size_t i = 1; i < new_slots.size(); ++i) {
+        free_texture_slots_.push_back(std::move(new_slots[i]));
+      }
+    } else {
+      cold_start_frame_ = nullptr;
+      for (auto& slot : new_slots) {
+        free_texture_slots_.push_back(std::move(slot));
+      }
+    }
+
+    if (!desired_coded_size_.IsEmpty() && desired_coded_size_ != target_size) {
+      size_changed_again = true;
+    } else {
+      texture_alloc_in_flight_ = false;
+    }
+  }
+
+  if (cold_frame && cold_slot) {
+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+    const base::TimeTicks rt =
+        cold_frame->metadata().reference_time.value_or(base::TimeTicks::Now());
+    const int64_t ts_us = cold_frame->timestamp().InMicroseconds();
+    const gfx::ColorSpace cs = cold_frame->ColorSpace();
+    const gfx::Rect vis_rect = cold_frame->visible_rect();
+#endif
+#if BUILDFLAG(IS_WIN)
+    const int32_t buf_id = cold_slot->buffer_id;
+    const gfx::Size slot_size = cold_slot->coded_size;
+    scoped_refptr<ExternalVideoSource> self = base::WrapRefCounted(this);
+    auto on_dma_done = base::BindOnce(
+        [](scoped_refptr<ExternalVideoSource> src, int32_t id, gfx::Size sz,
+           gfx::Rect vr, int64_t ts, base::TimeTicks ref_t,
+           gfx::ColorSpace color_s, bool ok) {
+          if (ok) {
+            src->task_runner_->PostTask(
+                FROM_HERE,
+                base::BindOnce(
+                    &ExternalVideoSource::SubmitTextureFrameOnSequence, src, id,
+                    sz, vr, ts, ref_t, color_s));
+          } else {
+            src->task_runner_->PostTask(
+                FROM_HERE,
+                base::BindOnce(
+                    &ExternalVideoSource::HandleTextureUploadFailureOnSequence,
+                    src, id));
+          }
+        },
+        self, buf_id, slot_size, vis_rect, ts_us, rt, cs);
+
+    if (!cold_slot->uploader ||
+        !cold_slot->uploader->SubmitAsyncUploadNV12(
+            cold_slot->d3d12_resource, cold_slot->footprints,
+            cold_slot->upload_total_bytes, slot_size,
+            cold_frame->data(media::VideoFrame::kYPlane),
+            cold_frame->stride(media::VideoFrame::kYPlane),
+            cold_frame->data(media::VideoFrame::kUPlane),
+            cold_frame->stride(media::VideoFrame::kUPlane),
+            cold_frame->data(media::VideoFrame::kVPlane),
+            cold_frame->stride(media::VideoFrame::kVPlane), vis_rect.width(),
+            vis_rect.height(), std::move(on_dma_done))) {
+      HandleTextureUploadFailureOnSequence(buf_id);
+      return;
+    }
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+    bool ok = false;
+    if (cold_slot->gmb && cold_slot->gmb->Map()) {
+      uint8_t* dst_y = static_cast<uint8_t*>(cold_slot->gmb->memory(0));
+      uint8_t* dst_uv = static_cast<uint8_t*>(cold_slot->gmb->memory(1));
+      if (dst_y && dst_uv) {
+        StreamCopyI420ToNV12Planes(
+            cold_frame->data(media::VideoFrame::kYPlane),
+            cold_frame->stride(media::VideoFrame::kYPlane),
+            cold_frame->data(media::VideoFrame::kUPlane),
+            cold_frame->stride(media::VideoFrame::kUPlane),
+            cold_frame->data(media::VideoFrame::kVPlane),
+            cold_frame->stride(media::VideoFrame::kVPlane), vis_rect.width(),
+            vis_rect.height(), cold_slot->coded_size, dst_y,
+            cold_slot->gmb->stride(0), dst_uv, cold_slot->gmb->stride(1));
+        ok = true;
+      }
+      cold_slot->gmb->Unmap();
+    }
+    if (ok) {
+      SubmitTextureFrameOnSequence(cold_slot->buffer_id, cold_slot->coded_size,
+                                   vis_rect, ts_us, rt, cs);
+    } else {
+      HandleTextureUploadFailureOnSequence(cold_slot->buffer_id);
+      return;
+    }
+#endif
+  }
+
+  if (size_changed_again) {
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ExternalVideoSource::EnsureTexturePoolOnSequence,
+                       base::WrapRefCounted(this)));
+  }
+}
+
+scoped_refptr<ExternalVideoSource::TextureSlot>
+ExternalVideoSource::CreateTextureSlotOnSequence(
+    int32_t buffer_id,
+    const gfx::Size& coded_size,
+    const gfx::ColorSpace& color_space) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  if (!sii_ || !gpu_channel_ || gpu_channel_->IsLost()) {
+    return nullptr;
+  }
+
+#if BUILDFLAG(IS_WIN)
+  if (!d3d12_uploader_ || !d3d12_uploader_->IsDeviceHealthy()) {
+    return nullptr;
+  }
+
+  Microsoft::WRL::ComPtr<ID3D11Texture2D> d3d11_texture;
+  Microsoft::WRL::ComPtr<ID3D12Resource> d3d12_resource;
+  D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprints[2] = {};
+  UINT64 total_bytes = 0;
+  base::win::ScopedHandle shared_handle;
+  if (!d3d12_uploader_->CreateSharedNV12Texture(
+          coded_size, &d3d11_texture, &d3d12_resource, footprints, &total_bytes,
+          &shared_handle)) {
+    return nullptr;
+  }
+
+  static std::atomic<int32_t> g_next_dxgi_gmb_id{1};
+  gfx::GpuMemoryBufferHandle gmb_handle;
+  gmb_handle.type = gfx::DXGI_SHARED_HANDLE;
+  gmb_handle.id = gfx::GpuMemoryBufferId(
+      g_next_dxgi_gmb_id.fetch_add(1, std::memory_order_relaxed));
+  gmb_handle.dxgi_handle = std::move(shared_handle);
+  gmb_handle.dxgi_token = gfx::DXGIHandleToken();
+
+  auto gmb_dxgi = gpu::GpuMemoryBufferImplDXGI::CreateFromHandle(
+      std::move(gmb_handle), coded_size, gfx::BufferFormat::YUV_420_BIPLANAR,
+      gfx::BufferUsage::GPU_READ, base::DoNothing(), nullptr, nullptr);
+  if (!gmb_dxgi) {
+    return nullptr;
+  }
+
+  constexpr uint32_t kUsage =
+      gpu::SHARED_IMAGE_USAGE_GLES2 | gpu::SHARED_IMAGE_USAGE_RASTER |
+      gpu::SHARED_IMAGE_USAGE_DISPLAY_READ | gpu::SHARED_IMAGE_USAGE_SCANOUT;
+
+  auto slot = base::MakeRefCounted<TextureSlot>(
+      buffer_id, coded_size, static_cast<uint32_t>(GL_TEXTURE_2D),
+      /*overlay_capable=*/true);
+  slot->mailbox_y = sii_->CreateSharedImage(
+      gmb_dxgi.get(), nullptr, gfx::BufferPlane::Y, color_space,
+      kTopLeft_GrSurfaceOrigin, kPremul_SkAlphaType, kUsage);
+  slot->mailbox_uv = sii_->CreateSharedImage(
+      gmb_dxgi.get(), nullptr, gfx::BufferPlane::UV, color_space,
+      kTopLeft_GrSurfaceOrigin, kPremul_SkAlphaType, kUsage);
+  if (slot->mailbox_y.IsZero() || slot->mailbox_uv.IsZero()) {
+    DestroySlotSharedImagesOnSequence(*slot);
+    return nullptr;
+  }
+
+  slot->uploader = d3d12_uploader_;
+  slot->d3d11_texture = std::move(d3d11_texture);
+  slot->d3d12_resource = std::move(d3d12_resource);
+  slot->footprints[0] = footprints[0];
+  slot->footprints[1] = footprints[1];
+  slot->upload_total_bytes = total_bytes;
+  slot->gmb_dxgi = std::move(gmb_dxgi);
+  return slot;
+
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+  if (!gmb_manager_) {
+    return nullptr;
+  }
+
+  const gfx::BufferUsage gmb_usage =
+      linux_use_scanout_gmb_ ? gfx::BufferUsage::SCANOUT_CPU_READ_WRITE
+                             : gfx::BufferUsage::GPU_READ_CPU_READ_WRITE;
+  auto gmb = gmb_manager_->CreateGpuMemoryBuffer(
+      coded_size, gfx::BufferFormat::YUV_420_BIPLANAR, gmb_usage,
+      gpu::kNullSurfaceHandle, nullptr);
+  if (!gmb || gmb->GetType() != gfx::NATIVE_PIXMAP) {
+    return nullptr;
+  }
+
+  uint32_t si_usage = gpu::SHARED_IMAGE_USAGE_GLES2 |
+                      gpu::SHARED_IMAGE_USAGE_RASTER |
+                      gpu::SHARED_IMAGE_USAGE_DISPLAY_READ;
+  if (linux_use_scanout_gmb_) {
+    si_usage |= gpu::SHARED_IMAGE_USAGE_SCANOUT;
+  }
+
+  const uint32_t target =
+      gpu::NativeBufferNeedsPlatformSpecificTextureTarget(
+          gfx::BufferFormat::R_8, gfx::BufferPlane::Y)
+          ? gpu::GetPlatformSpecificTextureTarget()
+          : static_cast<uint32_t>(GL_TEXTURE_2D);
+
+  auto slot = base::MakeRefCounted<TextureSlot>(buffer_id, coded_size, target,
+                                                linux_use_scanout_gmb_);
+  slot->mailbox_y = sii_->CreateSharedImage(
+      gmb.get(), gmb_manager_, gfx::BufferPlane::Y, color_space,
+      kTopLeft_GrSurfaceOrigin, kPremul_SkAlphaType, si_usage);
+  slot->mailbox_uv = sii_->CreateSharedImage(
+      gmb.get(), gmb_manager_, gfx::BufferPlane::UV, color_space,
+      kTopLeft_GrSurfaceOrigin, kPremul_SkAlphaType, si_usage);
+  if (slot->mailbox_y.IsZero() || slot->mailbox_uv.IsZero()) {
+    DestroySlotSharedImagesOnSequence(*slot);
+    return nullptr;
+  }
+
+  slot->gmb = std::move(gmb);
+  return slot;
+
+#else
+  (void)buffer_id;
+  (void)coded_size;
+  (void)color_space;
+  return nullptr;
+#endif
+}
+
+void ExternalVideoSource::DestroySlotSharedImagesOnSequence(
+    const TextureSlot& slot) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  if (!sii_) {
+    return;
+  }
+  if (!slot.mailbox_y.IsZero()) {
+    sii_->DestroySharedImage(gpu::SyncToken(), slot.mailbox_y);
+  }
+  if (!slot.mailbox_uv.IsZero()) {
+    sii_->DestroySharedImage(gpu::SyncToken(), slot.mailbox_uv);
+  }
+  sii_->Flush();
+}
+
+void ExternalVideoSource::ReleaseAllTextureResourcesOnSequence(
+    bool retire_on_device) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  std::deque<scoped_refptr<TextureSlot>> free_slots;
+  std::map<int32_t, scoped_refptr<TextureSlot>> in_flight_slots;
+  {
+    base::AutoLock lock(lock_);
+    free_slots.swap(free_texture_slots_);
+    in_flight_slots.swap(in_flight_texture_slots_);
+    texture_pool_coded_size_ = gfx::Size();
+    texture_alloc_in_flight_ = false;
+  }
+
+  for (const auto& slot : free_slots) {
+    if (retire_on_device && texture_device_.is_bound() &&
+        registered_texture_buffer_ids_.erase(slot->buffer_id) > 0) {
+      texture_device_->OnBufferRetired(slot->buffer_id);
+    }
+    DestroySlotSharedImagesOnSequence(*slot);
+  }
+  for (const auto& [id, slot] : in_flight_slots) {
+    DestroySlotSharedImagesOnSequence(*slot);
+  }
+  registered_texture_buffer_ids_.clear();
+}
+
+void ExternalVideoSource::SubmitTextureFrameOnSequence(
+    int32_t buffer_id,
+    gfx::Size coded_size,
+    gfx::Rect visible_rect,
+    int64_t timestamp_us,
+    base::TimeTicks reference_time,
+    gfx::ColorSpace color_space) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+
+  scoped_refptr<TextureSlot> slot;
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_ || mode_ != BackendMode::kTexture ||
+        !texture_device_.is_bound()) {
+      in_flight_texture_slots_.erase(buffer_id);
+      return;
+    }
+    auto it = in_flight_texture_slots_.find(buffer_id);
+    if (it == in_flight_texture_slots_.end()) {
+      return;
+    }
+    slot = it->second;
+  }
+
+  if (!gpu_channel_ || gpu_channel_->IsLost()) {
+    FallbackToSharedMemoryOnSequence("GPU channel lost during frame submit");
+    return;
+  }
+
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+  if (sii_ && slot) {
+    sii_->UpdateSharedImage(gpu::SyncToken(), slot->mailbox_y);
+    sii_->UpdateSharedImage(gpu::SyncToken(), slot->mailbox_uv);
+    sii_->Flush();
+  }
+#endif
+
+  media::mojom::VideoFrameInfoPtr info = media::mojom::VideoFrameInfo::New();
+  info->timestamp = base::Microseconds(timestamp_us);
+  info->metadata.frame_rate = max_fps_;
+  info->metadata.reference_time = reference_time;
+  info->metadata.allow_overlay = slot->allow_overlay;
+  info->metadata.read_lock_fences_enabled = true;
+  info->pixel_format = media::PIXEL_FORMAT_NV12;
+  info->coded_size = coded_size;
+  info->visible_rect = visible_rect;
+  info->is_premapped = false;
+  info->color_space = color_space;
+  texture_device_->OnFrameReadyInBuffer(buffer_id, std::move(info));
+}
+
+void ExternalVideoSource::HandleTextureUploadFailureOnSequence(
+    int32_t buffer_id) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  {
+    base::AutoLock lock(lock_);
+    in_flight_texture_slots_.erase(buffer_id);
+  }
+  FallbackToSharedMemoryOnSequence("GPU NV12 DMA upload failed");
+}
+
+void ExternalVideoSource::OnFinishedConsumingBuffer(int32_t buffer_id) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+
+  scoped_refptr<TextureSlot> stale_slot;
+  {
+    base::AutoLock lock(lock_);
+    auto it = in_flight_texture_slots_.find(buffer_id);
+    if (it == in_flight_texture_slots_.end()) {
+      return;
+    }
+    scoped_refptr<TextureSlot> slot = std::move(it->second);
+    in_flight_texture_slots_.erase(it);
+
+    if (!shut_down_ && mode_ == BackendMode::kTexture &&
+        slot->coded_size == texture_pool_coded_size_) {
+      free_texture_slots_.push_back(std::move(slot));
+      return;
+    }
+    stale_slot = std::move(slot);
+  }
+
+  if (stale_slot) {
+    if (registered_texture_buffer_ids_.erase(stale_slot->buffer_id) > 0 &&
+        texture_device_.is_bound()) {
+      texture_device_->OnBufferRetired(stale_slot->buffer_id);
+    }
+    DestroySlotSharedImagesOnSequence(*stale_slot);
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Pre-reserved SharedMemory fallback backend
+// ---------------------------------------------------------------------------
+
+void ExternalVideoSource::ReserveBufferOnSequence() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  gfx::Size coded_size;
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_ || mode_ != BackendMode::kSharedMemory ||
+        !shmem_device_.is_bound() || desired_coded_size_.IsEmpty() ||
+        reserved_slot_) {
+      reserve_in_flight_ = false;
+      return;
+    }
+    coded_size = desired_coded_size_;
+  }
+
+  shmem_device_->RequestFrameBuffer(
+      coded_size, media::PIXEL_FORMAT_I420, /*strides=*/nullptr,
+      base::BindOnce(&ExternalVideoSource::OnBufferReserved,
+                     base::WrapRefCounted(this), coded_size));
+}
+
+void ExternalVideoSource::OnBufferReserved(gfx::Size requested_coded_size,
+                                           int32_t buffer_id) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+
+  if (buffer_id == video_capture::mojom::kInvalidBufferId) {
+    bool schedule_retry = false;
+    {
+      base::AutoLock lock(lock_);
+      has_completed_initial_setup_ = true;
+      cold_start_frame_ = nullptr;
+      if (!shut_down_ && mode_ == BackendMode::kSharedMemory &&
+          shmem_device_.is_bound() &&
+          consecutive_empty_reserves_ < kMaxEmptyReserveRetries) {
+        ++consecutive_empty_reserves_;
+        schedule_retry = true;
+      } else {
+        reserve_in_flight_ = false;
+      }
+    }
+    if (schedule_retry) {
+      task_runner_->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&ExternalVideoSource::ReserveBufferOnSequence,
+                         base::WrapRefCounted(this)),
+          kEmptyReserveRetryDelay);
+    }
+    return;
+  }
+
+  scoped_refptr<SharedBufferSlot> slot;
+  scoped_refptr<media::VideoFrame> cold_frame;
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_ || mode_ != BackendMode::kSharedMemory ||
+        !shmem_device_.is_bound()) {
+      reserve_in_flight_ = false;
+      return;
+    }
+
+    has_completed_initial_setup_ = true;
+    consecutive_empty_reserves_ = 0;
+
+    auto it = shmem_buffers_.find(buffer_id);
+    if (it == shmem_buffers_.end() || !it->second ||
+        !it->second->mapping.IsValid()) {
+      LOG(ERROR) << "cef_external_video: unknown or unmapped buffer "
+                 << buffer_id;
+      reserve_in_flight_ = false;
+      return;
+    }
+    slot = it->second;
+
+    if (cold_start_frame_) {
+      cold_frame = std::move(cold_start_frame_);
+    } else {
+      reserved_slot_ = std::move(slot);
+      reserved_coded_size_ = requested_coded_size;
+      reserve_in_flight_ = false;
+      return;
+    }
+  }
+
+  const size_t needed = media::VideoFrame::AllocationSize(
+      media::PIXEL_FORMAT_I420, cold_frame->coded_size());
+  if (slot->mapping.size() >= needed &&
+      cold_frame->coded_size() == requested_coded_size) {
+    StreamCopyI420ToMapping(
+        cold_frame->data(media::VideoFrame::kYPlane),
+        cold_frame->stride(media::VideoFrame::kYPlane),
+        cold_frame->data(media::VideoFrame::kUPlane),
+        cold_frame->stride(media::VideoFrame::kUPlane),
+        cold_frame->data(media::VideoFrame::kVPlane),
+        cold_frame->stride(media::VideoFrame::kVPlane),
+        cold_frame->visible_rect().width(),
+        cold_frame->visible_rect().height(), cold_frame->coded_size(),
+        static_cast<uint8_t*>(slot->mapping.memory()));
+    SubmitShmemFrameOnSequence(
+        slot->buffer_id, cold_frame->coded_size(), cold_frame->visible_rect(),
+        cold_frame->timestamp().InMicroseconds(),
+        cold_frame->metadata().reference_time.value_or(base::TimeTicks::Now()),
+        cold_frame->ColorSpace());
+  } else {
+    const int dw = requested_coded_size.width();
+    const int dh = requested_coded_size.height();
+    const int dcw = dw / 2;
+    const int dch = dh / 2;
+    uint8_t* dst_y = static_cast<uint8_t*>(slot->mapping.memory());
+    uint8_t* dst_u = dst_y + static_cast<size_t>(dw) * dh;
+    uint8_t* dst_v = dst_u + static_cast<size_t>(dcw) * dch;
+    libyuv::I420Scale(cold_frame->data(media::VideoFrame::kYPlane),
+                      cold_frame->stride(media::VideoFrame::kYPlane),
+                      cold_frame->data(media::VideoFrame::kUPlane),
+                      cold_frame->stride(media::VideoFrame::kUPlane),
+                      cold_frame->data(media::VideoFrame::kVPlane),
+                      cold_frame->stride(media::VideoFrame::kVPlane),
+                      cold_frame->visible_rect().width(),
+                      cold_frame->visible_rect().height(), dst_y, dw, dst_u,
+                      dcw, dst_v, dcw, dw, dh, libyuv::kFilterBilinear);
+    SubmitShmemFrameOnSequence(
+        slot->buffer_id, requested_coded_size, gfx::Rect(dw, dh),
+        cold_frame->timestamp().InMicroseconds(),
+        cold_frame->metadata().reference_time.value_or(base::TimeTicks::Now()),
+        cold_frame->ColorSpace());
+  }
+}
+
+void ExternalVideoSource::SubmitShmemFrameOnSequence(
+    int32_t buffer_id,
+    gfx::Size coded_size,
+    gfx::Rect visible_rect,
+    int64_t timestamp_us,
+    base::TimeTicks reference_time,
+    gfx::ColorSpace color_space) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  if (!shmem_device_.is_bound()) {
+    base::AutoLock lock(lock_);
+    reserve_in_flight_ = false;
+    return;
+  }
+
+  media::mojom::VideoFrameInfoPtr info = media::mojom::VideoFrameInfo::New();
+  info->timestamp = base::Microseconds(timestamp_us);
+  info->metadata.frame_rate = max_fps_;
+  info->metadata.reference_time = reference_time;
+  info->pixel_format = media::PIXEL_FORMAT_I420;
+  info->coded_size = coded_size;
+  info->visible_rect = visible_rect;
+  info->is_premapped = false;
+  info->color_space = color_space;
+  shmem_device_->OnFrameReadyInBuffer(buffer_id, std::move(info));
+
+  ReserveBufferOnSequence();
+}
+
+void ExternalVideoSource::OnNewBuffer(
+    int32_t buffer_id,
+    media::mojom::VideoBufferHandlePtr buffer_handle,
+    OnNewBufferCallback callback) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  if (buffer_handle->is_unsafe_shmem_region()) {
+    base::WritableSharedMemoryMapping mapping =
+        buffer_handle->get_unsafe_shmem_region().Map();
+    if (mapping.IsValid()) {
+      base::AutoLock lock(lock_);
+      if (!shut_down_) {
+        shmem_buffers_[buffer_id] = base::MakeRefCounted<SharedBufferSlot>(
+            buffer_id, std::move(mapping));
+      }
+    } else {
+      LOG(ERROR) << "cef_external_video: failed to map buffer " << buffer_id;
+    }
+  } else {
+    LOG(ERROR) << "cef_external_video: unexpected buffer handle type";
+  }
+  std::move(callback).Run();
+}
+
+void ExternalVideoSource::OnBufferRetired(int32_t buffer_id) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  base::AutoLock lock(lock_);
+  shmem_buffers_.erase(buffer_id);
+}
+
+// ---------------------------------------------------------------------------
+// Teardown & Mojo error handlers
+// ---------------------------------------------------------------------------
+
+void ExternalVideoSource::ShutdownOnSequence() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  ReleaseAllTextureResourcesOnSequence(/*retire_on_device=*/false);
+  access_handler_receiver_.reset();
+  texture_device_.reset();
+  sii_.reset();
+  gpu_channel_.reset();
+  gmb_manager_ = nullptr;
+#if BUILDFLAG(IS_WIN)
+  d3d12_uploader_.reset();
+#endif
+
+  shmem_device_.reset();
+  producer_receiver_.reset();
+  provider_.reset();
+
+  {
+    base::AutoLock lock(lock_);
+    shut_down_ = true;
+    device_ready_ = false;
+    reserve_in_flight_ = false;
+    reserved_slot_ = nullptr;
+    cold_start_frame_ = nullptr;
+    shmem_buffers_.clear();
+  }
+}
+
+void ExternalVideoSource::OnProviderError() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  LOG(WARNING) << "cef_external_video: lost connection to the video capture "
+                  "service for device "
+               << device_info_.descriptor.device_id;
+  ShutdownOnSequence();
+}
+
+void ExternalVideoSource::OnTextureDeviceError() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  if (provider_.is_bound()) {
+    FallbackToSharedMemoryOnSequence("TextureVirtualDevice pipe disconnected");
+    return;
+  }
+  OnProviderError();
+}
+
+void ExternalVideoSource::OnShmemDeviceError() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  OnProviderError();
+}
+
+}  // namespace cef_external_video
+
+// C API (include/cef_external_video.h).
+
+struct _cef_external_video_t {
+  scoped_refptr<cef_external_video::ExternalVideoSource> source;
+};
+
+CEF_EXPORT cef_external_video_t* cef_external_video_create(
+    const char* device_id,
+    const char* label,
+    int max_width,
+    int max_height,
+    float max_fps) {
+  if (!device_id || max_width < 0 || max_height < 0 || !(max_fps >= 0.f))
+    return nullptr;
+  if (max_width == 0)
+    max_width = CEF_EXTERNAL_VIDEO_DEFAULT_MAX_WIDTH;
+  if (max_height == 0)
+    max_height = CEF_EXTERNAL_VIDEO_DEFAULT_MAX_HEIGHT;
+  if (max_fps == 0.f)
+    max_fps = CEF_EXTERNAL_VIDEO_DEFAULT_MAX_FPS;
+  auto source = cef_external_video::ExternalVideoSource::Create(
+      device_id, label ? label : "", gfx::Size(max_width, max_height),
+      max_fps);
+  if (!source)
+    return nullptr;
+  return new _cef_external_video_t{std::move(source)};
+}
+
+CEF_EXPORT int cef_external_video_push_frame(
+    cef_external_video_t* handle,
+    const uint8_t* y_data,
+    int y_stride,
+    const uint8_t* u_data,
+    int u_stride,
+    const uint8_t* v_data,
+    int v_stride,
+    int width,
+    int height,
+    int64_t timestamp_us,
+    const cef_external_video_color_t* color) {
+  if (!handle || !handle->source)
+    return 0;
+  return handle->source->PushFrame(
+             y_data, y_stride, u_data, u_stride, v_data, v_stride, width,
+             height, timestamp_us,
+             cef_external_video::ToGfxColorSpace(color, height))
+             ? 1
+             : 0;
+}
+
+CEF_EXPORT void cef_external_video_destroy(cef_external_video_t* handle) {
+  if (!handle)
+    return;
+  if (handle->source)
+    handle->source->Shutdown();
+  delete handle;
+}
