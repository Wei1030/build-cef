+ public:
+  enum class UploadStatus {
+    kSubmitted,
+    kTransientDrop,
+    kFatalError,
+  };
+
+  using CompletionCallback = base::OnceCallback<void(bool success)>;
+
+  static scoped_refptr<SharedD3D12CopyUploader> GetOrCreate(
+      const CHROME_LUID& target_luid) {
+    struct SingletonHolder {
+      base::Lock lock;
+      scoped_refptr<SharedD3D12CopyUploader> instance GUARDED_BY(lock);
+    };
+    static base::NoDestructor<SingletonHolder> g_holder;
+
+    base::AutoLock lock(g_holder->lock);
+    if (g_holder->instance &&
+        g_holder->instance->MatchesAndHealthy(target_luid)) {
+      return g_holder->instance;
+    }
+    g_holder->instance = CreateInternal(target_luid);
+    return g_holder->instance;
