+
+inline void StreamCopyBytes(const uint8_t* src, uint8_t* dst, size_t count) {
+  if (CpuHasAvx2()) {
+    StreamCopyBytes_AVX2(src, dst, count);
+  } else {
+    StreamCopyBytes_SSE2(src, dst, count);
+  }
+}
+
+[[maybe_unused]] inline void StreamInterleaveUVPairs(const uint8_t* u,
+                                                     const uint8_t* v,
+                                                     uint8_t* dst_uv,
+                                                     size_t uv_pairs) {
+  if (CpuHasAvx2()) {
+    StreamInterleaveUVPairs_AVX2(u, v, dst_uv, uv_pairs);
+  } else {
+    StreamInterleaveUVPairs_SSE2(u, v, dst_uv, uv_pairs);
+  }
+}
