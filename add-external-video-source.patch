+namespace cef_external_video {
+
+namespace {
+
+void ConnectToVideoSourceProviderOnUIThread(
+    mojo::PendingReceiver<video_capture::mojom::VideoSourceProvider>
+        receiver) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  content::GetVideoCaptureService().ConnectToVideoSourceProvider(
+      std::move(receiver));
+}
+
+}  // namespace
+
+// Converts the H.273-based description from the C API into a gfx::ColorSpace.
+// See include/cef_external_video.h for the rules.
+gfx::ColorSpace ToGfxColorSpace(const cef_external_video_color_t* color,
+                                int height) {
+  using VCS = media::VideoColorSpace;
+  VCS::PrimaryID primaries = VCS::PrimaryID::UNSPECIFIED;
+  VCS::TransferID transfer = VCS::TransferID::UNSPECIFIED;
+  VCS::MatrixID matrix = VCS::MatrixID::UNSPECIFIED;
+  gfx::ColorSpace::RangeID range = gfx::ColorSpace::RangeID::LIMITED;
+
+  if (color) {
+    primaries = VCS::GetPrimaryID(color->primaries);
+    if (primaries == VCS::PrimaryID::INVALID)
+      primaries = VCS::PrimaryID::UNSPECIFIED;
+    transfer = VCS::GetTransferID(color->transfer);
+    if (transfer == VCS::TransferID::INVALID)
+      transfer = VCS::TransferID::UNSPECIFIED;
+    matrix = VCS::GetMatrixID(color->matrix);
+    // Identity (RGB) makes no sense for YUV input.
+    if (matrix == VCS::MatrixID::INVALID || matrix == VCS::MatrixID::RGB)
+      matrix = VCS::MatrixID::UNSPECIFIED;
+    if (color->range == CEF_EXTERNAL_VIDEO_RANGE_FULL)
+      range = gfx::ColorSpace::RangeID::FULL;
+  }
+
+  const bool hd = height >= 720;
+  if (primaries == VCS::PrimaryID::UNSPECIFIED &&
+      transfer == VCS::TransferID::UNSPECIFIED &&
+      matrix == VCS::MatrixID::UNSPECIFIED) {
+    // Nothing signaled: same heuristic as FFmpeg and most players.
+    primaries = hd ? VCS::PrimaryID::BT709 : VCS::PrimaryID::SMPTE170M;
+    transfer = hd ? VCS::TransferID::BT709 : VCS::TransferID::SMPTE170M;
+    matrix = hd ? VCS::MatrixID::BT709 : VCS::MatrixID::SMPTE170M;
+  }
+
+  // Unspecified fields left at this point are guessed from the specified ones
+  // by VideoColorSpace::ToGfxColorSpace().
+  gfx::ColorSpace cs =
+      VCS(primaries, transfer, matrix, range).ToGfxColorSpace();
+  if (!cs.IsValid()) {
+    cs = hd ? gfx::ColorSpace(gfx::ColorSpace::PrimaryID::BT709,
+                              gfx::ColorSpace::TransferID::BT709,
+                              gfx::ColorSpace::MatrixID::BT709, range)
+            : gfx::ColorSpace(gfx::ColorSpace::PrimaryID::SMPTE170M,
+                              gfx::ColorSpace::TransferID::SMPTE170M,
+                              gfx::ColorSpace::MatrixID::SMPTE170M, range);
+  }
+  return cs;
+}
+
+// static
+scoped_refptr<ExternalVideoSource> ExternalVideoSource::Create(
+    const std::string& device_id,
+    const std::string& label,
+    const gfx::Size& max_size,
+    float max_fps) {
+  if (!CONTEXT_STATE_VALID()) {
+    LOG(ERROR) << "cef_external_video: CEF is not initialized";
+    return nullptr;
+  }
+  const media::VideoCaptureFormat format(max_size, max_fps,
+                                         media::PIXEL_FORMAT_I420);
+  if (device_id.empty() || max_size.IsEmpty() || !(max_fps > 0.f) ||
+      !format.IsValid()) {
+    LOG(ERROR) << "cef_external_video: invalid arguments";
+    return nullptr;
+  }
+
+  media::VideoCaptureDeviceInfo device_info(media::VideoCaptureDeviceDescriptor(
+      label.empty() ? device_id : label, device_id,
+      media::VideoCaptureApi::VIRTUAL_DEVICE));
+  device_info.supported_formats.push_back(format);
+
+  // A dedicated sequence per source keeps the per-frame memcpy off the UI
+  // thread and lets independent sources run in parallel.
+  scoped_refptr<base::SequencedTaskRunner> task_runner =
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::TaskPriority::USER_BLOCKING,
+           base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN});
+
+  scoped_refptr<ExternalVideoSource> source(
+      new ExternalVideoSource(task_runner, device_info, max_fps));
+
+  // The pipe can be created on any thread. The service connection itself must
+  // be requested on the UI thread; the remote end is bound on |task_runner|.
+  mojo::PendingRemote<video_capture::mojom::VideoSourceProvider> provider;
+  auto provider_receiver = provider.InitWithNewPipeAndPassReceiver();
+  content::GetUIThreadTaskRunner({})->PostTask(
+      FROM_HERE, base::BindOnce(&ConnectToVideoSourceProviderOnUIThread,
+                                std::move(provider_receiver)));
+  task_runner->PostTask(
+      FROM_HERE, base::BindOnce(&ExternalVideoSource::InitOnSequence, source,
+                                std::move(provider)));
+  return source;
+}
+
+ExternalVideoSource::ExternalVideoSource(
+    scoped_refptr<base::SequencedTaskRunner> task_runner,
+    const media::VideoCaptureDeviceInfo& device_info,
+    float max_fps)
+    : base::RefCountedDeleteOnSequence<ExternalVideoSource>(task_runner),
+      task_runner_(std::move(task_runner)),
+      device_info_(device_info),
+      max_size_(device_info.supported_formats[0].frame_size),
+      max_fps_(max_fps) {}
+
+ExternalVideoSource::~ExternalVideoSource() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+}
+
+bool ExternalVideoSource::PushFrame(const uint8_t* y,
+                                    int y_stride,
+                                    const uint8_t* u,
+                                    int u_stride,
+                                    const uint8_t* v,
+                                    int v_stride,
+                                    int width,
+                                    int height,
+                                    int64_t timestamp_us,
+                                    const gfx::ColorSpace& color_space) {
+  const int chroma_width = (width + 1) / 2;
+  if (!y || !u || !v || width <= 0 || height <= 0 ||
+      width > max_size_.width() || height > max_size_.height() ||
+      y_stride < width || u_stride < chroma_width ||
+      v_stride < chroma_width) {
+    return false;
+  }
+
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_)
+      return false;
+  }
+
+  // I420 in Chromium wants an even coded size; odd sizes are expressed via
+  // the visible rect.
+  const gfx::Size coded_size((width + 1) & ~1, (height + 1) & ~1);
+  scoped_refptr<media::VideoFrame> frame = media::VideoFrame::CreateFrame(
+      media::PIXEL_FORMAT_I420, coded_size, gfx::Rect(width, height),
+      gfx::Size(width, height), base::Microseconds(timestamp_us));
+  if (!frame)
+    return false;
+
+  libyuv::I420Copy(y, y_stride, u, u_stride, v, v_stride,
+                   frame->writable_data(media::VideoFrame::kYPlane),
+                   frame->stride(media::VideoFrame::kYPlane),
+                   frame->writable_data(media::VideoFrame::kUPlane),
+                   frame->stride(media::VideoFrame::kUPlane),
+                   frame->writable_data(media::VideoFrame::kVPlane),
+                   frame->stride(media::VideoFrame::kVPlane), width, height);
+  frame->metadata().reference_time = base::TimeTicks::Now();
+  frame->set_color_space(color_space);
+
+  bool post_request = false;
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_)
+      return false;
+    // Newest frame wins: an older frame still waiting here is dropped.
+    pending_frame_ = std::move(frame);
+    if (!request_in_flight_) {
+      request_in_flight_ = true;
+      post_request = true;
+    }
+  }
+
+  if (post_request) {
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ExternalVideoSource::RequestBufferOnSequence,
+                       base::WrapRefCounted(this)));
+  }
+  return true;
+}
+
+void ExternalVideoSource::Shutdown() {
+  {
+    base::AutoLock lock(lock_);
+    shut_down_ = true;
+    pending_frame_ = nullptr;
+  }
+  task_runner_->PostTask(
+      FROM_HERE, base::BindOnce(&ExternalVideoSource::ShutdownOnSequence,
+                                base::WrapRefCounted(this)));
+}
+
+void ExternalVideoSource::InitOnSequence(
+    mojo::PendingRemote<video_capture::mojom::VideoSourceProvider> provider) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_)
+      return;
+  }
+
+  // Keep the provider connection for the lifetime of the source: the video
+  // capture service shuts itself down when it has no clients.
+  provider_.Bind(std::move(provider));
+  provider_.set_disconnect_handler(base::BindOnce(
+      &ExternalVideoSource::OnConnectionError, base::Unretained(this)));
+
+  provider_->AddSharedMemoryVirtualDevice(
+      device_info_, producer_receiver_.BindNewPipeAndPassRemote(),
+      device_.BindNewPipeAndPassReceiver());
+  device_.set_disconnect_handler(base::BindOnce(
+      &ExternalVideoSource::OnConnectionError, base::Unretained(this)));
+}
+
+void ExternalVideoSource::ShutdownOnSequence() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  // Releasing |device_| unregisters the virtual device; pages showing it see
+  // the track end and get a devicechange event.
+  device_.reset();
+  producer_receiver_.reset();
+  provider_.reset();
+  buffers_.clear();
+}
+
+void ExternalVideoSource::OnConnectionError() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  LOG(WARNING) << "cef_external_video: lost connection to the video capture "
+                  "service for device "
+               << device_info_.descriptor.device_id;
+  {
+    base::AutoLock lock(lock_);
+    shut_down_ = true;
+    pending_frame_ = nullptr;
+    request_in_flight_ = false;
+  }
+  ShutdownOnSequence();
+}
+
+void ExternalVideoSource::RequestBufferOnSequence() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  scoped_refptr<media::VideoFrame> frame;
+  {
+    base::AutoLock lock(lock_);
+    frame = std::move(pending_frame_);
+    if (!frame || shut_down_ || !device_.is_bound()) {
+      request_in_flight_ = false;
+      return;
+    }
+  }
+
+  const gfx::Size coded_size = frame->coded_size();
+  device_->RequestFrameBuffer(
+      coded_size, media::PIXEL_FORMAT_I420, /*strides=*/nullptr,
+      base::BindOnce(&ExternalVideoSource::OnBufferReady,
+                     base::WrapRefCounted(this), std::move(frame)));
+}
+
+void ExternalVideoSource::OnBufferReady(scoped_refptr<media::VideoFrame> frame,
+                                        int32_t buffer_id) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+
+  if (buffer_id == video_capture::mojom::kInvalidBufferId) {
+    // All buffers are in use by consumers: drop this frame.
+    DVLOG(1) << "cef_external_video: no free buffer, frame dropped";
+  } else if (device_.is_bound()) {
+    auto it = buffers_.find(buffer_id);
+    if (it != buffers_.end() && CopyToBuffer(*frame, it->second)) {
+      media::mojom::VideoFrameInfoPtr info =
+          media::mojom::VideoFrameInfo::New();
+      info->timestamp = frame->timestamp();
+      info->metadata = frame->metadata();
+      info->metadata.frame_rate = max_fps_;
+      info->pixel_format = media::PIXEL_FORMAT_I420;
+      info->coded_size = frame->coded_size();
+      info->visible_rect = frame->visible_rect();
+      info->is_premapped = false;
+      info->color_space = frame->ColorSpace();
+      device_->OnFrameReadyInBuffer(buffer_id, std::move(info));
+    } else {
+      // Should not happen: the service acks OnNewBuffer() before replying to
+      // RequestFrameBuffer(). The reservation is not returned in this case.
+      LOG(ERROR) << "cef_external_video: unknown or too small buffer "
+                 << buffer_id;
+    }
+  }
+
+  bool request_next = false;
+  {
+    base::AutoLock lock(lock_);
+    if (pending_frame_ && !shut_down_)
+      request_next = true;
+    else
+      request_in_flight_ = false;
+  }
+  if (request_next)
+    RequestBufferOnSequence();
+}
+
+bool ExternalVideoSource::CopyToBuffer(
+    const media::VideoFrame& frame,
+    base::WritableSharedMemoryMapping& mapping) {
+  const gfx::Size& coded = frame.coded_size();
+  const size_t needed =
+      media::VideoFrame::AllocationSize(media::PIXEL_FORMAT_I420, coded);
+  if (!mapping.IsValid() || mapping.size() < needed)
+    return false;
+
+  // Tightly packed I420, which is what the consumer assumes when no strides
+  // are sent: Y (w*h), then U and V ((w/2)*(h/2) each). |coded| is even.
+  const int w = coded.width();
+  const int h = coded.height();
+  const int cw = w / 2;
+  const int ch = h / 2;
+  uint8_t* dst_y = static_cast<uint8_t*>(mapping.memory());
+  uint8_t* dst_u = dst_y + w * h;
+  uint8_t* dst_v = dst_u + cw * ch;
+
+  libyuv::I420Copy(frame.data(media::VideoFrame::kYPlane),
+                   frame.stride(media::VideoFrame::kYPlane),
+                   frame.data(media::VideoFrame::kUPlane),
+                   frame.stride(media::VideoFrame::kUPlane),
+                   frame.data(media::VideoFrame::kVPlane),
+                   frame.stride(media::VideoFrame::kVPlane), dst_y, w, dst_u,
+                   cw, dst_v, cw, w, h);
+  return true;
+}
+
+void ExternalVideoSource::OnNewBuffer(
+    int32_t buffer_id,
+    media::mojom::VideoBufferHandlePtr buffer_handle,
+    OnNewBufferCallback callback) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  if (buffer_handle->is_unsafe_shmem_region()) {
+    base::WritableSharedMemoryMapping mapping =
+        buffer_handle->get_unsafe_shmem_region().Map();
+    if (mapping.IsValid())
+      buffers_[buffer_id] = std::move(mapping);
+    else
+      LOG(ERROR) << "cef_external_video: failed to map buffer " << buffer_id;
+  } else {
+    LOG(ERROR) << "cef_external_video: unexpected buffer handle type";
+  }
+  std::move(callback).Run();
+}
+
+void ExternalVideoSource::OnBufferRetired(int32_t buffer_id) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  buffers_.erase(buffer_id);
+}
+
+}  // namespace cef_external_video
+
+// C API (include/cef_external_video.h).
+
+struct _cef_external_video_t {
+  scoped_refptr<cef_external_video::ExternalVideoSource> source;
+};
+
+CEF_EXPORT cef_external_video_t* cef_external_video_create(
+    const char* device_id,
+    const char* label,
+    int max_width,
+    int max_height,
+    float max_fps) {
+  // Reject negative values here: gfx::Size would silently clamp them to 0,
+  // which means "use the default".
+  if (!device_id || max_width < 0 || max_height < 0 || !(max_fps >= 0.f))
+    return nullptr;
+  if (max_width == 0)
+    max_width = CEF_EXTERNAL_VIDEO_DEFAULT_MAX_WIDTH;
+  if (max_height == 0)
+    max_height = CEF_EXTERNAL_VIDEO_DEFAULT_MAX_HEIGHT;
+  if (max_fps == 0.f)
+    max_fps = CEF_EXTERNAL_VIDEO_DEFAULT_MAX_FPS;
+  auto source = cef_external_video::ExternalVideoSource::Create(
+      device_id, label ? label : "", gfx::Size(max_width, max_height),
+      max_fps);
+  if (!source)
+    return nullptr;
+  return new _cef_external_video_t{std::move(source)};
+}
+
+CEF_EXPORT int cef_external_video_push_frame(
+    cef_external_video_t* source,
+    const uint8_t* y,
+    int y_stride,
+    const uint8_t* u,
+    int u_stride,
+    const uint8_t* v,
+    int v_stride,
+    int width,
+    int height,
+    int64_t timestamp_us,
+    const cef_external_video_color_t* color) {
+  if (!source || !source->source)
+    return 0;
+  return source->source->PushFrame(
+             y, y_stride, u, u_stride, v, v_stride, width, height,
+             timestamp_us, cef_external_video::ToGfxColorSpace(color, height))
+             ? 1
+             : 0;
+}
+
+CEF_EXPORT void cef_external_video_destroy(cef_external_video_t* source) {
+  if (!source)
+    return;
+  if (source->source)
+    source->source->Shutdown();
+  delete source;
+}
