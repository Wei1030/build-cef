+namespace {
+
+using SlotPixelFormat = ExternalVideoSource::SlotPixelFormat;
+
+bool IsBiplanarSlotFormat(SlotPixelFormat fmt) {
+  return fmt == SlotPixelFormat::kNV12 || fmt == SlotPixelFormat::kP010;
+}
+
+gfx::BufferFormat ToGfxBufferFormat(SlotPixelFormat fmt) {
+  switch (fmt) {
+    case SlotPixelFormat::kNV12:
+      return gfx::BufferFormat::YUV_420_BIPLANAR;
+    case SlotPixelFormat::kP010:
+      return gfx::BufferFormat::P010;
+    case SlotPixelFormat::kBGRA8:
+      return gfx::BufferFormat::BGRA_8888;
+    case SlotPixelFormat::kRGBA8:
+      return gfx::BufferFormat::RGBA_8888;
+  }
+  return gfx::BufferFormat::YUV_420_BIPLANAR;
+}
+
+media::VideoPixelFormat ToMediaVideoPixelFormat(SlotPixelFormat fmt) {
+  switch (fmt) {
+    case SlotPixelFormat::kNV12:
+      return media::PIXEL_FORMAT_NV12;
+    case SlotPixelFormat::kP010:
+      return media::PIXEL_FORMAT_P016LE;
+    case SlotPixelFormat::kBGRA8:
+      // VideoResourceUpdater maps PIXEL_FORMAT_XRGB -> BGRA_8888 + opaque RGB,
+      // avoiding unwanted transparency if a video SDK leaves Alpha == 0.
+      return media::PIXEL_FORMAT_XRGB;
+    case SlotPixelFormat::kRGBA8:
+      return media::PIXEL_FORMAT_XBGR;
+  }
+  return media::PIXEL_FORMAT_NV12;
+}
+
+bool FromCefGpuFormat(cef_external_video_gpu_format_t fmt,
+                      SlotPixelFormat* out) {
+  switch (fmt) {
+    case CEF_EXT_GPU_FORMAT_NV12:
+      *out = SlotPixelFormat::kNV12;
+      return true;
+    case CEF_EXT_GPU_FORMAT_P010:
+      *out = SlotPixelFormat::kP010;
+      return true;
+    case CEF_EXT_GPU_FORMAT_BGRA8:
+      *out = SlotPixelFormat::kBGRA8;
+      return true;
+    case CEF_EXT_GPU_FORMAT_RGBA8:
+      *out = SlotPixelFormat::kRGBA8;
+      return true;
+    default:
+      return false;
+  }
+}
+
+gfx::ColorSpace ResolveGpuFrameColorSpace(
+    const cef_external_video_color_t* color,
+    int height,
+    SlotPixelFormat fmt) {
+  if (!IsBiplanarSlotFormat(fmt)) {
+    if (!color) {
+      return gfx::ColorSpace::CreateSRGB();
+    }
+    gfx::ColorSpace cs = ToGfxColorSpace(color, height).GetAsFullRangeRGB();
+    return cs.IsValid() ? cs : gfx::ColorSpace::CreateSRGB();
+  }
+  return ToGfxColorSpace(color, height);
+}
+
+bool ComputeAndValidateVisibleRect(const cef_external_video_gpu_frame_t& frame,
+                                   const gfx::Size& coded_size,
+                                   const gfx::Size& max_size,
+                                   SlotPixelFormat fmt,
+                                   gfx::Rect* out_visible_rect) {
+  if (coded_size.width() <= 0 || coded_size.height() <= 0 ||
+      coded_size.width() > max_size.width() ||
+      coded_size.height() > max_size.height() ||
+      coded_size.width() > kMaxHardwareTextureDimension ||
+      coded_size.height() > kMaxHardwareTextureDimension) {
+    return false;
+  }
+  if (!gpu::IsImageSizeValidForGpuMemoryBufferFormat(coded_size,
+                                                     ToGfxBufferFormat(fmt))) {
+    return false;
+  }
+
+  const int vx = frame.visible_x;
+  const int vy = frame.visible_y;
+  if (vx < 0 || vy < 0 || vx >= coded_size.width() ||
+      vy >= coded_size.height()) {
+    return false;
+  }
+  const int vw =
+      (frame.visible_width == 0) ? (coded_size.width() - vx) : frame.visible_width;
+  const int vh = (frame.visible_height == 0) ? (coded_size.height() - vy)
+                                             : frame.visible_height;
+  if (vw <= 0 || vh <= 0 || vx + vw > coded_size.width() ||
+      vy + vh > coded_size.height()) {
+    return false;
+  }
+  if (IsBiplanarSlotFormat(fmt) && ((vx & 1) != 0 || (vy & 1) != 0)) {
+    return false;
+  }
+
+  const gfx::Rect vis(vx, vy, vw, vh);
+  if (!media::VideoFrame::IsValidConfig(ToMediaVideoPixelFormat(fmt),
+                                        media::VideoFrame::STORAGE_OPAQUE,
+                                        coded_size, vis, vis.size())) {
+    return false;
+  }
+  *out_visible_rect = vis;
+  return true;
+}
