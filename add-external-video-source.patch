+
+  bool IsDeviceHealthy() const {
+    return !device_failed_.load(std::memory_order_acquire) && d3d11_device_ &&
+           d3d12_device_ &&
+           SUCCEEDED(d3d11_device_->GetDeviceRemovedReason()) &&
+           SUCCEEDED(d3d12_device_->GetDeviceRemovedReason());
+  }
+
+  static DXGI_FORMAT ToSlotDxgiFormat(SlotPixelFormat fmt) {
+    switch (fmt) {
+      case SlotPixelFormat::kNV12:
+      case SlotPixelFormat::kP010:
+        // Chromium 109's D3DImageBackingFactory supports NV12, BGRA8, RGBA8;
+        // P010 inputs are converted on-GPU via ID3D11VideoProcessorBlt -> NV12.
+        return DXGI_FORMAT_NV12;
+      case SlotPixelFormat::kBGRA8:
+        return DXGI_FORMAT_B8G8R8A8_UNORM;
+      case SlotPixelFormat::kRGBA8:
+        return DXGI_FORMAT_R8G8B8A8_UNORM;
+    }
+    return DXGI_FORMAT_NV12;
+  }
+
+  static bool ClassifyDxgiFormat(DXGI_FORMAT dxgi_fmt,
+                                 SlotPixelFormat* out_slot_fmt,
+                                 bool* out_direct_copy_ok) {
+    switch (dxgi_fmt) {
+      case DXGI_FORMAT_NV12:
+        *out_slot_fmt = SlotPixelFormat::kNV12;
+        *out_direct_copy_ok = true;
+        return true;
+      case DXGI_FORMAT_B8G8R8A8_UNORM:
+      case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+      case DXGI_FORMAT_B8G8R8A8_TYPELESS:
+        *out_slot_fmt = SlotPixelFormat::kBGRA8;
+        *out_direct_copy_ok = true;
+        return true;
+      case DXGI_FORMAT_B8G8R8X8_UNORM:
+      case DXGI_FORMAT_B8G8R8X8_UNORM_SRGB:
+      case DXGI_FORMAT_B8G8R8X8_TYPELESS:
+        *out_slot_fmt = SlotPixelFormat::kBGRA8;
+        *out_direct_copy_ok = false;  // VideoProcessorBlt converts BGRX -> BGRA
+        return true;
+      case DXGI_FORMAT_R8G8B8A8_UNORM:
+      case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+      case DXGI_FORMAT_R8G8B8A8_TYPELESS:
+        *out_slot_fmt = SlotPixelFormat::kRGBA8;
+        *out_direct_copy_ok = true;
+        return true;
+      case DXGI_FORMAT_P010:
+      case DXGI_FORMAT_P016:
+      case DXGI_FORMAT_YUY2:
+      case DXGI_FORMAT_AYUV:
+        *out_slot_fmt = SlotPixelFormat::kNV12;
+        *out_direct_copy_ok = false;  // VideoProcessorBlt converts -> NV12
+        return true;
+      default:
+        return false;
+    }
+  }
+
+  bool OpenExternalSharedTexture(
+      HANDLE raw_handle,
+      int32_t is_nt_handle,
+      Microsoft::WRL::ComPtr<ID3D11Texture2D>* out_tex,
+      D3D11_TEXTURE2D_DESC* out_desc,
+      bool* out_opened_as_nt) {
+    if (!raw_handle || !IsDeviceHealthy()) {
+      return false;
+    }
+
+    Microsoft::WRL::ComPtr<ID3D11Texture2D> tex;
+    bool opened_nt = false;
+    if (is_nt_handle > 0) {
+      Microsoft::WRL::ComPtr<ID3D11Device1> dev1;
+      if (FAILED(d3d11_device_.As(&dev1)) || !dev1 ||
+          FAILED(dev1->OpenSharedResource1(raw_handle, IID_PPV_ARGS(&tex))) ||
+          !tex) {
+        return false;
+      }
+      opened_nt = true;
+    } else {
+      // Try legacy D3D11_RESOURCE_MISC_SHARED handle first (PlayM4 default),
+      // then fall back to NT handle (MISC_SHARED_NTHANDLE).
+      if (SUCCEEDED(
+              d3d11_device_->OpenSharedResource(raw_handle, IID_PPV_ARGS(&tex))) &&
+          tex) {
+        opened_nt = false;
+      } else {
+        Microsoft::WRL::ComPtr<ID3D11Device1> dev1;
+        if (FAILED(d3d11_device_.As(&dev1)) || !dev1 ||
+            FAILED(dev1->OpenSharedResource1(raw_handle, IID_PPV_ARGS(&tex))) ||
+            !tex) {
+          return false;
+        }
+        opened_nt = true;
+      }
+    }
+
+    D3D11_TEXTURE2D_DESC desc = {};
+    tex->GetDesc(&desc);
+    if (desc.Width == 0 || desc.Height == 0) {
+      return false;
+    }
+    *out_tex = std::move(tex);
+    *out_desc = desc;
+    if (out_opened_as_nt) {
+      *out_opened_as_nt = opened_nt;
+    }
+    return true;
+  }
+
+  bool CreateSharedSlotTexture(
+      const gfx::Size& coded_size,
+      SlotPixelFormat slot_format,
+      Microsoft::WRL::ComPtr<ID3D11Texture2D>* out_d3d11_tex,
+      Microsoft::WRL::ComPtr<ID3D12Resource>* out_d3d12_res,
+      D3D12_PLACED_SUBRESOURCE_FOOTPRINT out_footprints[2],
+      UINT64* out_total_bytes,
+      base::win::ScopedHandle* out_dxgi_handle) {
+    if (!IsDeviceHealthy()) {
+      return false;
+    }
+
+    const DXGI_FORMAT dxgi_fmt = ToSlotDxgiFormat(slot_format);
+    D3D11_TEXTURE2D_DESC desc = {};
+    desc.Width = static_cast<UINT>(coded_size.width());
+    desc.Height = static_cast<UINT>(coded_size.height());
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.Format = dxgi_fmt;
+    desc.SampleDesc.Count = 1;
+    desc.SampleDesc.Quality = 0;
+    desc.Usage = D3D11_USAGE_DEFAULT;
+    desc.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+    desc.CPUAccessFlags = 0;
+    desc.MiscFlags =
+        D3D11_RESOURCE_MISC_SHARED_NTHANDLE | D3D11_RESOURCE_MISC_SHARED;
+
+    Microsoft::WRL::ComPtr<ID3D11Texture2D> tex11;
+    HRESULT hr = d3d11_device_->CreateTexture2D(&desc, nullptr, &tex11);
+    if (FAILED(hr) || !tex11) {
+      return false;
+    }
+
+    Microsoft::WRL::ComPtr<IDXGIResource1> dxgi_res;
+    if (FAILED(tex11.As(&dxgi_res)) || !dxgi_res) {
+      return false;
+    }
+
+    HANDLE raw_handle = nullptr;
+    hr = dxgi_res->CreateSharedHandle(
+        nullptr, DXGI_SHARED_RESOURCE_READ | DXGI_SHARED_RESOURCE_WRITE,
+        nullptr, &raw_handle);
+    if (FAILED(hr) || !raw_handle) {
+      return false;
+    }
+    base::win::ScopedHandle scoped_handle(raw_handle);
+
+    Microsoft::WRL::ComPtr<ID3D12Resource> tex12;
+    UINT64 total_bytes = 0;
+    if (dxgi_fmt == DXGI_FORMAT_NV12) {
+      hr = d3d12_device_->OpenSharedHandle(scoped_handle.Get(),
+                                           IID_PPV_ARGS(&tex12));
+      if (FAILED(hr) || !tex12) {
+        return false;
+      }
+      const D3D12_RESOURCE_DESC tex12_desc = tex12->GetDesc();
+      UINT num_rows[2] = {};
+      UINT64 row_sizes[2] = {};
+      d3d12_device_->GetCopyableFootprints(&tex12_desc, 0, 2, 0, out_footprints,
+                                           num_rows, row_sizes, &total_bytes);
+      if (total_bytes == 0) {
+        return false;
+      }
+    }
+
+    *out_d3d11_tex = std::move(tex11);
+    *out_d3d12_res = std::move(tex12);
+    *out_total_bytes = total_bytes;
+    *out_dxgi_handle = std::move(scoped_handle);
+    return true;
+  }
+
+  bool CreateColdStartCopyInVram(
+      ID3D11Texture2D* src_tex,
+      const D3D11_TEXTURE2D_DESC& src_desc,
+      SlotPixelFormat dst_slot_format,
+      bool direct_copy_ok,
+      uint64_t keyed_acq,
+      uint64_t keyed_rel,
+      Microsoft::WRL::ComPtr<ID3D11Texture2D>* out_temp_tex) {
+    if (!src_tex || !IsDeviceHealthy()) {
+      return false;
+    }
+    D3D11_TEXTURE2D_DESC dst_desc = {};
+    dst_desc.Width = src_desc.Width;
+    dst_desc.Height = src_desc.Height;
+    dst_desc.MipLevels = 1;
+    dst_desc.ArraySize = 1;
+    dst_desc.Format = ToSlotDxgiFormat(dst_slot_format);
+    dst_desc.SampleDesc.Count = 1;
+    dst_desc.Usage = D3D11_USAGE_DEFAULT;
+    dst_desc.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_RENDER_TARGET;
+
+    Microsoft::WRL::ComPtr<ID3D11Texture2D> temp_tex;
+    if (FAILED(d3d11_device_->CreateTexture2D(&dst_desc, nullptr, &temp_tex)) ||
+        !temp_tex) {
+      return false;
+    }
+    if (!ExecuteD3D11CopyOrBltSync(src_tex, src_desc, temp_tex.Get(), dst_desc,
+                                   direct_copy_ok, keyed_acq, keyed_rel,
+                                   /*wait_until_gpu_done=*/true,
+                                   /*out_signaled_fence=*/nullptr)) {
+      return false;
+    }
+    *out_temp_tex = std::move(temp_tex);
+    return true;
+  }
+
+  UploadStatus SubmitGpuTextureCopy(
+      ID3D11Texture2D* src_tex,
+      const D3D11_TEXTURE2D_DESC& src_desc,
+      Microsoft::WRL::ComPtr<ID3D11Texture2D> dst_slot_tex,
+      SlotPixelFormat dst_slot_format,
+      bool direct_copy_ok,
+      uint64_t keyed_acq,
+      uint64_t keyed_rel,
+      bool wait_until_gpu_done,
+      CompletionCallback on_complete) {
+    if (!src_tex || !dst_slot_tex || !IsDeviceHealthy()) {
+      return UploadStatus::kFatalError;
+    }
+    D3D11_TEXTURE2D_DESC dst_desc = {};
+    dst_slot_tex->GetDesc(&dst_desc);
+    if (dst_desc.Format != ToSlotDxgiFormat(dst_slot_format)) {
+      return UploadStatus::kFatalError;
+    }
+
+    uint64_t signaled_fv = 0;
+    if (!ExecuteD3D11CopyOrBltSync(src_tex, src_desc, dst_slot_tex.Get(),
+                                   dst_desc, direct_copy_ok, keyed_acq,
+                                   keyed_rel, wait_until_gpu_done,
+                                   &signaled_fv)) {
+      return IsDeviceHealthy() ? UploadStatus::kTransientDrop
+                               : UploadStatus::kFatalError;
+    }
+
+    if (signaled_fv == 0) {
+      // Either wait_until_gpu_done already waited for GPU copy completion, or
+      // D3D11->D3D12 shared fence is unavailable.
+      std::move(on_complete).Run(true);
+      return UploadStatus::kSubmitted;
+    }
+
+    {
+      base::AutoLock q_lock(queue_lock_);
+      if (device_failed_.load(std::memory_order_acquire)) {
+        return UploadStatus::kFatalError;
+      }
+      Microsoft::WRL::ComPtr<IUnknown> keep_alive;
+      dst_slot_tex.As(&keep_alive);
+      pending_copies_.push_back({signaled_fv, kInvalidUploadSlot,
+                                 std::move(keep_alive),
+                                 std::move(on_complete)});
+      queue_cv_.Signal();
+    }
+    return UploadStatus::kSubmitted;
+  }
+
+  UploadStatus SubmitAsyncUploadNV12(
+      Microsoft::WRL::ComPtr<ID3D12Resource> dst_d3d12_res,
+      const D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprints[2],
+      UINT64 total_upload_bytes,
+      const gfx::Size& coded_size,
+      const uint8_t* y,
+      int y_stride,
+      const uint8_t* u,
+      int u_stride,
+      const uint8_t* v,
+      int v_stride,
+      int width,
+      int height,
+      CompletionCallback on_complete) {
+    if (!dst_d3d12_res || !IsDeviceHealthy()) {
+      return UploadStatus::kFatalError;
+    }
+
+    size_t upload_idx = 0;
+    if (!TryAcquireUploadSlotIndex(&upload_idx)) {
+      return IsDeviceHealthy() ? UploadStatus::kTransientDrop
+                               : UploadStatus::kFatalError;
+    }
+    UploadBufferSlot& up = upload_slots_[upload_idx];
+
+    if (!EnsureUploadSlotCapacity(&up, total_upload_bytes)) {
+      ReturnUploadSlotIndex(upload_idx);
+      return IsDeviceHealthy() ? UploadStatus::kTransientDrop
+                               : UploadStatus::kFatalError;
+    }
+
+    uint8_t* dst_y = up.cpu_ptr + footprints[0].Offset;
+    uint8_t* dst_uv = up.cpu_ptr + footprints[1].Offset;
+    StreamCopyI420ToNV12Planes(
+        y, y_stride, u, u_stride, v, v_stride, width, height, coded_size, dst_y,
+        static_cast<int>(footprints[0].Footprint.RowPitch), dst_uv,
+        static_cast<int>(footprints[1].Footprint.RowPitch));
+
+    if (FAILED(up.cmd_allocator->Reset()) ||
+        FAILED(up.cmd_list->Reset(up.cmd_allocator.Get(), nullptr))) {
+      ReturnUploadSlotIndex(upload_idx);
+      return UploadStatus::kFatalError;
+    }
+
+    for (UINT plane = 0; plane < 2; ++plane) {
+      D3D12_TEXTURE_COPY_LOCATION dst_loc = {};
+      dst_loc.pResource = dst_d3d12_res.Get();
+      dst_loc.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+      dst_loc.SubresourceIndex = plane;
+
+      D3D12_TEXTURE_COPY_LOCATION src_loc = {};
+      src_loc.pResource = up.upload_buffer.Get();
+      src_loc.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+      src_loc.PlacedFootprint = footprints[plane];
+
+      up.cmd_list->CopyTextureRegion(&dst_loc, 0, 0, 0, &src_loc, nullptr);
+    }
+
+    if (FAILED(up.cmd_list->Close())) {
+      ReturnUploadSlotIndex(upload_idx);
+      return UploadStatus::kFatalError;
+    }
+
+    {
+      base::AutoLock lock(queue_lock_);
+      if (device_failed_.load(std::memory_order_acquire)) {
+        return UploadStatus::kFatalError;
+      }
+      ID3D12CommandList* cmd_lists[] = {up.cmd_list.Get()};
+      copy_queue_->ExecuteCommandLists(1, cmd_lists);
+      const uint64_t fv = AllocateFenceValue();
+      if (FAILED(copy_queue_->Signal(fence_.Get(), fv))) {
+        MarkDeviceFailed();
+        return UploadStatus::kFatalError;
+      }
+      Microsoft::WRL::ComPtr<IUnknown> keep_alive;
+      dst_d3d12_res.As(&keep_alive);
+      pending_copies_.push_back(
+          {fv, upload_idx, std::move(keep_alive), std::move(on_complete)});
+      queue_cv_.Signal();
+    }
+    return UploadStatus::kSubmitted;
+  }
+
+ private:
+  friend class base::RefCountedThreadSafe<SharedD3D12CopyUploader>;
+
+  static constexpr size_t kMaxUploadSlots = (sizeof(void*) == 4) ? 12u : 32u;
+  static constexpr size_t kInvalidUploadSlot = static_cast<size_t>(-1);
+
+  struct UploadBufferSlot {
+    UINT64 capacity_bytes = 0;
+    Microsoft::WRL::ComPtr<ID3D12Resource> upload_buffer;
+    uint8_t* cpu_ptr = nullptr;
+    Microsoft::WRL::ComPtr<ID3D12CommandAllocator> cmd_allocator;
+    Microsoft::WRL::ComPtr<ID3D12GraphicsCommandList> cmd_list;
+  };
+
+  struct PendingCopy {
+    uint64_t fence_value;
+    size_t upload_slot_idx;
+    Microsoft::WRL::ComPtr<IUnknown> dst_keep_alive;
+    CompletionCallback on_complete;
+  };
+
+  SharedD3D12CopyUploader(
+      const CHROME_LUID& luid,
+      Microsoft::WRL::ComPtr<ID3D11Device> d3d11_device,
+      Microsoft::WRL::ComPtr<ID3D11DeviceContext> d3d11_context,
+      Microsoft::WRL::ComPtr<ID3D11DeviceContext4> d3d11_context4,
+      Microsoft::WRL::ComPtr<ID3D11Fence> d3d11_fence,
+      Microsoft::WRL::ComPtr<ID3D11Fence> d3d11_sync_fence,
+      base::win::ScopedHandle d3d11_sync_event,
+      Microsoft::WRL::ComPtr<ID3D11Query> d3d11_sync_query,
+      Microsoft::WRL::ComPtr<ID3D12Device> d3d12_device,
+      Microsoft::WRL::ComPtr<ID3D12CommandQueue> copy_queue,
+      Microsoft::WRL::ComPtr<ID3D12Fence> fence,
+      base::win::ScopedHandle fence_event)
+      : luid_(luid),
+        d3d11_device_(std::move(d3d11_device)),
+        d3d11_context_(std::move(d3d11_context)),
+        d3d11_context4_(std::move(d3d11_context4)),
+        d3d11_fence_(std::move(d3d11_fence)),
+        d3d11_sync_fence_(std::move(d3d11_sync_fence)),
+        d3d11_sync_event_(std::move(d3d11_sync_event)),
+        d3d11_sync_query_(std::move(d3d11_sync_query)),
+        d3d12_device_(std::move(d3d12_device)),
+        copy_queue_(std::move(copy_queue)),
+        fence_(std::move(fence)),
+        fence_event_(std::move(fence_event)),
+        queue_cv_(&queue_lock_) {
+    for (size_t i = 0; i < kMaxUploadSlots; ++i) {
+      free_upload_indices_.push_back(i);
+    }
+  }
+
+  ~SharedD3D12CopyUploader() {
+    for (auto& slot : upload_slots_) {
+      if (slot.upload_buffer && slot.cpu_ptr) {
+        slot.upload_buffer->Unmap(0, nullptr);
+        slot.cpu_ptr = nullptr;
+      }
+    }
+  }
+
+  uint64_t AllocateFenceValue() {
+    return next_fence_value_.fetch_add(1, std::memory_order_relaxed) + 1;
+  }
+
+  bool ExecuteD3D11CopyOrBltSync(ID3D11Texture2D* src_tex,
+                                 const D3D11_TEXTURE2D_DESC& src_desc,
+                                 ID3D11Texture2D* dst_tex,
+                                 const D3D11_TEXTURE2D_DESC& dst_desc,
+                                 bool direct_copy_ok,
+                                 uint64_t keyed_acq,
+                                 uint64_t keyed_rel,
+                                 bool wait_until_gpu_done,
+                                 uint64_t* out_signaled_fence) {
+    if (out_signaled_fence) {
+      *out_signaled_fence = 0;
+    }
+
+    Microsoft::WRL::ComPtr<IDXGIKeyedMutex> keyed_mutex;
+    const bool has_keyed_mutex =
+        (src_desc.MiscFlags & D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX) != 0 &&
+        SUCCEEDED(src_tex->QueryInterface(IID_PPV_ARGS(&keyed_mutex))) &&
+        keyed_mutex;
+
+    // On WDDM 2.7+ Hardware-Accelerated GPU Scheduling, separate D3D11 devices
+    // sharing a keyless D3D11_RESOURCE_MISC_SHARED texture execute on
+    // independent GPU rings without implicit cross-device ordering. When the
+    // caller relies on copy-on-push (no release_callback and no KeyedMutex),
+    // wait for our VRAM copy to complete (~0.05 ms) before returning so the
+    // caller can safely overwrite or destroy its texture immediately.
+    const bool need_sync_gpu_wait = wait_until_gpu_done && !has_keyed_mutex;
+    uint64_t sync_fv = 0;
+
+    {
+      base::AutoLock ctx_lock(d3d11_ctx_lock_);
+      if (!d3d11_context_ || !IsDeviceHealthy()) {
+        return false;
+      }
+
+      if (has_keyed_mutex) {
+        const HRESULT acq_hr = keyed_mutex->AcquireSync(keyed_acq, 100);
+        if (acq_hr != S_OK) {
+          LOG(WARNING) << "cef_external_video: IDXGIKeyedMutex::AcquireSync("
+                       << keyed_acq << ") failed/timed out: 0x" << std::hex
+                       << acq_hr;
+          return false;
+        }
+      }
+
+      bool copy_ok = false;
+      if (direct_copy_ok && src_desc.ArraySize == 1 &&
+          src_desc.Width == dst_desc.Width &&
+          src_desc.Height == dst_desc.Height) {
+        d3d11_context_->CopyResource(dst_tex, src_tex);
+        copy_ok = true;
+      } else {
+        copy_ok =
+            RunVideoProcessorBltLocked(src_tex, src_desc, dst_tex, dst_desc);
+      }
+
+      if (has_keyed_mutex) {
+        keyed_mutex->ReleaseSync(keyed_rel);
+      }
+
+      if (!copy_ok) {
+        return false;
+      }
+
+      // Many Windows video SDKs (e.g. PlayM4) output BGRA8/RGBA8 textures with
+      // Alpha == 0. Force Alpha = 1.0 (write-masked to the A channel only, so
+      // RGB bits remain untouched) so both Viz DirectComposition and Canvas2D
+      // drawImage() always treat the video frame as opaque.
+      if (dst_desc.Format == DXGI_FORMAT_B8G8R8A8_UNORM ||
+          dst_desc.Format == DXGI_FORMAT_R8G8B8A8_UNORM) {
+        ForceOpaqueAlphaLocked(dst_tex, dst_desc);
+      }
+
+      if (need_sync_gpu_wait) {
+        if (d3d11_context4_ && d3d11_sync_fence_ &&
+            d3d11_sync_event_.IsValid()) {
+          const uint64_t candidate_fv = ++next_d3d11_sync_fv_;
+          if (SUCCEEDED(d3d11_context4_->Signal(d3d11_sync_fence_.Get(),
+                                                candidate_fv))) {
+            sync_fv = candidate_fv;
+          }
+          d3d11_context_->Flush();
+        } else if (d3d11_sync_query_) {
+          d3d11_context_->End(d3d11_sync_query_.Get());
+          d3d11_context_->Flush();
+          BOOL query_done = FALSE;
+          const auto deadline = base::TimeTicks::Now() + base::Milliseconds(200);
+          while (d3d11_context_->GetData(d3d11_sync_query_.Get(), &query_done,
+                                         sizeof(query_done), 0) == S_FALSE) {
+            if (base::TimeTicks::Now() >= deadline || !IsDeviceHealthy()) {
+              break;
+            }
+            ::SwitchToThread();
+          }
+        } else {
+          d3d11_context_->Flush();
+        }
+      } else {
+        if (out_signaled_fence && d3d11_context4_ && d3d11_fence_) {
+          const uint64_t fv = AllocateFenceValue();
+          if (SUCCEEDED(d3d11_context4_->Signal(d3d11_fence_.Get(), fv))) {
+            *out_signaled_fence = fv;
+          }
+        }
+        d3d11_context_->Flush();
+      }
+    }
+
+    if (sync_fv > 0) {
+      base::AutoLock wait_lock(d3d11_sync_wait_lock_);
+      while (!device_failed_.load(std::memory_order_acquire)) {
+        const UINT64 done_val = d3d11_sync_fence_->GetCompletedValue();
+        if (done_val == UINT64_MAX) {
+          MarkDeviceFailed();
+          return false;
+        }
+        if (done_val >= sync_fv) {
+          break;
+        }
+        if (!IsDeviceHealthy() ||
+            FAILED(d3d11_sync_fence_->SetEventOnCompletion(
+                sync_fv, d3d11_sync_event_.Get()))) {
+          MarkDeviceFailed();
+          return false;
+        }
+        ::WaitForSingleObject(d3d11_sync_event_.Get(), 200);
+      }
+    }
+    return IsDeviceHealthy();
+  }
+
+  bool RunVideoProcessorBltLocked(ID3D11Texture2D* src_tex,
+                                  const D3D11_TEXTURE2D_DESC& src_desc,
+                                  ID3D11Texture2D* dst_tex,
+                                  const D3D11_TEXTURE2D_DESC& dst_desc)
+      EXCLUSIVE_LOCKS_REQUIRED(d3d11_ctx_lock_) {
+    if (!video_device_ || !video_context_) {
+      if (FAILED(d3d11_device_.As(&video_device_)) ||
+          FAILED(d3d11_context_.As(&video_context_)) || !video_device_ ||
+          !video_context_) {
+        return false;
+      }
+    }
+
+    if (!vp_enum_ || !video_processor_ || vp_in_w_ != src_desc.Width ||
+        vp_in_h_ != src_desc.Height || vp_out_w_ != dst_desc.Width ||
+        vp_out_h_ != dst_desc.Height) {
+      video_processor_.Reset();
+      vp_enum_.Reset();
+
+      D3D11_VIDEO_PROCESSOR_CONTENT_DESC content_desc = {};
+      content_desc.InputFrameFormat = D3D11_VIDEO_FRAME_FORMAT_PROGRESSIVE;
+      content_desc.InputWidth = src_desc.Width;
+      content_desc.InputHeight = src_desc.Height;
+      content_desc.OutputWidth = dst_desc.Width;
+      content_desc.OutputHeight = dst_desc.Height;
+      content_desc.Usage = D3D11_VIDEO_USAGE_PLAYBACK_NORMAL;
+
+      if (FAILED(video_device_->CreateVideoProcessorEnumerator(&content_desc,
+                                                               &vp_enum_)) ||
+          !vp_enum_ ||
+          FAILED(video_device_->CreateVideoProcessor(vp_enum_.Get(), 0,
+                                                     &video_processor_)) ||
+          !video_processor_) {
+        vp_enum_.Reset();
+        video_processor_.Reset();
+        return false;
+      }
+      vp_in_w_ = src_desc.Width;
+      vp_in_h_ = src_desc.Height;
+      vp_out_w_ = dst_desc.Width;
+      vp_out_h_ = dst_desc.Height;
+    }
+
+    D3D11_VIDEO_PROCESSOR_INPUT_VIEW_DESC in_view_desc = {};
+    in_view_desc.FourCC = 0;
+    in_view_desc.ViewDimension = D3D11_VPIV_DIMENSION_TEXTURE2D;
+    in_view_desc.Texture2D.MipSlice = 0;
+    in_view_desc.Texture2D.ArraySlice = 0;
+
+    Microsoft::WRL::ComPtr<ID3D11VideoProcessorInputView> in_view;
+    if (FAILED(video_device_->CreateVideoProcessorInputView(
+            src_tex, vp_enum_.Get(), &in_view_desc, &in_view)) ||
+        !in_view) {
+      return false;
+    }
+
+    D3D11_VIDEO_PROCESSOR_OUTPUT_VIEW_DESC out_view_desc = {};
+    out_view_desc.ViewDimension = D3D11_VPOV_DIMENSION_TEXTURE2D;
+    out_view_desc.Texture2D.MipSlice = 0;
+
+    Microsoft::WRL::ComPtr<ID3D11VideoProcessorOutputView> out_view;
+    if (FAILED(video_device_->CreateVideoProcessorOutputView(
+            dst_tex, vp_enum_.Get(), &out_view_desc, &out_view)) ||
+        !out_view) {
+      return false;
+    }
+
+    D3D11_VIDEO_PROCESSOR_STREAM stream = {};
+    stream.Enable = TRUE;
+    stream.pInputSurface = in_view.Get();
+    return SUCCEEDED(video_context_->VideoProcessorBlt(
+        video_processor_.Get(), out_view.Get(), 0, 1, &stream));
+  }
+
