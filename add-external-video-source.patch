+
+// Converts the color description of the C API into a gfx::ColorSpace. NULL or
+// unspecified fields are resolved as documented in
+// include/cef_external_video.h; |height| is the frame height.
+gfx::ColorSpace ToGfxColorSpace(const cef_external_video_color_t* color,
+                                int height);
+
+// One external video source registered with Chromium's video capture service.
+//
+// Two-tier cross-platform transport architecture:
+// 1. Hardware GPU SharedImage path (Primary on Windows, Linux, and macOS):
+//    Registers as a TextureVirtualDevice backed by either an internal 3-slot
+//    SharedImage pool (NV12 / BGRA8 / RGBA8 / P010) or an LRU cache of
+//    zero-copy imported OS GPU surfaces (DXGI NT HANDLE, Linux DMA-BUF fd,
+//    macOS IOSurface).
+// 2. Pre-Reserved SharedMemory path (Automatic Fallback for CPU PushFrame):
+//    Whenever GPU compositing is disabled, software-rendered (SwiftShader /
+//    WARP / llvmpipe), or the GPU channel is lost, CPU PushFrame() seamlessly
+//    falls back to a SharedMemoryVirtualDevice with pre-reserved Mojo slots and
+//    AVX2/SSE2/ARM64-NEON non-temporal writes.
+//
+// Threading:
+// - Create(), PushFrame(), PushGpuFrame() and Shutdown() may be called on any
+//   thread.
+// - All Mojo and SharedImage lifetime state lives on |task_runner_|.
+// - The object is ref-counted and always deleted on |task_runner_|.
+class ExternalVideoSource
+    : public base::RefCountedDeleteOnSequence<ExternalVideoSource>,
+      public video_capture::mojom::Producer,
+      public video_capture::mojom::VideoFrameAccessHandler {
+ public:
+  enum class SlotPixelFormat {
+    kNV12 = 0,
+    kP010 = 1,
+    kBGRA8 = 2,
+    kRGBA8 = 3,
+  };
+
+  // Returns nullptr if the arguments are invalid or CEF is not initialized.
+  static scoped_refptr<ExternalVideoSource> Create(const std::string& device_id,
+                                                   const std::string& label,
+                                                   const gfx::Size& max_size,
+                                                   float max_fps);
+
+  ExternalVideoSource(const ExternalVideoSource&) = delete;
+  ExternalVideoSource& operator=(const ExternalVideoSource&) = delete;
+
+  // Streams a CPU YUV 4:2:0 frame into an idle GPU texture slot or pre-reserved
+  // shared memory slot. Drops in O(1) at entry when all downstream slots are
+  // busy. Returns false only if arguments are invalid or the source is shut
+  // down.
+  bool PushFrame(const uint8_t* y,
+                 int y_stride,
+                 const uint8_t* u,
+                 int u_stride,
+                 const uint8_t* v,
+                 int v_stride,
+                 int width,
+                 int height,
+                 int64_t timestamp_us,
+                 const gfx::ColorSpace& color_space);
+
+  // Pushes an OS-shared GPU surface (Windows D3D11 shared handle, Linux
+  // DMA-BUF, macOS IOSurface). In copy-on-push mode (release_callback == NULL),
+  // copies into an internal GPU texture slot before returning; in zero-copy
+  // borrow mode (release_callback != NULL), guarantees release_callback is
+  // invoked exactly once whenever this method returns true.
+  bool PushGpuFrame(const cef_external_video_gpu_frame_t& frame);
+
+  // Unregisters the device. Further PushFrame() / PushGpuFrame() calls are
+  // rejected.
+  void Shutdown();
+
+  // video_capture::mojom::Producer implementation (|task_runner_| only).
+  void OnNewBuffer(int32_t buffer_id,
+                   media::mojom::VideoBufferHandlePtr buffer_handle,
+                   OnNewBufferCallback callback) override;
+  void OnBufferRetired(int32_t buffer_id) override;
+
+  // video_capture::mojom::VideoFrameAccessHandler (|task_runner_| only).
+  void OnFinishedConsumingBuffer(int32_t buffer_id) override;
+
+ private:
+  friend class base::RefCountedDeleteOnSequence<ExternalVideoSource>;
+  friend class base::DeleteHelper<ExternalVideoSource>;
+
+  enum class BackendMode {
+    kPendingInit,
+    kTexture,
+    kSharedMemory,
+  };
+
+  class ScopedGpuReleaseRunner;
+  struct SharedBufferSlot;
+  struct TextureSlot;
+  struct ColdStartGpuFrame;
+  struct ImportedGpuPayload;
+  struct ImportedCacheKey;
+#if BUILDFLAG(IS_WIN)
+  class SharedD3D12CopyUploader;
+#endif
+
+  ExternalVideoSource(scoped_refptr<base::SequencedTaskRunner> task_runner,
+                      const media::VideoCaptureDeviceInfo& device_info,
+                      float max_fps);
+  ~ExternalVideoSource() override;
+
+  // Browser UI thread bootstrap helpers.
+  static void BootstrapOnUIThread(scoped_refptr<ExternalVideoSource> source);
+  static void OnGpuChannelEstablishedOnUIThread(
+      scoped_refptr<ExternalVideoSource> source,
+      mojo::PendingRemote<video_capture::mojom::VideoSourceProvider> provider,
+      scoped_refptr<gpu::GpuChannelHost> gpu_channel);
+
+  // |task_runner_| methods.
+  void InitOnSequence(
+      mojo::PendingRemote<video_capture::mojom::VideoSourceProvider> provider,
+      scoped_refptr<gpu::GpuChannelHost> gpu_channel,
+      gpu::GpuMemoryBufferManager* gmb_manager);
+  bool TryInitTextureBackendOnSequence(
+      scoped_refptr<gpu::GpuChannelHost> gpu_channel,
+      gpu::GpuMemoryBufferManager* gmb_manager);
+  void InitSharedMemoryBackendOnSequence(const char* fallback_reason);
+  void FallbackToSharedMemoryOnSequence(const char* reason);
+
+  // Hardware texture backend (|task_runner_| only).
+  void EnsureTexturePoolOnSequence();
+  void ReclaimStaleTextureSlotsOnSequence();
+  scoped_refptr<TextureSlot> CreateTextureSlotOnSequence(
+      int32_t buffer_id,
+      const gfx::Size& coded_size,
+      SlotPixelFormat slot_format,
+      const gfx::ColorSpace& color_space);
+  bool RegisterSlotMailboxesOnSequence(const TextureSlot& slot,
+                                       const gpu::SyncToken& sync_token);
+  void DestroySlotSharedImagesOnSequence(const TextureSlot& slot);
+  void ReleaseAllTextureResourcesOnSequence(bool retire_on_device);
+  void SubmitTextureFrameOnSequence(int32_t buffer_id,
+                                    SlotPixelFormat slot_format,
+                                    gfx::Size coded_size,
+                                    gfx::Rect visible_rect,
+                                    int64_t timestamp_us,
+                                    base::TimeTicks reference_time,
+                                    gfx::ColorSpace color_space);
+  void SubmitImportedGpuFrameOnSequence(
+      std::unique_ptr<ImportedGpuPayload> payload);
+  void EvictIdleImportedSlotsIfNeededOnSequence();
+  void HandleTextureUploadFailureOnSequence(int32_t buffer_id,
+                                            const char* reason);
+  void ReturnTransientDroppedSlot(int32_t buffer_id);
+  bool HasStaleInFlightSlotLocked(base::TimeTicks now) const
+      EXCLUSIVE_LOCKS_REQUIRED(lock_);
+
+  // Pre-reserved shared-memory fallback backend (|task_runner_| only).
+  void ReserveBufferOnSequence();
+  void OnBufferReserved(gfx::Size requested_coded_size, int32_t buffer_id);
+  void SubmitShmemFrameOnSequence(int32_t buffer_id,
+                                  gfx::Size coded_size,
+                                  gfx::Rect visible_rect,
+                                  int64_t timestamp_us,
+                                  base::TimeTicks reference_time,
+                                  gfx::ColorSpace color_space);
+
+  void ShutdownOnSequence();
+  void OnProviderError();
+  void OnTextureDeviceError();
+  void OnShmemDeviceError();
+
+  // Immutable after construction.
+  const scoped_refptr<base::SequencedTaskRunner> task_runner_;
+  const media::VideoCaptureDeviceInfo device_info_;
+  const gfx::Size max_size_;
+  const float max_fps_;
+
+  // Shared between PushFrame()/PushGpuFrame() thread(s) and |task_runner_|.
+  base::Lock lock_;
+  BackendMode mode_ GUARDED_BY(lock_) = BackendMode::kPendingInit;
+  gfx::Size desired_coded_size_ GUARDED_BY(lock_);
+  SlotPixelFormat desired_pool_format_ GUARDED_BY(lock_) =
+      SlotPixelFormat::kNV12;
+  gfx::ColorSpace desired_color_space_ GUARDED_BY(lock_);
+  // Used only once before the initial pool or shared-memory buffer is ready so
+  // a single still frame pushed immediately after creation is preserved.
+  scoped_refptr<media::VideoFrame> cold_start_frame_ GUARDED_BY(lock_);
+  std::unique_ptr<ColdStartGpuFrame> cold_start_gpu_frame_ GUARDED_BY(lock_);
+  bool has_completed_initial_setup_ GUARDED_BY(lock_) = false;
+  bool device_ready_ GUARDED_BY(lock_) = false;
+  bool shut_down_ GUARDED_BY(lock_) = false;
+
+  // Texture mode shared state (guarded by |lock_|).
+  gfx::Size texture_pool_coded_size_ GUARDED_BY(lock_);
+  SlotPixelFormat texture_pool_format_ GUARDED_BY(lock_) =
+      SlotPixelFormat::kNV12;
+  std::deque<scoped_refptr<TextureSlot>> free_texture_slots_ GUARDED_BY(lock_);
+  std::map<int32_t, scoped_refptr<TextureSlot>> in_flight_texture_slots_
+      GUARDED_BY(lock_);
+  uint64_t next_submit_seq_ GUARDED_BY(lock_) = 0;
+  uint64_t last_completed_seq_ GUARDED_BY(lock_) = 0;
+  bool texture_alloc_in_flight_ GUARDED_BY(lock_) = false;
+  bool reclaim_in_flight_ GUARDED_BY(lock_) = false;
+#if BUILDFLAG(IS_WIN)
+  // Accessed by PushGpuFrame() under |lock_| (or snapshot) so D3D11 shared
+  // textures can be opened and copied in VRAM synchronously before returning.
+  scoped_refptr<SharedD3D12CopyUploader> d3d12_uploader_shared_
+      GUARDED_BY(lock_);
+#endif
+
+  // SharedMemory fallback shared state (guarded by |lock_|).
+  std::map<int32_t, scoped_refptr<SharedBufferSlot>> shmem_buffers_
+      GUARDED_BY(lock_);
+  std::deque<std::pair<scoped_refptr<SharedBufferSlot>, gfx::Size>>
+      reserved_slots_ GUARDED_BY(lock_);
+  bool reserve_in_flight_ GUARDED_BY(lock_) = false;
+  int consecutive_empty_reserves_ GUARDED_BY(lock_) = 0;
+
+  // |task_runner_| only.
+  mojo::Remote<video_capture::mojom::VideoSourceProvider> provider_;
+  bool logged_shmem_fallback_ = false;
+
+  // Texture mode sequence-only members.
+  mojo::Remote<video_capture::mojom::TextureVirtualDevice> texture_device_;
+  mojo::Receiver<video_capture::mojom::VideoFrameAccessHandler>
+      access_handler_receiver_{this};
+  scoped_refptr<gpu::GpuChannelHost> gpu_channel_;
+  std::unique_ptr<gpu::ClientSharedImageInterface> sii_;
+  raw_ptr<gpu::GpuMemoryBufferManager> gmb_manager_ = nullptr;
+  std::set<int32_t> registered_texture_buffer_ids_;
+  std::list<scoped_refptr<TextureSlot>> imported_lru_slots_;
+  int32_t next_texture_buffer_id_ = 1;
+#if BUILDFLAG(IS_WIN)
+  scoped_refptr<SharedD3D12CopyUploader> d3d12_uploader_;
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+  bool linux_use_scanout_gmb_ = false;
+#endif
+
+  // SharedMemory mode sequence-only members.
+  mojo::Remote<video_capture::mojom::SharedMemoryVirtualDevice> shmem_device_;
+  mojo::Receiver<video_capture::mojom::Producer> producer_receiver_{this};
+  bool shmem_ipc_in_flight_ = false;
+};
+
+}  // namespace cef_external_video
+
+#endif  // CEF_LIBCEF_BROWSER_EXTERNAL_VIDEO_SOURCE_H_
