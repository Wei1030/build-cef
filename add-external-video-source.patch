+
+class ExternalVideoSource::ScopedGpuReleaseRunner {
+ public:
+  ScopedGpuReleaseRunner() = default;
+  ScopedGpuReleaseRunner(cef_external_video_release_cb cb, void* ctx)
+      : cb_(cb), ctx_(ctx) {}
+
+  ScopedGpuReleaseRunner(ScopedGpuReleaseRunner&& other) noexcept
+      : cb_(other.cb_), ctx_(other.ctx_) {
+    other.cb_ = nullptr;
+    other.ctx_ = nullptr;
+  }
+
+  ScopedGpuReleaseRunner& operator=(ScopedGpuReleaseRunner&& other) noexcept {
+    if (this != &other) {
+      RunNow();
+      cb_ = other.cb_;
+      ctx_ = other.ctx_;
+      other.cb_ = nullptr;
+      other.ctx_ = nullptr;
+    }
+    return *this;
+  }
+
+  ScopedGpuReleaseRunner(const ScopedGpuReleaseRunner&) = delete;
+  ScopedGpuReleaseRunner& operator=(const ScopedGpuReleaseRunner&) = delete;
+
+  ~ScopedGpuReleaseRunner() { RunNow(); }
+
+  bool HasCallback() const { return cb_ != nullptr; }
+
+  void RunNow() {
+    if (cb_) {
+      cef_external_video_release_cb fn = cb_;
+      void* arg = ctx_;
+      cb_ = nullptr;
+      ctx_ = nullptr;
+      fn(arg);
+    }
+  }
+
+  void Disarm() {
+    cb_ = nullptr;
+    ctx_ = nullptr;
+  }
+
+ private:
+  cef_external_video_release_cb cb_ = nullptr;
+  void* ctx_ = nullptr;
+};
