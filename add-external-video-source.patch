+
+namespace cef_external_video {
+
+namespace {
+
+constexpr int kMaxEmptyReserveRetries = 6;
+constexpr base::TimeDelta kEmptyReserveRetryDelay = base::Milliseconds(2);
+
+void ConnectToVideoSourceProviderOnUIThread(
+    mojo::PendingReceiver<video_capture::mojom::VideoSourceProvider>
+        receiver) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  content::GetVideoCaptureService().ConnectToVideoSourceProvider(
+      std::move(receiver));
+}
+
+// ---------------------------------------------------------------------------
+// Cross-platform non-temporal streaming plane copy (x86 SSE2/AVX2 + ARM64).
+// Bypasses CPU cache write-allocation (RFO) when writing write-once shared
+// memory frames, saving ~50% destination DRAM traffic and preserving L3 cache.
+// ---------------------------------------------------------------------------
+
+#if defined(ARCH_CPU_X86_FAMILY) && !BUILDFLAG(IS_NACL)
+
+__attribute__((target("avx2"))) void StreamCopyBytes_AVX2(const uint8_t* src,
+                                                          uint8_t* dst,
+                                                          size_t count) {
+  if (count < 64) {
+    std::memcpy(dst, src, count);
+    return;
+  }
+
+  const uintptr_t misalign = reinterpret_cast<uintptr_t>(dst) & 31u;
+  if (misalign != 0) {
+    const size_t peel = 32u - misalign;
+    std::memcpy(dst, src, peel);
+    src += peel;
+    dst += peel;
+    count -= peel;
+  }
+
+  while (count >= 64) {
+    const __m256i v0 =
+        _mm256_loadu_si256(reinterpret_cast<const __m256i*>(src));
+    const __m256i v1 =
+        _mm256_loadu_si256(reinterpret_cast<const __m256i*>(src + 32));
+    _mm256_stream_si256(reinterpret_cast<__m256i*>(dst), v0);
+    _mm256_stream_si256(reinterpret_cast<__m256i*>(dst + 32), v1);
+    src += 64;
+    dst += 64;
+    count -= 64;
+  }
+
+  if (count > 0) {
+    std::memcpy(dst, src, count);
+  }
+}
+
+void StreamCopyBytes_SSE2(const uint8_t* src, uint8_t* dst, size_t count) {
+  if (count < 64) {
+    std::memcpy(dst, src, count);
+    return;
+  }
+
+  const uintptr_t misalign = reinterpret_cast<uintptr_t>(dst) & 15u;
+  if (misalign != 0) {
+    const size_t peel = 16u - misalign;
+    std::memcpy(dst, src, peel);
+    src += peel;
+    dst += peel;
+    count -= peel;
+  }
+
+  while (count >= 64) {
+    const __m128i v0 = _mm_loadu_si128(reinterpret_cast<const __m128i*>(src));
+    const __m128i v1 =
+        _mm_loadu_si128(reinterpret_cast<const __m128i*>(src + 16));
+    const __m128i v2 =
+        _mm_loadu_si128(reinterpret_cast<const __m128i*>(src + 32));
+    const __m128i v3 =
+        _mm_loadu_si128(reinterpret_cast<const __m128i*>(src + 48));
+    _mm_stream_si128(reinterpret_cast<__m128i*>(dst), v0);
+    _mm_stream_si128(reinterpret_cast<__m128i*>(dst + 16), v1);
+    _mm_stream_si128(reinterpret_cast<__m128i*>(dst + 32), v2);
+    _mm_stream_si128(reinterpret_cast<__m128i*>(dst + 48), v3);
+    src += 64;
+    dst += 64;
+    count -= 64;
+  }
+
+  if (count > 0) {
+    std::memcpy(dst, src, count);
+  }
+}
+
+inline void StreamCopyBytes(const uint8_t* src, uint8_t* dst, size_t count) {
+  static const bool kHasAvx2 =
+      base::CPU::GetInstanceNoAllocation().has_avx2();
+  if (kHasAvx2) {
+    StreamCopyBytes_AVX2(src, dst, count);
+  } else {
+    StreamCopyBytes_SSE2(src, dst, count);
+  }
+}
+
+inline void StreamStoreFence() {
+  _mm_sfence();
+}
+
+#elif defined(ARCH_CPU_ARM64)
+
+void StreamCopyBytes(const uint8_t* src, uint8_t* dst, size_t count) {
+  if (count < 64) {
+    std::memcpy(dst, src, count);
+    return;
+  }
+
+  const uintptr_t misalign = reinterpret_cast<uintptr_t>(dst) & 15u;
+  if (misalign != 0) {
+    const size_t peel = 16u - misalign;
+    std::memcpy(dst, src, peel);
+    src += peel;
+    dst += peel;
+    count -= peel;
+  }
+
+  // Clang lowers consecutive 16-byte __builtin_nontemporal_store calls on
+  // AArch64 to native `stnp q0, q1, [dst]` non-temporal pair instructions.
+  using Vec16B = uint64_t __attribute__((vector_size(16)));
+  while (count >= 64) {
+    Vec16B v0, v1, v2, v3;
+    std::memcpy(&v0, src, 16);
+    std::memcpy(&v1, src + 16, 16);
+    std::memcpy(&v2, src + 32, 16);
+    std::memcpy(&v3, src + 48, 16);
+    auto* d = reinterpret_cast<Vec16B*>(dst);
+    __builtin_nontemporal_store(v0, d);
+    __builtin_nontemporal_store(v1, d + 1);
+    __builtin_nontemporal_store(v2, d + 2);
+    __builtin_nontemporal_store(v3, d + 3);
+    src += 64;
+    dst += 64;
+    count -= 64;
+  }
+
+  if (count > 0) {
+    std::memcpy(dst, src, count);
+  }
+}
+
+inline void StreamStoreFence() {
+  __asm__ __volatile__("dmb ishst" ::: "memory");
+}
+
+#else
+
+inline void StreamCopyBytes(const uint8_t* src, uint8_t* dst, size_t count) {
+  std::memcpy(dst, src, count);
+}
+
+inline void StreamStoreFence() {}
+
+#endif
+
+void StreamCopyPlane(const uint8_t* src,
+                     int src_stride,
+                     uint8_t* dst,
+                     int dst_stride,
+                     int visible_width,
+                     int visible_height,
+                     int coded_height) {
+  if (visible_width <= 0 || visible_height <= 0) {
+    return;
+  }
+
+  if (src_stride == visible_width && dst_stride == visible_width) {
+    StreamCopyBytes(src, dst,
+                    static_cast<size_t>(visible_width) * visible_height);
+  } else {
+    for (int row = 0; row < visible_height; ++row) {
+      uint8_t* dst_row = dst + static_cast<size_t>(row) * dst_stride;
+      StreamCopyBytes(src + static_cast<size_t>(row) * src_stride, dst_row,
+                      static_cast<size_t>(visible_width));
+      if (dst_stride > visible_width) {
+        std::memset(dst_row + visible_width, dst_row[visible_width - 1],
+                    static_cast<size_t>(dst_stride - visible_width));
+      }
+    }
+  }
+
+  // Replicate bottom row if odd height was padded up to even coded_height.
+  if (coded_height > visible_height) {
+    const uint8_t* last_row =
+        dst + static_cast<size_t>(visible_height - 1) * dst_stride;
+    for (int row = visible_height; row < coded_height; ++row) {
+      std::memcpy(dst + static_cast<size_t>(row) * dst_stride, last_row,
+                  static_cast<size_t>(dst_stride));
+    }
+  }
+}
+
+void StreamCopyI420ToMapping(const uint8_t* y,
+                             int y_stride,
+                             const uint8_t* u,
+                             int u_stride,
+                             const uint8_t* v,
+                             int v_stride,
+                             int width,
+                             int height,
+                             const gfx::Size& coded_size,
+                             uint8_t* dst_base) {
+  const int cw = coded_size.width();
+  const int ch = coded_size.height();
+  const int half_coded_w = cw / 2;
+  const int half_coded_h = ch / 2;
+  const int chroma_vis_w = (width + 1) / 2;
+  const int chroma_vis_h = (height + 1) / 2;
+
+  uint8_t* dst_y = dst_base;
+  uint8_t* dst_u = dst_y + static_cast<size_t>(cw) * ch;
+  uint8_t* dst_v = dst_u + static_cast<size_t>(half_coded_w) * half_coded_h;
+
+  StreamCopyPlane(y, y_stride, dst_y, cw, width, height, ch);
+  StreamCopyPlane(u, u_stride, dst_u, half_coded_w, chroma_vis_w, chroma_vis_h,
+                  half_coded_h);
+  StreamCopyPlane(v, v_stride, dst_v, half_coded_w, chroma_vis_w, chroma_vis_h,
+                  half_coded_h);
+  StreamStoreFence();
+}
