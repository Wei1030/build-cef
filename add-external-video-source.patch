+
+// static
+scoped_refptr<ExternalVideoSource> ExternalVideoSource::Create(
+    const std::string& device_id,
+    const std::string& label,
+    const gfx::Size& max_size,
+    float max_fps) {
+  if (!CONTEXT_STATE_VALID()) {
+    LOG(ERROR) << "cef_external_video: CEF is not initialized";
+    return nullptr;
+  }
+  const media::VideoCaptureFormat format(max_size, max_fps,
+                                         media::PIXEL_FORMAT_I420);
+  if (device_id.empty() || max_size.IsEmpty() || !(max_fps > 0.f) ||
+      !format.IsValid()) {
+    LOG(ERROR) << "cef_external_video: invalid arguments";
+    return nullptr;
+  }
+
+  media::VideoCaptureDeviceInfo device_info(media::VideoCaptureDeviceDescriptor(
+      label.empty() ? device_id : label, device_id,
+      media::VideoCaptureApi::VIRTUAL_DEVICE));
+  device_info.supported_formats.push_back(format);
+
+  scoped_refptr<base::SequencedTaskRunner> task_runner =
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::TaskPriority::USER_BLOCKING, base::WithBaseSyncPrimitives(),
+           base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN});
+
+  scoped_refptr<ExternalVideoSource> source(
+      new ExternalVideoSource(task_runner, device_info, max_fps));
+
+  content::GetUIThreadTaskRunner({})->PostTask(
+      FROM_HERE, base::BindOnce(&ExternalVideoSource::BootstrapOnUIThread,
+                                source));
+  return source;
+}
+
+ExternalVideoSource::ExternalVideoSource(
+    scoped_refptr<base::SequencedTaskRunner> task_runner,
+    const media::VideoCaptureDeviceInfo& device_info,
+    float max_fps)
+    : base::RefCountedDeleteOnSequence<ExternalVideoSource>(task_runner),
+      task_runner_(std::move(task_runner)),
+      device_info_(device_info),
+      max_size_(device_info.supported_formats[0].frame_size),
+      max_fps_(max_fps) {}
+
+ExternalVideoSource::~ExternalVideoSource() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  ShutdownOnSequence();
+}
+
+// static
+void ExternalVideoSource::BootstrapOnUIThread(
+    scoped_refptr<ExternalVideoSource> source) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+
+  mojo::PendingRemote<video_capture::mojom::VideoSourceProvider> provider;
+  content::GetVideoCaptureService().ConnectToVideoSourceProvider(
+      provider.InitWithNewPipeAndPassReceiver());
+
+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || \
+    BUILDFLAG(IS_MAC)
+  auto* gpu_data_mgr = content::GpuDataManagerImpl::GetInstance();
+  auto* gpu_factory = content::BrowserGpuChannelHostFactory::instance();
+  if (gpu_data_mgr && gpu_factory &&
+      gpu_data_mgr->HardwareAccelerationEnabled() &&
+      !gpu_data_mgr->IsGpuCompositingDisabled()) {
+    gpu_factory->EstablishGpuChannel(base::BindOnce(
+        &ExternalVideoSource::OnGpuChannelEstablishedOnUIThread,
+        std::move(source), std::move(provider)));
+    return;
+  }
+#endif
+
+  source->task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(&ExternalVideoSource::InitOnSequence, source,
+                     std::move(provider), nullptr, nullptr));
+}
+
+// static
+void ExternalVideoSource::OnGpuChannelEstablishedOnUIThread(
+    scoped_refptr<ExternalVideoSource> source,
+    mojo::PendingRemote<video_capture::mojom::VideoSourceProvider> provider,
+    scoped_refptr<gpu::GpuChannelHost> gpu_channel) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+
+  auto* gpu_data_mgr = content::GpuDataManagerImpl::GetInstance();
+  auto* gpu_factory = content::BrowserGpuChannelHostFactory::instance();
+  gpu::GpuMemoryBufferManager* gmb_manager =
+      gpu_factory ? gpu_factory->GetGpuMemoryBufferManager() : nullptr;
+
+  if (!gpu_channel || gpu_channel->IsLost() || !gpu_data_mgr ||
+      !gpu_data_mgr->HardwareAccelerationEnabled() ||
+      gpu_data_mgr->IsGpuCompositingDisabled()) {
+    gpu_channel = nullptr;
+    gmb_manager = nullptr;
+  }
+
+  source->task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(&ExternalVideoSource::InitOnSequence, source,
+                     std::move(provider), std::move(gpu_channel), gmb_manager));
+}
+
+bool ExternalVideoSource::PushFrame(const uint8_t* y,
+                                    int y_stride,
+                                    const uint8_t* u,
+                                    int u_stride,
+                                    const uint8_t* v,
+                                    int v_stride,
+                                    int width,
+                                    int height,
+                                    int64_t timestamp_us,
+                                    const gfx::ColorSpace& color_space) {
+  const int chroma_width = (width + 1) / 2;
+  if (!y || !u || !v || width <= 0 || height <= 0 ||
+      width > max_size_.width() || height > max_size_.height() ||
+      y_stride < width || u_stride < chroma_width ||
+      v_stride < chroma_width) {
+    return false;
+  }
+
+  const gfx::Size coded_size((width + 1) & ~1, (height + 1) & ~1);
+  const base::TimeTicks now_ticks = base::TimeTicks::Now();
+  scoped_refptr<TextureSlot> tex_slot;
+  scoped_refptr<SharedBufferSlot> shmem_slot;
+  gfx::Size shmem_slot_coded_size;
+  bool need_cold_start_copy = false;
+  bool post_texture_alloc = false;
+  bool post_reclaim_stale = false;
+  bool drop_after_lock = false;
+  bool post_shmem_reserve = false;
+
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_) {
+      return false;
+    }
+
+    if (mode_ == BackendMode::kTexture &&
+        (coded_size.width() > kMaxHardwareTextureDimension ||
+         coded_size.height() > kMaxHardwareTextureDimension)) {
+      return false;
+    }
+
+    desired_coded_size_ = coded_size;
+    desired_pool_format_ = SlotPixelFormat::kNV12;
+    desired_color_space_ = color_space;
+
+    switch (mode_) {
+      case BackendMode::kPendingInit: {
+        if (!cold_start_frame_ ||
+            cold_start_frame_->coded_size() != coded_size) {
+          need_cold_start_copy = true;
+        }
+        break;
+      }
+
+      case BackendMode::kTexture: {
+        if (texture_pool_coded_size_ == coded_size &&
+            texture_pool_format_ == SlotPixelFormat::kNV12) {
+          if (device_ready_ && !texture_alloc_in_flight_ &&
+              !reclaim_in_flight_ && HasStaleInFlightSlotLocked(now_ticks)) {
+            reclaim_in_flight_ = true;
+            post_reclaim_stale = true;
+          }
+          if (!free_texture_slots_.empty()) {
+            tex_slot = std::move(free_texture_slots_.front());
+            free_texture_slots_.pop_front();
+            tex_slot->submit_seq = ++next_submit_seq_;
+            tex_slot->in_flight_since = now_ticks;
+            tex_slot->dma_in_progress = true;
+            in_flight_texture_slots_[tex_slot->buffer_id] = tex_slot;
+          } else {
+            drop_after_lock = true;
+          }
+        } else {
+          if (!has_completed_initial_setup_ &&
+              (!cold_start_frame_ ||
+               cold_start_frame_->coded_size() != coded_size)) {
+            need_cold_start_copy = true;
+          }
+          if (device_ready_ && !texture_alloc_in_flight_) {
+            texture_alloc_in_flight_ = true;
+            post_texture_alloc = true;
+          }
+          if (!need_cold_start_copy && !post_texture_alloc) {
+            return true;
+          }
+        }
+        break;
+      }
+
+      case BackendMode::kSharedMemory: {
+        if (!reserved_slots_.empty()) {
+          shmem_slot = std::move(reserved_slots_.front().first);
+          shmem_slot_coded_size = reserved_slots_.front().second;
+          reserved_slots_.pop_front();
+          consecutive_empty_reserves_ = 0;
+        } else if (!has_completed_initial_setup_) {
+          if (!cold_start_frame_ ||
+              cold_start_frame_->coded_size() != coded_size) {
+            need_cold_start_copy = true;
+          }
+          if (device_ready_ && !reserve_in_flight_) {
+            reserve_in_flight_ = true;
+            post_shmem_reserve = true;
+          }
+        } else {
+          if (device_ready_ && !reserve_in_flight_) {
+            reserve_in_flight_ = true;
+            consecutive_empty_reserves_ = 0;
+            post_shmem_reserve = true;
+          }
+          if (!post_shmem_reserve) {
+            return true;
+          }
+        }
+        break;
+      }
+    }
+  }
+
+  if (post_reclaim_stale) {
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ExternalVideoSource::ReclaimStaleTextureSlotsOnSequence,
+                       base::WrapRefCounted(this)));
+  }
+  if (drop_after_lock) {
+    return true;
+  }
+
+  if (tex_slot) {
+    const gfx::Rect visible_rect(width, height);
+#if BUILDFLAG(IS_WIN)
+    const int32_t buf_id = tex_slot->buffer_id;
+    const gfx::Size slot_size = tex_slot->coded_size;
+    scoped_refptr<ExternalVideoSource> self = base::WrapRefCounted(this);
+    auto on_dma_done = base::BindOnce(
+        [](scoped_refptr<ExternalVideoSource> src, int32_t id, gfx::Size sz,
+           gfx::Rect vis_rect, int64_t ts_us, base::TimeTicks rt,
+           gfx::ColorSpace cs, bool ok) {
+          if (ok) {
+            src->task_runner_->PostTask(
+                FROM_HERE,
+                base::BindOnce(
+                    &ExternalVideoSource::SubmitTextureFrameOnSequence, src, id,
+                    SlotPixelFormat::kNV12, sz, vis_rect, ts_us, rt, cs));
+          } else {
+            src->task_runner_->PostTask(
+                FROM_HERE,
+                base::BindOnce(
+                    &ExternalVideoSource::HandleTextureUploadFailureOnSequence,
+                    src, id, "D3D12 copy queue fence failed"));
+          }
+        },
+        self, buf_id, slot_size, visible_rect, timestamp_us, now_ticks,
+        color_space);
+
+    const auto status =
+        tex_slot->uploader
+            ? tex_slot->uploader->SubmitAsyncUploadNV12(
+                  tex_slot->d3d12_resource, tex_slot->footprints,
+                  tex_slot->upload_total_bytes, slot_size, y, y_stride, u,
+                  u_stride, v, v_stride, width, height, std::move(on_dma_done))
+            : SharedD3D12CopyUploader::UploadStatus::kFatalError;
+
+    if (status == SharedD3D12CopyUploader::UploadStatus::kTransientDrop) {
+      ReturnTransientDroppedSlot(buf_id);
+    } else if (status == SharedD3D12CopyUploader::UploadStatus::kFatalError) {
+      task_runner_->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              &ExternalVideoSource::HandleTextureUploadFailureOnSequence,
+              base::WrapRefCounted(this), buf_id,
+              "D3D12 async NV12 upload device failure"));
+    }
+    return true;
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+    bool ok = false;
+    if (tex_slot->gmb && tex_slot->gmb->Map()) {
+      uint8_t* dst_y = static_cast<uint8_t*>(tex_slot->gmb->memory(0));
+      uint8_t* dst_uv = static_cast<uint8_t*>(tex_slot->gmb->memory(1));
+      if (dst_y && dst_uv) {
+        StreamCopyI420ToNV12Planes(
+            y, y_stride, u, u_stride, v, v_stride, width, height,
+            tex_slot->coded_size, dst_y, tex_slot->gmb->stride(0), dst_uv,
+            tex_slot->gmb->stride(1));
+        ok = true;
+      }
+      tex_slot->gmb->Unmap();
+    }
+    if (!ok) {
+      task_runner_->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              &ExternalVideoSource::HandleTextureUploadFailureOnSequence,
+              base::WrapRefCounted(this), tex_slot->buffer_id,
+              "Linux NativePixmap DMA-BUF Map failed"));
+      return true;
+    }
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ExternalVideoSource::SubmitTextureFrameOnSequence,
+                       base::WrapRefCounted(this), tex_slot->buffer_id,
+                       SlotPixelFormat::kNV12, tex_slot->coded_size,
+                       visible_rect, timestamp_us, now_ticks, color_space));
+    return true;
+#elif BUILDFLAG(IS_MAC)
+    bool ok = false;
+    if (tex_slot->io_surface &&
+        IOSurfaceLock(tex_slot->io_surface, 0, nullptr) == kIOReturnSuccess) {
+      uint8_t* dst_y = static_cast<uint8_t*>(
+          IOSurfaceGetBaseAddressOfPlane(tex_slot->io_surface, 0));
+      uint8_t* dst_uv = static_cast<uint8_t*>(
+          IOSurfaceGetBaseAddressOfPlane(tex_slot->io_surface, 1));
+      const int stride_y = static_cast<int>(
+          IOSurfaceGetBytesPerRowOfPlane(tex_slot->io_surface, 0));
+      const int stride_uv = static_cast<int>(
+          IOSurfaceGetBytesPerRowOfPlane(tex_slot->io_surface, 1));
+      if (dst_y && dst_uv && stride_y >= tex_slot->coded_size.width() &&
+          stride_uv >= tex_slot->coded_size.width()) {
+        StreamCopyI420ToNV12Planes(y, y_stride, u, u_stride, v, v_stride, width,
+                                   height, tex_slot->coded_size, dst_y,
+                                   stride_y, dst_uv, stride_uv);
+        ok = true;
+      }
+      IOSurfaceUnlock(tex_slot->io_surface, 0, nullptr);
+    }
+    if (!ok) {
+      task_runner_->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              &ExternalVideoSource::HandleTextureUploadFailureOnSequence,
+              base::WrapRefCounted(this), tex_slot->buffer_id,
+              "macOS IOSurface Lock/copy failed"));
+      return true;
+    }
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ExternalVideoSource::SubmitTextureFrameOnSequence,
+                       base::WrapRefCounted(this), tex_slot->buffer_id,
+                       SlotPixelFormat::kNV12, tex_slot->coded_size,
+                       visible_rect, timestamp_us, now_ticks, color_space));
+    return true;
+#else
+    return false;
+#endif
+  }
+
+  if (shmem_slot) {
+    if (!shmem_slot->mapping.IsValid()) {
+      return false;
+    }
+    const size_t needed =
+        media::VideoFrame::AllocationSize(media::PIXEL_FORMAT_I420, coded_size);
+    gfx::Size submit_coded = coded_size;
+    gfx::Rect submit_visible(width, height);
+
+    if (shmem_slot->mapping.size() >= needed) {
+      StreamCopyI420ToMapping(
+          y, y_stride, u, u_stride, v, v_stride, width, height, coded_size,
+          static_cast<uint8_t*>(shmem_slot->mapping.memory()));
+    } else if (!shmem_slot_coded_size.IsEmpty() &&
+               shmem_slot->mapping.size() >=
+                   media::VideoFrame::AllocationSize(media::PIXEL_FORMAT_I420,
+                                                     shmem_slot_coded_size)) {
+      const int dw = shmem_slot_coded_size.width();
+      const int dh = shmem_slot_coded_size.height();
+      const int dcw = dw / 2;
+      const int dch = dh / 2;
+      uint8_t* dst_y = static_cast<uint8_t*>(shmem_slot->mapping.memory());
+      uint8_t* dst_u = dst_y + static_cast<size_t>(dw) * dh;
+      uint8_t* dst_v = dst_u + static_cast<size_t>(dcw) * dch;
+      libyuv::I420Scale(y, y_stride, u, u_stride, v, v_stride, width, height,
+                        dst_y, dw, dst_u, dcw, dst_v, dcw, dw, dh,
+                        libyuv::kFilterBilinear);
+      submit_coded = shmem_slot_coded_size;
+      submit_visible = gfx::Rect(dw, dh);
+    } else {
+      return false;
+    }
+
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ExternalVideoSource::SubmitShmemFrameOnSequence,
+                       base::WrapRefCounted(this), shmem_slot->buffer_id,
+                       submit_coded, submit_visible, timestamp_us, now_ticks,
+                       color_space));
+    return true;
+  }
+
+  if (need_cold_start_copy) {
+    scoped_refptr<media::VideoFrame> frame = media::VideoFrame::CreateFrame(
+        media::PIXEL_FORMAT_I420, coded_size, gfx::Rect(width, height),
+        gfx::Size(width, height), base::Microseconds(timestamp_us));
+    if (frame) {
+      libyuv::I420Copy(y, y_stride, u, u_stride, v, v_stride,
+                       frame->writable_data(media::VideoFrame::kYPlane),
+                       frame->stride(media::VideoFrame::kYPlane),
+                       frame->writable_data(media::VideoFrame::kUPlane),
+                       frame->stride(media::VideoFrame::kUPlane),
+                       frame->writable_data(media::VideoFrame::kVPlane),
+                       frame->stride(media::VideoFrame::kVPlane), width, height);
+      frame->metadata().reference_time = now_ticks;
+      frame->set_color_space(color_space);
+
+      base::AutoLock lock(lock_);
+      if (shut_down_) {
+        return false;
+      }
+      if (!has_completed_initial_setup_) {
+        cold_start_frame_ = std::move(frame);
+        cold_start_gpu_frame_.reset();
+      }
+      if (device_ready_) {
+        if (mode_ == BackendMode::kTexture && !texture_alloc_in_flight_ &&
+            (texture_pool_coded_size_ != desired_coded_size_ ||
+             texture_pool_format_ != desired_pool_format_)) {
+          texture_alloc_in_flight_ = true;
+          post_texture_alloc = true;
+        } else if (mode_ == BackendMode::kSharedMemory && !reserve_in_flight_ &&
+                   reserved_slots_.size() < kTargetReservedShmemSlots) {
+          reserve_in_flight_ = true;
+          post_shmem_reserve = true;
+        }
+      }
+    }
+  }
+
+  if (post_texture_alloc) {
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ExternalVideoSource::EnsureTexturePoolOnSequence,
+                       base::WrapRefCounted(this)));
+  }
+  if (post_shmem_reserve) {
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ExternalVideoSource::ReserveBufferOnSequence,
+                       base::WrapRefCounted(this)));
+  }
+  return true;
+}
+
+// ---------------------------------------------------------------------------
+// Cross-platform GPU Surface Push (Windows D3D11 / Linux DMA-BUF / macOS IOSurface)
+// ---------------------------------------------------------------------------
+
+bool ExternalVideoSource::PushGpuFrame(
+    const cef_external_video_gpu_frame_t& frame) {
+  if (frame.struct_size < sizeof(cef_external_video_gpu_frame_t)) {
+    return false;
+  }
+
+  const base::TimeTicks now_ticks = base::TimeTicks::Now();
+
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_ || mode_ == BackendMode::kSharedMemory) {
+      return false;
+    }
+  }
+
+#if BUILDFLAG(IS_WIN)
+  if (frame.handle_type != CEF_EXT_GPU_HANDLE_WIN_D3D11 ||
+      !frame.handle.win_d3d11.shared_handle) {
+    return false;
+  }
+
+  scoped_refptr<SharedD3D12CopyUploader> uploader;
+  {
+    base::AutoLock lock(lock_);
+    uploader = d3d12_uploader_shared_;
+  }
+  if (!uploader) {
+    uploader = SharedD3D12CopyUploader::GetOrCreate(QueryCurrentActiveGpuLuid());
+    if (!uploader) {
+      return false;
+    }
+  }
+
+  const HANDLE raw_handle =
+      static_cast<HANDLE>(frame.handle.win_d3d11.shared_handle);
+  Microsoft::WRL::ComPtr<ID3D11Texture2D> src_tex;
+  D3D11_TEXTURE2D_DESC src_desc = {};
+  bool opened_as_nt = false;
+  if (!uploader->OpenExternalSharedTexture(raw_handle,
+                                           frame.handle.win_d3d11.is_nt_handle,
+                                           &src_tex, &src_desc, &opened_as_nt)) {
+    return false;
+  }
+
+  SlotPixelFormat detected_slot_fmt = SlotPixelFormat::kNV12;
+  bool direct_copy_ok = false;
+  if (!SharedD3D12CopyUploader::ClassifyDxgiFormat(
+          src_desc.Format, &detected_slot_fmt, &direct_copy_ok)) {
+    return false;
+  }
+
+  SlotPixelFormat slot_fmt = detected_slot_fmt;
+  if (frame.format != CEF_EXT_GPU_FORMAT_AUTO) {
+    SlotPixelFormat explicit_fmt = SlotPixelFormat::kNV12;
+    if (!FromCefGpuFormat(frame.format, &explicit_fmt)) {
+      return false;
+    }
+    // On Windows Chromium 109, P010 converts on-GPU to NV12 slot.
+    slot_fmt = (explicit_fmt == SlotPixelFormat::kP010) ? SlotPixelFormat::kNV12
+                                                        : explicit_fmt;
+    if (SharedD3D12CopyUploader::ToSlotDxgiFormat(slot_fmt) != src_desc.Format) {
+      direct_copy_ok = false;
+    }
+  }
+
+  const int coded_w = (frame.coded_width == 0)
+                          ? static_cast<int>(src_desc.Width)
+                          : frame.coded_width;
+  const int coded_h = (frame.coded_height == 0)
+                          ? static_cast<int>(src_desc.Height)
+                          : frame.coded_height;
+  if (coded_w != static_cast<int>(src_desc.Width) ||
+      coded_h != static_cast<int>(src_desc.Height)) {
+    return false;
+  }
+  const gfx::Size coded_size(coded_w, coded_h);
+  gfx::Rect visible_rect;
+  if (!ComputeAndValidateVisibleRect(frame, coded_size, max_size_, slot_fmt,
+                                     &visible_rect)) {
+    return false;
+  }
+
+  const gfx::ColorSpace color_space =
+      ResolveGpuFrameColorSpace(frame.color, visible_rect.height(), slot_fmt);
+
+  ScopedGpuReleaseRunner release_runner(frame.release_callback,
+                                        frame.release_ctx);
+
+  // Zero-copy borrow fast path when caller supplies a release callback and an
+  // NT-handle single-slice texture without non-zero KeyedMutex keys.
+  const bool can_zero_copy_nt =
+      release_runner.HasCallback() && opened_as_nt && direct_copy_ok &&
+      src_desc.ArraySize == 1 &&
+      ((src_desc.MiscFlags & D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX) == 0 ||
+       (frame.handle.win_d3d11.keyed_mutex_acq == 0 &&
+        frame.handle.win_d3d11.keyed_mutex_rel == 0));
+
+  if (can_zero_copy_nt) {
+    HANDLE dup_handle = nullptr;
+    if (::DuplicateHandle(::GetCurrentProcess(), raw_handle,
+                          ::GetCurrentProcess(), &dup_handle, 0, FALSE,
+                          DUPLICATE_SAME_ACCESS) &&
+        dup_handle) {
+      auto payload = std::make_unique<ImportedGpuPayload>();
+      payload->slot_format = slot_fmt;
+      payload->coded_size = coded_size;
+      payload->visible_rect = visible_rect;
+      payload->timestamp_us = frame.timestamp_us;
+      payload->reference_time = now_ticks;
+      payload->color_space = color_space;
+      payload->surface_key =
+          frame.surface_key != 0
+              ? frame.surface_key
+              : static_cast<uint64_t>(reinterpret_cast<uintptr_t>(raw_handle));
+      payload->dxgi_nt_handle.Set(dup_handle);
+      payload->release_runner = std::move(release_runner);
+
+      {
+        base::AutoLock lock(lock_);
+        if (shut_down_ || mode_ == BackendMode::kSharedMemory) {
+          payload->release_runner.Disarm();
+          return false;
+        }
+        if (mode_ == BackendMode::kPendingInit) {
+          auto cold = std::make_unique<ColdStartGpuFrame>();
+          cold->imported_payload = std::move(payload);
+          cold_start_gpu_frame_ = std::move(cold);
+          cold_start_frame_ = nullptr;
+          return true;
+        }
+      }
+
+      task_runner_->PostTask(
+          FROM_HERE,
+          base::BindOnce(&ExternalVideoSource::SubmitImportedGpuFrameOnSequence,
+                         base::WrapRefCounted(this), std::move(payload)));
+      return true;
+    }
+  }
+
+  // Copy-on-push in VRAM (default for PlayM4 & legacy MISC_SHARED handles).
+  scoped_refptr<TextureSlot> tex_slot;
+  bool need_cold_vram_copy = false;
+  bool post_texture_alloc = false;
+  bool post_reclaim_stale = false;
+  bool drop_after_lock = false;
+
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_ || mode_ == BackendMode::kSharedMemory) {
+      release_runner.Disarm();
+      return false;
+    }
+
+    desired_coded_size_ = coded_size;
+    desired_pool_format_ = slot_fmt;
+    desired_color_space_ = color_space;
+
+    if (mode_ == BackendMode::kPendingInit) {
+      need_cold_vram_copy = true;
+    } else if (texture_pool_coded_size_ == coded_size &&
+               texture_pool_format_ == slot_fmt) {
+      if (device_ready_ && !texture_alloc_in_flight_ && !reclaim_in_flight_ &&
+          HasStaleInFlightSlotLocked(now_ticks)) {
+        reclaim_in_flight_ = true;
+        post_reclaim_stale = true;
+      }
+      if (!free_texture_slots_.empty()) {
+        tex_slot = std::move(free_texture_slots_.front());
+        free_texture_slots_.pop_front();
+        tex_slot->submit_seq = ++next_submit_seq_;
+        tex_slot->in_flight_since = now_ticks;
+        tex_slot->dma_in_progress = true;
+        in_flight_texture_slots_[tex_slot->buffer_id] = tex_slot;
+      } else {
+        drop_after_lock = true;
+      }
+    } else {
+      if (!has_completed_initial_setup_) {
+        need_cold_vram_copy = true;
+      }
+      if (device_ready_ && !texture_alloc_in_flight_) {
+        texture_alloc_in_flight_ = true;
+        post_texture_alloc = true;
+      }
+    }
+  }
+
+  if (post_reclaim_stale) {
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ExternalVideoSource::ReclaimStaleTextureSlotsOnSequence,
+                       base::WrapRefCounted(this)));
+  }
+
+  if (drop_after_lock) {
+    // Frame accepted & intentionally dropped due to downstream backpressure;
+    // release_runner destructor runs release_callback (if any) right now.
+    return true;
+  }
+
+  if (tex_slot) {
+    const int32_t buf_id = tex_slot->buffer_id;
+    const gfx::Size slot_size = tex_slot->coded_size;
+    const bool wait_until_gpu_done = !release_runner.HasCallback();
+    scoped_refptr<ExternalVideoSource> self = base::WrapRefCounted(this);
+    auto on_copy_done = base::BindOnce(
+        [](scoped_refptr<ExternalVideoSource> src, int32_t id,
+           SlotPixelFormat sfmt, gfx::Size sz, gfx::Rect vis_rect,
+           int64_t ts_us, base::TimeTicks rt, gfx::ColorSpace cs,
+           ScopedGpuReleaseRunner rel, bool ok) mutable {
+          // Source texture copy finished on GPU; release external reference now!
+          rel.RunNow();
+          if (ok) {
+            src->task_runner_->PostTask(
+                FROM_HERE,
+                base::BindOnce(
+                    &ExternalVideoSource::SubmitTextureFrameOnSequence, src, id,
+                    sfmt, sz, vis_rect, ts_us, rt, cs));
+          } else {
+            src->ReturnTransientDroppedSlot(id);
+          }
+        },
+        self, buf_id, slot_fmt, slot_size, visible_rect, frame.timestamp_us,
+        now_ticks, color_space, std::move(release_runner));
+
+    const auto status =
+        tex_slot->uploader
+            ? tex_slot->uploader->SubmitGpuTextureCopy(
+                  src_tex.Get(), src_desc, tex_slot->d3d11_texture, slot_fmt,
+                  direct_copy_ok, frame.handle.win_d3d11.keyed_mutex_acq,
+                  frame.handle.win_d3d11.keyed_mutex_rel, wait_until_gpu_done,
+                  std::move(on_copy_done))
+            : SharedD3D12CopyUploader::UploadStatus::kFatalError;
+    if (status != SharedD3D12CopyUploader::UploadStatus::kSubmitted) {
+      ReturnTransientDroppedSlot(buf_id);
+      return status == SharedD3D12CopyUploader::UploadStatus::kTransientDrop;
+    }
+    return true;
+  }
+
+  if (need_cold_vram_copy) {
+    Microsoft::WRL::ComPtr<ID3D11Texture2D> temp_tex;
+    if (uploader->CreateColdStartCopyInVram(
+            src_tex.Get(), src_desc, slot_fmt, direct_copy_ok,
+            frame.handle.win_d3d11.keyed_mutex_acq,
+            frame.handle.win_d3d11.keyed_mutex_rel, &temp_tex) &&
+        temp_tex) {
+      release_runner.RunNow();
+      auto cold = std::make_unique<ColdStartGpuFrame>();
+      cold->slot_format = slot_fmt;
+      cold->coded_size = coded_size;
+      cold->visible_rect = visible_rect;
+      cold->timestamp_us = frame.timestamp_us;
+      cold->reference_time = now_ticks;
+      cold->color_space = color_space;
+      cold->d3d11_temp_tex = std::move(temp_tex);
+      cold->d3d11_temp_tex->GetDesc(&cold->d3d11_temp_desc);
+
+      base::AutoLock lock(lock_);
+      if (!shut_down_ && !has_completed_initial_setup_) {
+        cold_start_gpu_frame_ = std::move(cold);
+        cold_start_frame_ = nullptr;
+      }
+      if (device_ready_ && mode_ == BackendMode::kTexture &&
+          !texture_alloc_in_flight_ &&
+          (texture_pool_coded_size_ != desired_coded_size_ ||
+           texture_pool_format_ != desired_pool_format_)) {
+        texture_alloc_in_flight_ = true;
+        post_texture_alloc = true;
+      }
+    }
+  }
+
+  if (post_texture_alloc) {
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ExternalVideoSource::EnsureTexturePoolOnSequence,
+                       base::WrapRefCounted(this)));
+  }
+  return true;
+
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+  if (frame.handle_type != CEF_EXT_GPU_HANDLE_LINUX_DMABUF) {
+    return false;
+  }
+  SlotPixelFormat slot_fmt = SlotPixelFormat::kNV12;
+  if (!FromCefGpuFormat(frame.format, &slot_fmt)) {
+    return false;
+  }
+
+  const int expected_planes = IsBiplanarSlotFormat(slot_fmt) ? 2 : 1;
+  const int plane_count = frame.handle.linux_dmabuf.plane_count;
+  if (plane_count < expected_planes || plane_count > 4 ||
+      frame.handle.linux_dmabuf.fds[0] < 0) {
+    return false;
+  }
+
+  const gfx::Size coded_size(frame.coded_width, frame.coded_height);
+  gfx::Rect visible_rect;
+  if (!ComputeAndValidateVisibleRect(frame, coded_size, max_size_, slot_fmt,
+                                     &visible_rect)) {
+    return false;
+  }
+
+  const gfx::ColorSpace color_space =
+      ResolveGpuFrameColorSpace(frame.color, visible_rect.height(), slot_fmt);
+  ScopedGpuReleaseRunner release_runner(frame.release_callback,
+                                        frame.release_ctx);
+
+  // Copy-on-push fast path for linear CPU-mappable DMA-BUF when no
+  // release_callback is supplied and a matching pool slot is ready.
+  const uint64_t mod = frame.handle.linux_dmabuf.drm_modifier;
+  if (!release_runner.HasCallback() && mod == 0 &&
+      slot_fmt != SlotPixelFormat::kP010) {
+    scoped_refptr<TextureSlot> tex_slot;
+    bool post_alloc = false;
+    {
+      base::AutoLock lock(lock_);
+      if (shut_down_ || mode_ == BackendMode::kSharedMemory) {
+        return false;
+      }
+      desired_coded_size_ = coded_size;
+      desired_pool_format_ = slot_fmt;
+      desired_color_space_ = color_space;
+      if (mode_ == BackendMode::kTexture &&
+          texture_pool_coded_size_ == coded_size &&
+          texture_pool_format_ == slot_fmt && !free_texture_slots_.empty()) {
+        tex_slot = std::move(free_texture_slots_.front());
+        free_texture_slots_.pop_front();
+        tex_slot->submit_seq = ++next_submit_seq_;
+        tex_slot->in_flight_since = now_ticks;
+        tex_slot->dma_in_progress = true;
+        in_flight_texture_slots_[tex_slot->buffer_id] = tex_slot;
+      } else if (device_ready_ && mode_ == BackendMode::kTexture &&
+                 !texture_alloc_in_flight_ &&
+                 (texture_pool_coded_size_ != coded_size ||
+                  texture_pool_format_ != slot_fmt)) {
+        texture_alloc_in_flight_ = true;
+        post_alloc = true;
+      }
+    }
+    if (post_alloc) {
+      task_runner_->PostTask(
+          FROM_HERE,
+          base::BindOnce(&ExternalVideoSource::EnsureTexturePoolOnSequence,
+                         base::WrapRefCounted(this)));
+    }
+    if (tex_slot) {
+      bool copied = false;
+      if (tex_slot->gmb && tex_slot->gmb->Map()) {
+        copied = true;
+        const long page_sz = sysconf(_SC_PAGESIZE);
+        const size_t page_mask =
+            page_sz > 0 ? static_cast<size_t>(page_sz - 1) : 4095u;
+        for (int p = 0; p < expected_planes; ++p) {
+          const int fd = frame.handle.linux_dmabuf.fds[p] >= 0
+                             ? frame.handle.linux_dmabuf.fds[p]
+                             : frame.handle.linux_dmabuf.fds[0];
+          const int rows =
+              (p == 0) ? coded_size.height() : (coded_size.height() / 2);
+          const size_t row_bytes =
+              IsBiplanarSlotFormat(slot_fmt)
+                  ? static_cast<size_t>(coded_size.width())
+                  : static_cast<size_t>(coded_size.width()) * 4u;
+          const size_t src_stride = frame.handle.linux_dmabuf.strides[p];
+          const size_t src_offset = frame.handle.linux_dmabuf.offsets[p];
+          if (src_stride < row_bytes || rows <= 0) {
+            copied = false;
+            break;
+          }
+          const size_t need_len =
+              src_stride * static_cast<size_t>(rows - 1) + row_bytes;
+          const size_t aligned_off = src_offset & ~page_mask;
+          const size_t delta = src_offset - aligned_off;
+          void* map_ptr = mmap(nullptr, delta + need_len, PROT_READ, MAP_SHARED,
+                               fd, static_cast<off_t>(aligned_off));
+          if (map_ptr == MAP_FAILED) {
+            copied = false;
+            break;
+          }
+          uint8_t* dst_plane =
+              static_cast<uint8_t*>(tex_slot->gmb->memory(static_cast<size_t>(p)));
+          if (dst_plane) {
+            StreamCopyRawRows(static_cast<const uint8_t*>(map_ptr) + delta,
+                              static_cast<int>(src_stride), dst_plane,
+                              tex_slot->gmb->stride(static_cast<size_t>(p)),
+                              row_bytes, rows);
+          } else {
+            copied = false;
+          }
+          munmap(map_ptr, delta + need_len);
+          if (!copied) {
+            break;
+          }
+        }
+        StreamStoreFence();
+        tex_slot->gmb->Unmap();
+      }
+      if (copied) {
+        task_runner_->PostTask(
+            FROM_HERE,
+            base::BindOnce(&ExternalVideoSource::SubmitTextureFrameOnSequence,
+                           base::WrapRefCounted(this), tex_slot->buffer_id,
+                           slot_fmt, coded_size, visible_rect,
+                           frame.timestamp_us, now_ticks, color_space));
+        return true;
+      }
+      ReturnTransientDroppedSlot(tex_slot->buffer_id);
+    }
+  }
+
+  // Zero-copy DMA-BUF import path (supports arbitrary tiled DRM modifiers and
+  // optional explicit sync_file fence).
+  gfx::NativePixmapHandle pixmap;
+  pixmap.modifier = mod;
+  for (int p = 0; p < plane_count; ++p) {
+    const int src_fd = frame.handle.linux_dmabuf.fds[p] >= 0
+                           ? frame.handle.linux_dmabuf.fds[p]
+                           : frame.handle.linux_dmabuf.fds[0];
+    base::ScopedFD dup_fd(HANDLE_EINTR(dup(src_fd)));
+    if (!dup_fd.is_valid()) {
+      release_runner.Disarm();
+      return false;
+    }
+    const uint32_t stride = frame.handle.linux_dmabuf.strides[p];
+    const uint64_t offset = frame.handle.linux_dmabuf.offsets[p];
+    const uint64_t rows =
+        (p == 0) ? static_cast<uint64_t>(coded_size.height())
+                 : static_cast<uint64_t>((coded_size.height() + 1) / 2);
+    if (stride == 0) {
+      release_runner.Disarm();
+      return false;
+    }
+    pixmap.planes.emplace_back(static_cast<int>(stride),
+                               static_cast<int>(offset), stride * rows,
+                               std::move(dup_fd));
+  }
+
+  base::ScopedFD fence_dup;
+  if (frame.handle.linux_dmabuf.sync_fence_fd >= 0) {
+    fence_dup.reset(HANDLE_EINTR(dup(frame.handle.linux_dmabuf.sync_fence_fd)));
+    if (!fence_dup.is_valid()) {
+      release_runner.Disarm();
+      return false;
+    }
+  }
+
+  auto payload = std::make_unique<ImportedGpuPayload>();
+  payload->slot_format = slot_fmt;
+  payload->coded_size = coded_size;
+  payload->visible_rect = visible_rect;
+  payload->timestamp_us = frame.timestamp_us;
+  payload->reference_time = now_ticks;
+  payload->color_space = color_space;
+  payload->surface_key = frame.surface_key;
+  payload->native_pixmap_handle = std::move(pixmap);
+  payload->sync_fence_fd = std::move(fence_dup);
+  payload->release_runner = std::move(release_runner);
+
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_ || mode_ == BackendMode::kSharedMemory) {
+      payload->release_runner.Disarm();
+      return false;
+    }
+    if (mode_ == BackendMode::kPendingInit) {
+      auto cold = std::make_unique<ColdStartGpuFrame>();
+      cold->imported_payload = std::move(payload);
+      cold_start_gpu_frame_ = std::move(cold);
+      cold_start_frame_ = nullptr;
+      return true;
+    }
+  }
+
+  task_runner_->PostTask(
+      FROM_HERE,
+      base::BindOnce(&ExternalVideoSource::SubmitImportedGpuFrameOnSequence,
+                     base::WrapRefCounted(this), std::move(payload)));
+  return true;
+
+#elif BUILDFLAG(IS_MAC)
+  if (frame.handle_type != CEF_EXT_GPU_HANDLE_MAC_IOSURFACE) {
+    return false;
+  }
+
+  gfx::ScopedIOSurface src_surface;
+  if (frame.handle.mac_iosurface.io_surface_ref) {
+    src_surface.reset(
+        static_cast<IOSurfaceRef>(frame.handle.mac_iosurface.io_surface_ref),
+        base::scoped_policy::RETAIN);
+  } else if (frame.handle.mac_iosurface.io_surface_id != 0) {
+    src_surface.reset(IOSurfaceLookup(frame.handle.mac_iosurface.io_surface_id),
+                      base::scoped_policy::ASSUME);
+  }
+  if (!src_surface) {
+    return false;
+  }
+
+  SlotPixelFormat slot_fmt = SlotPixelFormat::kNV12;
+  if (frame.format != CEF_EXT_GPU_FORMAT_AUTO) {
+    if (!FromCefGpuFormat(frame.format, &slot_fmt)) {
+      return false;
+    }
+  } else {
+    const uint32_t pf = IOSurfaceGetPixelFormat(src_surface);
+    if (pf == MakeFourCC('4', '2', '0', 'v') ||
+        pf == MakeFourCC('4', '2', '0', 'f')) {
+      slot_fmt = SlotPixelFormat::kNV12;
+    } else if (pf == MakeFourCC('x', '4', '2', '0') ||
+               pf == MakeFourCC('x', 'f', '2', '0')) {
+      slot_fmt = SlotPixelFormat::kP010;
+    } else if (pf == MakeFourCC('B', 'G', 'R', 'A')) {
+      slot_fmt = SlotPixelFormat::kBGRA8;
+    } else if (pf == MakeFourCC('R', 'G', 'B', 'A')) {
+      slot_fmt = SlotPixelFormat::kRGBA8;
+    } else {
+      return false;
+    }
+  }
+
+  const int surf_w = static_cast<int>(IOSurfaceGetWidth(src_surface));
+  const int surf_h = static_cast<int>(IOSurfaceGetHeight(src_surface));
+  const int coded_w = (frame.coded_width == 0) ? surf_w : frame.coded_width;
+  const int coded_h = (frame.coded_height == 0) ? surf_h : frame.coded_height;
+  if (coded_w > surf_w || coded_h > surf_h) {
+    return false;
+  }
+  const gfx::Size coded_size(coded_w, coded_h);
+  gfx::Rect visible_rect;
+  if (!ComputeAndValidateVisibleRect(frame, coded_size, max_size_, slot_fmt,
+                                     &visible_rect)) {
+    return false;
+  }
+
+  const gfx::ColorSpace color_space =
+      ResolveGpuFrameColorSpace(frame.color, visible_rect.height(), slot_fmt);
+  ScopedGpuReleaseRunner release_runner(frame.release_callback,
+                                        frame.release_ctx);
+
+  if (release_runner.HasCallback()) {
+    auto payload = std::make_unique<ImportedGpuPayload>();
+    payload->slot_format = slot_fmt;
+    payload->coded_size = coded_size;
+    payload->visible_rect = visible_rect;
+    payload->timestamp_us = frame.timestamp_us;
+    payload->reference_time = now_ticks;
+    payload->color_space = color_space;
+    payload->surface_key =
+        frame.surface_key != 0
+            ? frame.surface_key
+            : static_cast<uint64_t>(IOSurfaceGetID(src_surface));
+    payload->io_surface = std::move(src_surface);
+    payload->release_runner = std::move(release_runner);
+
+    {
+      base::AutoLock lock(lock_);
+      if (shut_down_ || mode_ == BackendMode::kSharedMemory) {
+        payload->release_runner.Disarm();
+        return false;
+      }
+      if (mode_ == BackendMode::kPendingInit) {
+        auto cold = std::make_unique<ColdStartGpuFrame>();
+        cold->imported_payload = std::move(payload);
+        cold_start_gpu_frame_ = std::move(cold);
+        cold_start_frame_ = nullptr;
+        return true;
+      }
+    }
+
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ExternalVideoSource::SubmitImportedGpuFrameOnSequence,
+                       base::WrapRefCounted(this), std::move(payload)));
+    return true;
+  }
+
+  // Copy-on-push for macOS IOSurface when release_callback == NULL.
+  auto copy_iosurface = [](IOSurfaceRef src, IOSurfaceRef dst,
+                           const gfx::Size& sz, SlotPixelFormat fmt) -> bool {
+    if (!src || !dst) {
+      return false;
+    }
+    if (IOSurfaceLock(src, kIOSurfaceLockReadOnly, nullptr) !=
+        kIOReturnSuccess) {
+      return false;
+    }
+    if (IOSurfaceLock(dst, 0, nullptr) != kIOReturnSuccess) {
+      IOSurfaceUnlock(src, kIOSurfaceLockReadOnly, nullptr);
+      return false;
+    }
+    bool ok = true;
+    if (IsBiplanarSlotFormat(fmt)) {
+      const size_t bpp = (fmt == SlotPixelFormat::kP010) ? 2u : 1u;
+      for (size_t p = 0; p < 2; ++p) {
+        const auto* sp =
+            static_cast<const uint8_t*>(IOSurfaceGetBaseAddressOfPlane(src, p));
+        auto* dp =
+            static_cast<uint8_t*>(IOSurfaceGetBaseAddressOfPlane(dst, p));
+        const int ss = static_cast<int>(IOSurfaceGetBytesPerRowOfPlane(src, p));
+        const int ds = static_cast<int>(IOSurfaceGetBytesPerRowOfPlane(dst, p));
+        const int rows = (p == 0) ? sz.height() : (sz.height() / 2);
+        const size_t rb = static_cast<size_t>(sz.width()) * bpp;
+        if (!sp || !dp || static_cast<size_t>(ss) < rb ||
+            static_cast<size_t>(ds) < rb) {
+          ok = false;
+          break;
+        }
+        StreamCopyRawRows(sp, ss, dp, ds, rb, rows);
+      }
+    } else {
+      const auto* sp = static_cast<const uint8_t*>(IOSurfaceGetBaseAddress(src));
+      auto* dp = static_cast<uint8_t*>(IOSurfaceGetBaseAddress(dst));
+      const int ss = static_cast<int>(IOSurfaceGetBytesPerRow(src));
+      const int ds = static_cast<int>(IOSurfaceGetBytesPerRow(dst));
+      const size_t rb = static_cast<size_t>(sz.width()) * 4u;
+      if (!sp || !dp || static_cast<size_t>(ss) < rb ||
+          static_cast<size_t>(ds) < rb) {
+        ok = false;
+      } else {
+        StreamCopyRawRows(sp, ss, dp, ds, rb, sz.height());
+      }
+    }
+    StreamStoreFence();
+    IOSurfaceUnlock(dst, 0, nullptr);
+    IOSurfaceUnlock(src, kIOSurfaceLockReadOnly, nullptr);
+    return ok;
+  };
+
+  scoped_refptr<TextureSlot> tex_slot;
+  bool need_cold = false;
+  bool post_alloc = false;
+  bool post_reclaim = false;
+  bool drop_after_lock = false;
+
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_ || mode_ == BackendMode::kSharedMemory) {
+      return false;
+    }
+    desired_coded_size_ = coded_size;
+    desired_pool_format_ = slot_fmt;
+    desired_color_space_ = color_space;
+
+    if (mode_ == BackendMode::kPendingInit) {
+      need_cold = true;
+    } else if (texture_pool_coded_size_ == coded_size &&
+               texture_pool_format_ == slot_fmt) {
+      if (device_ready_ && !texture_alloc_in_flight_ && !reclaim_in_flight_ &&
+          HasStaleInFlightSlotLocked(now_ticks)) {
+        reclaim_in_flight_ = true;
+        post_reclaim = true;
+      }
+      if (!free_texture_slots_.empty()) {
+        tex_slot = std::move(free_texture_slots_.front());
+        free_texture_slots_.pop_front();
+        tex_slot->submit_seq = ++next_submit_seq_;
+        tex_slot->in_flight_since = now_ticks;
+        tex_slot->dma_in_progress = true;
+        in_flight_texture_slots_[tex_slot->buffer_id] = tex_slot;
+      } else {
+        drop_after_lock = true;
+      }
+    } else {
+      if (!has_completed_initial_setup_) {
+        need_cold = true;
+      }
+      if (device_ready_ && !texture_alloc_in_flight_) {
+        texture_alloc_in_flight_ = true;
+        post_alloc = true;
+      }
+    }
+  }
+
+  if (post_reclaim) {
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ExternalVideoSource::ReclaimStaleTextureSlotsOnSequence,
+                       base::WrapRefCounted(this)));
+  }
+  if (drop_after_lock) {
+    return true;
+  }
+
+  if (tex_slot) {
+    if (!copy_iosurface(src_surface, tex_slot->io_surface, coded_size,
+                        slot_fmt)) {
+      ReturnTransientDroppedSlot(tex_slot->buffer_id);
+      return false;
+    }
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ExternalVideoSource::SubmitTextureFrameOnSequence,
+                       base::WrapRefCounted(this), tex_slot->buffer_id,
+                       slot_fmt, coded_size, visible_rect, frame.timestamp_us,
+                       now_ticks, color_space));
+    return true;
+  }
+
+  if (need_cold) {
+    gfx::ScopedIOSurface cold_surf(
+        gfx::CreateIOSurface(coded_size, ToGfxBufferFormat(slot_fmt), false));
+    if (cold_surf && copy_iosurface(src_surface, cold_surf, coded_size, slot_fmt)) {
+      auto cold = std::make_unique<ColdStartGpuFrame>();
+      cold->slot_format = slot_fmt;
+      cold->coded_size = coded_size;
+      cold->visible_rect = visible_rect;
+      cold->timestamp_us = frame.timestamp_us;
+      cold->reference_time = now_ticks;
+      cold->color_space = color_space;
+      cold->io_surface_copy = std::move(cold_surf);
+
+      base::AutoLock lock(lock_);
+      if (!shut_down_ && !has_completed_initial_setup_) {
+        cold_start_gpu_frame_ = std::move(cold);
+        cold_start_frame_ = nullptr;
+      }
+    }
+  }
+
+  if (post_alloc) {
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ExternalVideoSource::EnsureTexturePoolOnSequence,
+                       base::WrapRefCounted(this)));
+  }
+  return true;
+#else
+  (void)now_ticks;
+  return false;
+#endif
+}
+
+void ExternalVideoSource::Shutdown() {
+  std::unique_ptr<ColdStartGpuFrame> cold_gpu;
+  {
+    base::AutoLock lock(lock_);
+    shut_down_ = true;
+    device_ready_ = false;
+    cold_start_frame_ = nullptr;
+    cold_gpu = std::move(cold_start_gpu_frame_);
+    reserved_slots_.clear();
+    shmem_buffers_.clear();
+    free_texture_slots_.clear();
+#if BUILDFLAG(IS_WIN)
+    d3d12_uploader_shared_.reset();
+#endif
+  }
+  cold_gpu.reset();
+  task_runner_->PostTask(
+      FROM_HERE, base::BindOnce(&ExternalVideoSource::ShutdownOnSequence,
+                                base::WrapRefCounted(this)));
+}
+
+void ExternalVideoSource::InitOnSequence(
+    mojo::PendingRemote<video_capture::mojom::VideoSourceProvider> provider,
+    scoped_refptr<gpu::GpuChannelHost> gpu_channel,
+    gpu::GpuMemoryBufferManager* gmb_manager) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_) {
+      return;
+    }
+  }
+
+  provider_.Bind(std::move(provider));
+  provider_.set_disconnect_handler(base::BindOnce(
+      &ExternalVideoSource::OnProviderError, base::Unretained(this)));
+
+  if (TryInitTextureBackendOnSequence(std::move(gpu_channel), gmb_manager)) {
+    return;
+  }
+
+  InitSharedMemoryBackendOnSequence(
+      "GPU compositing disabled, software renderer, or native texture unsupported");
+}
+
+bool ExternalVideoSource::TryInitTextureBackendOnSequence(
+    scoped_refptr<gpu::GpuChannelHost> gpu_channel,
+    gpu::GpuMemoryBufferManager* gmb_manager) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+
+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || \
+    BUILDFLAG(IS_MAC)
+  if (!gpu_channel || gpu_channel->IsLost() ||
+      !IsHardwareGpuInfoUsable(gpu_channel->gpu_info())) {
+    return false;
+  }
+
+  std::unique_ptr<gpu::ClientSharedImageInterface> sii =
+      gpu_channel->CreateClientSharedImageInterface();
+  if (!sii) {
+    return false;
+  }
+
+#if BUILDFLAG(IS_WIN)
+  auto uploader = SharedD3D12CopyUploader::GetOrCreate(
+      gpu_channel->gpu_info().active_gpu().luid);
+  if (!uploader) {
+    return false;
+  }
+  d3d12_uploader_ = uploader;
+  const char* backend_detail =
+      "Windows D3D11/D3D12 DMA + keyless DXGI SharedImage";
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+  const int probe_mode =
+      ProbeLinuxNativePixmapNV12(gpu_channel->channel_id(), gmb_manager);
+  if (probe_mode < 0) {
+    return false;
+  }
+  linux_use_scanout_gmb_ = (probe_mode == 1);
+  const char* backend_detail = linux_use_scanout_gmb_
+                                   ? "Linux NativePixmap DMA-BUF (scanout)"
+                                   : "Linux NativePixmap DMA-BUF (linear)";
+#elif BUILDFLAG(IS_MAC)
+  if (!gmb_manager) {
+    return false;
+  }
+  const char* backend_detail = "macOS IOSurface SharedImage";
+#endif
+
+  gpu_channel_ = std::move(gpu_channel);
+  sii_ = std::move(sii);
+  gmb_manager_ = gmb_manager;
+
+  media::VideoCaptureDeviceInfo tex_device_info = device_info_;
+  for (auto& fmt : tex_device_info.supported_formats) {
+    fmt.pixel_format = media::PIXEL_FORMAT_NV12;
+  }
+
+  provider_->AddTextureVirtualDevice(
+      tex_device_info, texture_device_.BindNewPipeAndPassReceiver());
+  texture_device_.set_disconnect_handler(base::BindOnce(
+      &ExternalVideoSource::OnTextureDeviceError, base::Unretained(this)));
+  texture_device_->OnFrameAccessHandlerReady(
+      access_handler_receiver_.BindNewPipeAndPassRemote());
+
+  LogTextureBackendActivatedOnce(backend_detail);
+
+  bool should_allocate_pool = false;
+  std::unique_ptr<ImportedGpuPayload> pending_imported_cold;
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_) {
+      return true;
+    }
+    mode_ = BackendMode::kTexture;
+    device_ready_ = true;
+#if BUILDFLAG(IS_WIN)
+    d3d12_uploader_shared_ = d3d12_uploader_;
+#endif
+    if (cold_start_gpu_frame_ && cold_start_gpu_frame_->imported_payload) {
+      pending_imported_cold =
+          std::move(cold_start_gpu_frame_->imported_payload);
+      cold_start_gpu_frame_.reset();
+    }
+    if (!desired_coded_size_.IsEmpty() && !texture_alloc_in_flight_) {
+      texture_alloc_in_flight_ = true;
+      should_allocate_pool = true;
+    }
+  }
+
+  if (pending_imported_cold) {
+    SubmitImportedGpuFrameOnSequence(std::move(pending_imported_cold));
+  }
+  if (should_allocate_pool) {
+    EnsureTexturePoolOnSequence();
+  }
+  return true;
+#else
+  (void)gpu_channel;
+  (void)gmb_manager;
+  return false;
+#endif
+}
+
+void ExternalVideoSource::InitSharedMemoryBackendOnSequence(
+    const char* fallback_reason) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  if (!provider_.is_bound()) {
+    return;
+  }
+
+  if (!logged_shmem_fallback_) {
+    logged_shmem_fallback_ = true;
+    LOG(WARNING) << "cef_external_video[" << device_info_.descriptor.device_id
+                 << "]: GPU texture backend unavailable ("
+                 << (fallback_reason ? fallback_reason : "unspecified")
+                 << "); using pre-reserved shared memory fallback";
+  }
+
+  shmem_ipc_in_flight_ = false;
+  producer_receiver_.reset();
+  shmem_device_.reset();
+  provider_->AddSharedMemoryVirtualDevice(
+      device_info_, producer_receiver_.BindNewPipeAndPassRemote(),
+      shmem_device_.BindNewPipeAndPassReceiver());
+  shmem_device_.set_disconnect_handler(base::BindOnce(
+      &ExternalVideoSource::OnShmemDeviceError, base::Unretained(this)));
+
+  bool should_reserve = false;
+  std::unique_ptr<ColdStartGpuFrame> drop_cold_gpu;
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_) {
+      return;
+    }
+    mode_ = BackendMode::kSharedMemory;
+    device_ready_ = true;
+    texture_alloc_in_flight_ = false;
+    reclaim_in_flight_ = false;
+    texture_pool_coded_size_ = gfx::Size();
+    free_texture_slots_.clear();
+    in_flight_texture_slots_.clear();
+    drop_cold_gpu = std::move(cold_start_gpu_frame_);
+#if BUILDFLAG(IS_WIN)
+    d3d12_uploader_shared_.reset();
+#endif
+    reserved_slots_.clear();
+    if (!desired_coded_size_.IsEmpty() && !reserve_in_flight_) {
+      reserve_in_flight_ = true;
+      consecutive_empty_reserves_ = 0;
+      should_reserve = true;
+    }
+  }
+  drop_cold_gpu.reset();
+
+  if (should_reserve) {
+    ReserveBufferOnSequence();
+  }
+}
+
+void ExternalVideoSource::FallbackToSharedMemoryOnSequence(const char* reason) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_ || mode_ == BackendMode::kSharedMemory) {
+      return;
+    }
+  }
+  ReleaseAllTextureResourcesOnSequence(/*retire_on_device=*/false);
+  access_handler_receiver_.reset();
+  texture_device_.reset();
+  sii_.reset();
+  gpu_channel_.reset();
+  gmb_manager_ = nullptr;
+#if BUILDFLAG(IS_WIN)
+  d3d12_uploader_.reset();
+  {
+    base::AutoLock lock(lock_);
+    d3d12_uploader_shared_.reset();
+  }
+#endif
+
+  InitSharedMemoryBackendOnSequence(reason);
+}
+
+bool ExternalVideoSource::RegisterSlotMailboxesOnSequence(
+    const TextureSlot& slot,
+    const gpu::SyncToken& sync_token) {
+  if (!texture_device_.is_bound()) {
+    return false;
+  }
+  auto handle_set = media::mojom::MailboxBufferHandleSet::New();
+  handle_set->mailbox_holder.resize(media::VideoFrame::kMaxPlanes);
+  handle_set->mailbox_holder[0] =
+      gpu::MailboxHolder(slot.mailbox_y, sync_token, slot.texture_target);
+  if (IsBiplanarSlotFormat(slot.slot_format)) {
+    handle_set->mailbox_holder[1] =
+        gpu::MailboxHolder(slot.mailbox_uv, sync_token, slot.texture_target);
+  }
+  texture_device_->OnNewMailboxHolderBufferHandle(slot.buffer_id,
+                                                  std::move(handle_set));
+  registered_texture_buffer_ids_.insert(slot.buffer_id);
+  return true;
+}
+
+void ExternalVideoSource::EnsureTexturePoolOnSequence() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+
+  gfx::Size target_size;
+  SlotPixelFormat target_fmt = SlotPixelFormat::kNV12;
+  gfx::ColorSpace target_cs;
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_ || mode_ != BackendMode::kTexture ||
+        !texture_device_.is_bound() || desired_coded_size_.IsEmpty() ||
+        (texture_pool_coded_size_ == desired_coded_size_ &&
+         texture_pool_format_ == desired_pool_format_)) {
+      texture_alloc_in_flight_ = false;
+      return;
+    }
+    target_size = desired_coded_size_;
+    target_fmt = desired_pool_format_;
+    target_cs = desired_color_space_;
+  }
+
+  if (!gpu_channel_ || gpu_channel_->IsLost() || !sii_) {
+    FallbackToSharedMemoryOnSequence("GPU channel lost before pool allocation");
+    return;
+  }
+
+  if (!target_cs.IsValid()) {
+    target_cs = ResolveGpuFrameColorSpace(nullptr, target_size.height(),
+                                          target_fmt);
+  }
+
+  std::deque<scoped_refptr<TextureSlot>> old_idle_slots;
+  {
+    base::AutoLock lock(lock_);
+    old_idle_slots.swap(free_texture_slots_);
+    texture_pool_coded_size_ = gfx::Size();
+  }
+  for (const auto& old_slot : old_idle_slots) {
+    if (registered_texture_buffer_ids_.erase(old_slot->buffer_id) > 0 &&
+        texture_device_.is_bound()) {
+      texture_device_->OnBufferRetired(old_slot->buffer_id);
+    }
+    DestroySlotSharedImagesOnSequence(*old_slot);
+  }
+  old_idle_slots.clear();
+
+  std::vector<scoped_refptr<TextureSlot>> new_slots;
+  new_slots.reserve(kTexturePoolSlots);
+  for (size_t i = 0; i < kTexturePoolSlots; ++i) {
+    const int32_t buffer_id = next_texture_buffer_id_++;
+    scoped_refptr<TextureSlot> slot =
+        CreateTextureSlotOnSequence(buffer_id, target_size, target_fmt,
+                                    target_cs);
+    if (!slot) {
+      for (const auto& partial : new_slots) {
+        DestroySlotSharedImagesOnSequence(*partial);
+      }
+      FallbackToSharedMemoryOnSequence(
+          "failed to allocate GPU texture pool slot");
+      return;
+    }
+    new_slots.push_back(std::move(slot));
+  }
+
+  const gpu::SyncToken sync_token = sii_->GenVerifiedSyncToken();
+  if (!sync_token.HasData() || gpu_channel_->IsLost()) {
+    for (const auto& partial : new_slots) {
+      DestroySlotSharedImagesOnSequence(*partial);
+    }
+    FallbackToSharedMemoryOnSequence(
+        "failed to verify SharedImage SyncToken on GPU channel");
+    return;
+  }
+
+  for (const auto& slot : new_slots) {
+    RegisterSlotMailboxesOnSequence(*slot, sync_token);
+  }
+
+  scoped_refptr<media::VideoFrame> cold_frame;
+  std::unique_ptr<ColdStartGpuFrame> cold_gpu;
+  scoped_refptr<TextureSlot> cold_slot;
+  bool config_changed_again = false;
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_ || mode_ != BackendMode::kTexture) {
+      texture_alloc_in_flight_ = false;
+      return;
+    }
+
+    texture_pool_coded_size_ = target_size;
+    texture_pool_format_ = target_fmt;
+    has_completed_initial_setup_ = true;
+
+    if (cold_start_gpu_frame_ &&
+        cold_start_gpu_frame_->coded_size == target_size &&
+        cold_start_gpu_frame_->slot_format == target_fmt) {
+      cold_gpu = std::move(cold_start_gpu_frame_);
+      cold_start_frame_ = nullptr;
+      cold_slot = new_slots[0];
+      cold_slot->submit_seq = ++next_submit_seq_;
+      cold_slot->in_flight_since = base::TimeTicks::Now();
+      cold_slot->dma_in_progress = true;
+      in_flight_texture_slots_[cold_slot->buffer_id] = cold_slot;
+      for (size_t i = 1; i < new_slots.size(); ++i) {
+        free_texture_slots_.push_back(std::move(new_slots[i]));
+      }
+    } else if (cold_start_frame_ &&
+               cold_start_frame_->coded_size() == target_size &&
+               target_fmt == SlotPixelFormat::kNV12) {
+      cold_frame = std::move(cold_start_frame_);
+      cold_start_gpu_frame_.reset();
+      cold_slot = new_slots[0];
+      cold_slot->submit_seq = ++next_submit_seq_;
+      cold_slot->in_flight_since = base::TimeTicks::Now();
+      cold_slot->dma_in_progress = true;
+      in_flight_texture_slots_[cold_slot->buffer_id] = cold_slot;
+      for (size_t i = 1; i < new_slots.size(); ++i) {
+        free_texture_slots_.push_back(std::move(new_slots[i]));
+      }
+    } else {
+      cold_start_frame_ = nullptr;
+      cold_start_gpu_frame_.reset();
+      for (auto& slot : new_slots) {
+        free_texture_slots_.push_back(std::move(slot));
+      }
+    }
+
+    if (!desired_coded_size_.IsEmpty() &&
+        (desired_coded_size_ != target_size ||
+         desired_pool_format_ != target_fmt)) {
+      config_changed_again = true;
+    } else {
+      texture_alloc_in_flight_ = false;
+    }
+  }
+
+  if (cold_gpu && cold_slot) {
+#if BUILDFLAG(IS_WIN)
+    if (cold_gpu->d3d11_temp_tex && cold_slot->uploader) {
+      const int32_t buf_id = cold_slot->buffer_id;
+      const SlotPixelFormat sfmt = cold_gpu->slot_format;
+      const gfx::Size sz = cold_gpu->coded_size;
+      const gfx::Rect vr = cold_gpu->visible_rect;
+      const int64_t ts = cold_gpu->timestamp_us;
+      const base::TimeTicks rt = cold_gpu->reference_time;
+      const gfx::ColorSpace cs = cold_gpu->color_space;
+      scoped_refptr<ExternalVideoSource> self = base::WrapRefCounted(this);
+      auto status = cold_slot->uploader->SubmitGpuTextureCopy(
+          cold_gpu->d3d11_temp_tex.Get(), cold_gpu->d3d11_temp_desc,
+          cold_slot->d3d11_texture, sfmt, /*direct_copy_ok=*/true, 0, 0,
+          /*wait_until_gpu_done=*/true,
+          base::BindOnce(
+              [](scoped_refptr<ExternalVideoSource> src, int32_t id,
+                 SlotPixelFormat fmt, gfx::Size csz, gfx::Rect vis,
+                 int64_t ts_us, base::TimeTicks ref_t, gfx::ColorSpace col,
+                 bool ok) {
+                if (ok) {
+                  src->task_runner_->PostTask(
+                      FROM_HERE,
+                      base::BindOnce(
+                          &ExternalVideoSource::SubmitTextureFrameOnSequence,
+                          src, id, fmt, csz, vis, ts_us, ref_t, col));
+                } else {
+                  src->ReturnTransientDroppedSlot(id);
+                }
+              },
+              self, buf_id, sfmt, sz, vr, ts, rt, cs));
+      if (status != SharedD3D12CopyUploader::UploadStatus::kSubmitted) {
+        ReturnTransientDroppedSlot(buf_id);
+      }
+    } else {
+      ReturnTransientDroppedSlot(cold_slot->buffer_id);
+    }
+#elif BUILDFLAG(IS_MAC)
+    bool ok = false;
+    if (cold_gpu->io_surface_copy && cold_slot->io_surface &&
+        IOSurfaceLock(cold_gpu->io_surface_copy, kIOSurfaceLockReadOnly,
+                      nullptr) == kIOReturnSuccess) {
+      if (IOSurfaceLock(cold_slot->io_surface, 0, nullptr) ==
+          kIOReturnSuccess) {
+        ok = true;
+        if (IsBiplanarSlotFormat(cold_gpu->slot_format)) {
+          const size_t bpp =
+              (cold_gpu->slot_format == SlotPixelFormat::kP010) ? 2u : 1u;
+          for (size_t p = 0; p < 2; ++p) {
+            const auto* sp = static_cast<const uint8_t*>(
+                IOSurfaceGetBaseAddressOfPlane(cold_gpu->io_surface_copy, p));
+            auto* dp = static_cast<uint8_t*>(
+                IOSurfaceGetBaseAddressOfPlane(cold_slot->io_surface, p));
+            const int ss = static_cast<int>(
+                IOSurfaceGetBytesPerRowOfPlane(cold_gpu->io_surface_copy, p));
+            const int ds = static_cast<int>(
+                IOSurfaceGetBytesPerRowOfPlane(cold_slot->io_surface, p));
+            const int rows = (p == 0) ? cold_gpu->coded_size.height()
+                                      : (cold_gpu->coded_size.height() / 2);
+            StreamCopyRawRows(sp, ss, dp, ds,
+                              static_cast<size_t>(cold_gpu->coded_size.width()) *
+                                  bpp,
+                              rows);
+          }
+        } else {
+          StreamCopyRawRows(
+              static_cast<const uint8_t*>(
+                  IOSurfaceGetBaseAddress(cold_gpu->io_surface_copy)),
+              static_cast<int>(
+                  IOSurfaceGetBytesPerRow(cold_gpu->io_surface_copy)),
+              static_cast<uint8_t*>(
+                  IOSurfaceGetBaseAddress(cold_slot->io_surface)),
+              static_cast<int>(IOSurfaceGetBytesPerRow(cold_slot->io_surface)),
+              static_cast<size_t>(cold_gpu->coded_size.width()) * 4u,
+              cold_gpu->coded_size.height());
+        }
+        StreamStoreFence();
+        IOSurfaceUnlock(cold_slot->io_surface, 0, nullptr);
+      }
+      IOSurfaceUnlock(cold_gpu->io_surface_copy, kIOSurfaceLockReadOnly,
+                      nullptr);
+    }
+    if (ok) {
+      SubmitTextureFrameOnSequence(
+          cold_slot->buffer_id, cold_gpu->slot_format, cold_gpu->coded_size,
+          cold_gpu->visible_rect, cold_gpu->timestamp_us,
+          cold_gpu->reference_time, cold_gpu->color_space);
+    } else {
+      ReturnTransientDroppedSlot(cold_slot->buffer_id);
+    }
+#else
+    ReturnTransientDroppedSlot(cold_slot->buffer_id);
+#endif
+  }
+
+  if (cold_frame && cold_slot) {
+    const base::TimeTicks rt =
+        cold_frame->metadata().reference_time.value_or(base::TimeTicks::Now());
+    const int64_t ts_us = cold_frame->timestamp().InMicroseconds();
+    const gfx::ColorSpace cs = cold_frame->ColorSpace();
+    const gfx::Rect vis_rect = cold_frame->visible_rect();
+#if BUILDFLAG(IS_WIN)
+    const int32_t buf_id = cold_slot->buffer_id;
+    const gfx::Size slot_size = cold_slot->coded_size;
+    scoped_refptr<ExternalVideoSource> self = base::WrapRefCounted(this);
+    auto on_dma_done = base::BindOnce(
+        [](scoped_refptr<ExternalVideoSource> src, int32_t id, gfx::Size sz,
+           gfx::Rect vr, int64_t ts, base::TimeTicks ref_t,
+           gfx::ColorSpace color_s, bool ok) {
+          if (ok) {
+            src->task_runner_->PostTask(
+                FROM_HERE,
+                base::BindOnce(
+                    &ExternalVideoSource::SubmitTextureFrameOnSequence, src, id,
+                    SlotPixelFormat::kNV12, sz, vr, ts, ref_t, color_s));
+          } else {
+            src->task_runner_->PostTask(
+                FROM_HERE,
+                base::BindOnce(
+                    &ExternalVideoSource::HandleTextureUploadFailureOnSequence,
+                    src, id, "D3D12 cold-start copy queue fence failed"));
+          }
+        },
+        self, buf_id, slot_size, vis_rect, ts_us, rt, cs);
+
+    const auto status =
+        cold_slot->uploader
+            ? cold_slot->uploader->SubmitAsyncUploadNV12(
+                  cold_slot->d3d12_resource, cold_slot->footprints,
+                  cold_slot->upload_total_bytes, slot_size,
+                  cold_frame->data(media::VideoFrame::kYPlane),
+                  cold_frame->stride(media::VideoFrame::kYPlane),
+                  cold_frame->data(media::VideoFrame::kUPlane),
+                  cold_frame->stride(media::VideoFrame::kUPlane),
+                  cold_frame->data(media::VideoFrame::kVPlane),
+                  cold_frame->stride(media::VideoFrame::kVPlane),
+                  vis_rect.width(), vis_rect.height(), std::move(on_dma_done))
+            : SharedD3D12CopyUploader::UploadStatus::kFatalError;
+    if (status == SharedD3D12CopyUploader::UploadStatus::kTransientDrop) {
+      ReturnTransientDroppedSlot(buf_id);
+    } else if (status == SharedD3D12CopyUploader::UploadStatus::kFatalError) {
+      HandleTextureUploadFailureOnSequence(
+          buf_id, "D3D12 cold-start NV12 upload device failure");
+      return;
+    }
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+    bool ok = false;
+    if (cold_slot->gmb && cold_slot->gmb->Map()) {
+      uint8_t* dst_y = static_cast<uint8_t*>(cold_slot->gmb->memory(0));
+      uint8_t* dst_uv = static_cast<uint8_t*>(cold_slot->gmb->memory(1));
+      if (dst_y && dst_uv) {
+        StreamCopyI420ToNV12Planes(
+            cold_frame->data(media::VideoFrame::kYPlane),
+            cold_frame->stride(media::VideoFrame::kYPlane),
+            cold_frame->data(media::VideoFrame::kUPlane),
+            cold_frame->stride(media::VideoFrame::kUPlane),
+            cold_frame->data(media::VideoFrame::kVPlane),
+            cold_frame->stride(media::VideoFrame::kVPlane), vis_rect.width(),
+            vis_rect.height(), cold_slot->coded_size, dst_y,
+            cold_slot->gmb->stride(0), dst_uv, cold_slot->gmb->stride(1));
+        ok = true;
+      }
+      cold_slot->gmb->Unmap();
+    }
+    if (ok) {
+      SubmitTextureFrameOnSequence(cold_slot->buffer_id, SlotPixelFormat::kNV12,
+                                   cold_slot->coded_size, vis_rect, ts_us, rt,
+                                   cs);
+    } else {
+      HandleTextureUploadFailureOnSequence(
+          cold_slot->buffer_id, "Linux cold-start NativePixmap Map failed");
+      return;
+    }
+#elif BUILDFLAG(IS_MAC)
+    bool ok = false;
+    if (cold_slot->io_surface &&
+        IOSurfaceLock(cold_slot->io_surface, 0, nullptr) == kIOReturnSuccess) {
+      uint8_t* dst_y = static_cast<uint8_t*>(
+          IOSurfaceGetBaseAddressOfPlane(cold_slot->io_surface, 0));
+      uint8_t* dst_uv = static_cast<uint8_t*>(
+          IOSurfaceGetBaseAddressOfPlane(cold_slot->io_surface, 1));
+      const int stride_y = static_cast<int>(
+          IOSurfaceGetBytesPerRowOfPlane(cold_slot->io_surface, 0));
+      const int stride_uv = static_cast<int>(
+          IOSurfaceGetBytesPerRowOfPlane(cold_slot->io_surface, 1));
+      if (dst_y && dst_uv) {
+        StreamCopyI420ToNV12Planes(
+            cold_frame->data(media::VideoFrame::kYPlane),
+            cold_frame->stride(media::VideoFrame::kYPlane),
+            cold_frame->data(media::VideoFrame::kUPlane),
+            cold_frame->stride(media::VideoFrame::kUPlane),
+            cold_frame->data(media::VideoFrame::kVPlane),
+            cold_frame->stride(media::VideoFrame::kVPlane), vis_rect.width(),
+            vis_rect.height(), cold_slot->coded_size, dst_y, stride_y, dst_uv,
+            stride_uv);
+        ok = true;
+      }
+      IOSurfaceUnlock(cold_slot->io_surface, 0, nullptr);
+    }
+    if (ok) {
+      SubmitTextureFrameOnSequence(cold_slot->buffer_id, SlotPixelFormat::kNV12,
+                                   cold_slot->coded_size, vis_rect, ts_us, rt,
+                                   cs);
+    } else {
+      HandleTextureUploadFailureOnSequence(
+          cold_slot->buffer_id, "macOS cold-start IOSurface Lock failed");
+      return;
+    }
+#endif
+  }
+
+  if (config_changed_again) {
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&ExternalVideoSource::EnsureTexturePoolOnSequence,
+                       base::WrapRefCounted(this)));
+  }
+}
+
+bool ExternalVideoSource::HasStaleInFlightSlotLocked(
+    base::TimeTicks now) const {
+  const bool pool_exhausted = free_texture_slots_.empty();
+  for (const auto& [id, slot] : in_flight_texture_slots_) {
+    if (slot->is_imported || slot->dma_in_progress) {
+      continue;
+    }
+    if (now - slot->in_flight_since < kStaleTextureSlotTimeout) {
+      continue;
+    }
+    if (slot->submit_seq < last_completed_seq_ || pool_exhausted) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void ExternalVideoSource::ReclaimStaleTextureSlotsOnSequence() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+
+  std::vector<scoped_refptr<TextureSlot>> stale_slots;
+  gfx::Size target_size;
+  SlotPixelFormat target_fmt = SlotPixelFormat::kNV12;
+  gfx::ColorSpace target_cs;
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_ || mode_ != BackendMode::kTexture ||
+        !texture_device_.is_bound() || texture_alloc_in_flight_ ||
+        texture_pool_coded_size_.IsEmpty()) {
+      reclaim_in_flight_ = false;
+      return;
+    }
+
+    const base::TimeTicks now = base::TimeTicks::Now();
+    const bool pool_exhausted = free_texture_slots_.empty();
+    for (auto it = in_flight_texture_slots_.begin();
+         it != in_flight_texture_slots_.end();) {
+      const scoped_refptr<TextureSlot>& slot = it->second;
+      if (!slot->is_imported && !slot->dma_in_progress &&
+          (now - slot->in_flight_since >= kStaleTextureSlotTimeout) &&
+          (slot->submit_seq < last_completed_seq_ || pool_exhausted)) {
+        stale_slots.push_back(slot);
+        it = in_flight_texture_slots_.erase(it);
+      } else {
+        ++it;
+      }
+    }
+
+    if (stale_slots.empty()) {
+      reclaim_in_flight_ = false;
+      return;
+    }
+    target_size = texture_pool_coded_size_;
+    target_fmt = texture_pool_format_;
+    target_cs = desired_color_space_;
+  }
+
+  if (!gpu_channel_ || gpu_channel_->IsLost() || !sii_) {
+    FallbackToSharedMemoryOnSequence("GPU channel lost during slot reclaim");
+    return;
+  }
+
+  if (!target_cs.IsValid()) {
+    target_cs = ResolveGpuFrameColorSpace(nullptr, target_size.height(),
+                                          target_fmt);
+  }
+
+  for (const auto& old_slot : stale_slots) {
+    old_slot->release_runner.RunNow();
+    if (registered_texture_buffer_ids_.erase(old_slot->buffer_id) > 0 &&
+        texture_device_.is_bound()) {
+      texture_device_->OnBufferRetired(old_slot->buffer_id);
+    }
+    DestroySlotSharedImagesOnSequence(*old_slot);
+  }
+
+  std::vector<scoped_refptr<TextureSlot>> replacements;
+  replacements.reserve(stale_slots.size());
+  for (size_t i = 0; i < stale_slots.size(); ++i) {
+    const int32_t new_id = next_texture_buffer_id_++;
+    scoped_refptr<TextureSlot> slot =
+        CreateTextureSlotOnSequence(new_id, target_size, target_fmt, target_cs);
+    if (!slot) {
+      for (const auto& partial : replacements) {
+        DestroySlotSharedImagesOnSequence(*partial);
+      }
+      FallbackToSharedMemoryOnSequence(
+          "failed to allocate replacement GPU texture slot");
+      return;
+    }
+    replacements.push_back(std::move(slot));
+  }
+
+  const gpu::SyncToken sync_token = sii_->GenVerifiedSyncToken();
+  if (!sync_token.HasData() || gpu_channel_->IsLost()) {
+    for (const auto& partial : replacements) {
+      DestroySlotSharedImagesOnSequence(*partial);
+    }
+    FallbackToSharedMemoryOnSequence(
+        "failed to verify replacement SharedImage SyncToken");
+    return;
+  }
+
+  for (const auto& slot : replacements) {
+    RegisterSlotMailboxesOnSequence(*slot, sync_token);
+  }
+
+  std::vector<scoped_refptr<TextureSlot>> discard_slots;
+  {
+    base::AutoLock lock(lock_);
+    reclaim_in_flight_ = false;
+    if (!shut_down_ && mode_ == BackendMode::kTexture &&
+        texture_pool_coded_size_ == target_size &&
+        texture_pool_format_ == target_fmt) {
+      for (auto& slot : replacements) {
+        free_texture_slots_.push_back(std::move(slot));
+      }
+    } else {
+      discard_slots.swap(replacements);
+    }
+  }
+
+  for (const auto& slot : discard_slots) {
+    if (registered_texture_buffer_ids_.erase(slot->buffer_id) > 0 &&
+        texture_device_.is_bound()) {
+      texture_device_->OnBufferRetired(slot->buffer_id);
+    }
+    DestroySlotSharedImagesOnSequence(*slot);
+  }
+}
+
+scoped_refptr<ExternalVideoSource::TextureSlot>
+ExternalVideoSource::CreateTextureSlotOnSequence(
+    int32_t buffer_id,
+    const gfx::Size& coded_size,
+    SlotPixelFormat slot_format,
+    const gfx::ColorSpace& color_space) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  if (!sii_ || !gpu_channel_ || gpu_channel_->IsLost()) {
+    return nullptr;
+  }
+
+  const gfx::BufferFormat buf_fmt = ToGfxBufferFormat(slot_format);
+  const bool biplanar = IsBiplanarSlotFormat(slot_format);
+
+#if BUILDFLAG(IS_WIN)
+  if (!d3d12_uploader_ || !d3d12_uploader_->IsDeviceHealthy()) {
+    return nullptr;
+  }
+
+  Microsoft::WRL::ComPtr<ID3D11Texture2D> d3d11_texture;
+  Microsoft::WRL::ComPtr<ID3D12Resource> d3d12_resource;
+  D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprints[2] = {};
+  UINT64 total_bytes = 0;
+  base::win::ScopedHandle shared_handle;
+  if (!d3d12_uploader_->CreateSharedSlotTexture(
+          coded_size, slot_format, &d3d11_texture, &d3d12_resource, footprints,
+          &total_bytes, &shared_handle)) {
+    return nullptr;
+  }
+
+  gfx::GpuMemoryBufferHandle gmb_handle;
+  gmb_handle.type = gfx::DXGI_SHARED_HANDLE;
+  gmb_handle.id = NextGpuMemoryBufferId();
+  gmb_handle.dxgi_handle = std::move(shared_handle);
+  gmb_handle.dxgi_token = gfx::DXGIHandleToken();
+
+  auto gmb_dxgi = gpu::GpuMemoryBufferImplDXGI::CreateFromHandle(
+      std::move(gmb_handle), coded_size, buf_fmt, gfx::BufferUsage::GPU_READ,
+      base::DoNothing(), nullptr, nullptr);
+  if (!gmb_dxgi) {
+    return nullptr;
+  }
+
+  constexpr uint32_t kUsage =
+      gpu::SHARED_IMAGE_USAGE_GLES2 | gpu::SHARED_IMAGE_USAGE_RASTER |
+      gpu::SHARED_IMAGE_USAGE_DISPLAY_READ | gpu::SHARED_IMAGE_USAGE_SCANOUT;
+
+  auto slot = base::MakeRefCounted<TextureSlot>(
+      buffer_id, coded_size, slot_format, static_cast<uint32_t>(GL_TEXTURE_2D),
+      /*overlay_capable=*/true);
+  if (biplanar) {
+    slot->mailbox_y = sii_->CreateSharedImage(
+        gmb_dxgi.get(), nullptr, gfx::BufferPlane::Y, color_space,
+        kTopLeft_GrSurfaceOrigin, kPremul_SkAlphaType, kUsage);
+    slot->mailbox_uv = sii_->CreateSharedImage(
+        gmb_dxgi.get(), nullptr, gfx::BufferPlane::UV, color_space,
+        kTopLeft_GrSurfaceOrigin, kPremul_SkAlphaType, kUsage);
+    if (slot->mailbox_y.IsZero() || slot->mailbox_uv.IsZero()) {
+      DestroySlotSharedImagesOnSequence(*slot);
+      return nullptr;
+    }
+  } else {
+    slot->mailbox_y = sii_->CreateSharedImage(
+        gmb_dxgi.get(), nullptr, gfx::BufferPlane::DEFAULT, color_space,
+        kTopLeft_GrSurfaceOrigin, kOpaque_SkAlphaType, kUsage);
+    if (slot->mailbox_y.IsZero()) {
+      return nullptr;
+    }
+  }
+
+  slot->uploader = d3d12_uploader_;
+  slot->d3d11_texture = std::move(d3d11_texture);
+  slot->d3d12_resource = std::move(d3d12_resource);
+  slot->footprints[0] = footprints[0];
+  slot->footprints[1] = footprints[1];
+  slot->upload_total_bytes = total_bytes;
+  slot->gmb_dxgi = std::move(gmb_dxgi);
+  return slot;
+
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+  if (!gmb_manager_) {
+    return nullptr;
+  }
+
+  const gfx::BufferUsage gmb_usage =
+      linux_use_scanout_gmb_ ? gfx::BufferUsage::SCANOUT_CPU_READ_WRITE
+                             : gfx::BufferUsage::GPU_READ_CPU_READ_WRITE;
+  auto gmb = gmb_manager_->CreateGpuMemoryBuffer(
+      coded_size, buf_fmt, gmb_usage, gpu::kNullSurfaceHandle, nullptr);
+  if (!gmb || gmb->GetType() != gfx::NATIVE_PIXMAP) {
+    return nullptr;
+  }
+
+  uint32_t si_usage = gpu::SHARED_IMAGE_USAGE_GLES2 |
+                      gpu::SHARED_IMAGE_USAGE_RASTER |
+                      gpu::SHARED_IMAGE_USAGE_DISPLAY_READ;
+  if (linux_use_scanout_gmb_) {
+    si_usage |= gpu::SHARED_IMAGE_USAGE_SCANOUT;
+  }
+
+  const gfx::BufferFormat plane0_fmt =
+      biplanar ? gfx::BufferFormat::R_8 : buf_fmt;
+  const gfx::BufferPlane plane0 =
+      biplanar ? gfx::BufferPlane::Y : gfx::BufferPlane::DEFAULT;
+  const uint32_t target =
+      gpu::NativeBufferNeedsPlatformSpecificTextureTarget(plane0_fmt, plane0)
+          ? gpu::GetPlatformSpecificTextureTarget()
+          : static_cast<uint32_t>(GL_TEXTURE_2D);
+
+  auto slot = base::MakeRefCounted<TextureSlot>(
+      buffer_id, coded_size, slot_format, target, linux_use_scanout_gmb_);
+  if (biplanar) {
+    slot->mailbox_y = sii_->CreateSharedImage(
+        gmb.get(), gmb_manager_, gfx::BufferPlane::Y, color_space,
+        kTopLeft_GrSurfaceOrigin, kPremul_SkAlphaType, si_usage);
+    slot->mailbox_uv = sii_->CreateSharedImage(
+        gmb.get(), gmb_manager_, gfx::BufferPlane::UV, color_space,
+        kTopLeft_GrSurfaceOrigin, kPremul_SkAlphaType, si_usage);
+    if (slot->mailbox_y.IsZero() || slot->mailbox_uv.IsZero()) {
+      DestroySlotSharedImagesOnSequence(*slot);
+      return nullptr;
+    }
+  } else {
+    slot->mailbox_y = sii_->CreateSharedImage(
+        gmb.get(), gmb_manager_, gfx::BufferPlane::DEFAULT, color_space,
+        kTopLeft_GrSurfaceOrigin, kOpaque_SkAlphaType, si_usage);
+    if (slot->mailbox_y.IsZero()) {
+      return nullptr;
+    }
+  }
+
+  slot->gmb = std::move(gmb);
+  return slot;
+
+#elif BUILDFLAG(IS_MAC)
+  if (!gmb_manager_) {
+    return nullptr;
+  }
+
+  gfx::ScopedIOSurface io_surface(
+      gfx::CreateIOSurface(coded_size, buf_fmt, /*should_clear=*/false));
+  if (!io_surface) {
+    return nullptr;
+  }
+
+  gfx::GpuMemoryBufferHandle gmb_handle;
+  gmb_handle.type = gfx::IO_SURFACE_BUFFER;
+  gmb_handle.id = NextGpuMemoryBufferId();
+  gmb_handle.io_surface = io_surface;
+
+  auto gmb_iosurface = gpu::GpuMemoryBufferImplIOSurface::CreateFromHandle(
+      gmb_handle, coded_size, buf_fmt, gfx::BufferUsage::SCANOUT_VEA_CPU_READ,
+      base::DoNothing());
+  if (!gmb_iosurface) {
+    return nullptr;
+  }
+
+  constexpr uint32_t kMacUsage =
+      gpu::SHARED_IMAGE_USAGE_GLES2 | gpu::SHARED_IMAGE_USAGE_RASTER |
+      gpu::SHARED_IMAGE_USAGE_DISPLAY_READ | gpu::SHARED_IMAGE_USAGE_SCANOUT |
+      gpu::SHARED_IMAGE_USAGE_MACOS_VIDEO_TOOLBOX;
+  const uint32_t target = gpu::GetPlatformSpecificTextureTarget();
+
+  auto slot = base::MakeRefCounted<TextureSlot>(
+      buffer_id, coded_size, slot_format, target, /*overlay_capable=*/true);
+  if (biplanar) {
+    slot->mailbox_y = sii_->CreateSharedImage(
+        gmb_iosurface.get(), gmb_manager_, gfx::BufferPlane::Y, color_space,
+        kTopLeft_GrSurfaceOrigin, kPremul_SkAlphaType, kMacUsage);
+    slot->mailbox_uv = sii_->CreateSharedImage(
+        gmb_iosurface.get(), gmb_manager_, gfx::BufferPlane::UV, color_space,
+        kTopLeft_GrSurfaceOrigin, kPremul_SkAlphaType, kMacUsage);
+    if (slot->mailbox_y.IsZero() || slot->mailbox_uv.IsZero()) {
+      DestroySlotSharedImagesOnSequence(*slot);
+      return nullptr;
+    }
+  } else {
+    slot->mailbox_y = sii_->CreateSharedImage(
+        gmb_iosurface.get(), gmb_manager_, gfx::BufferPlane::DEFAULT,
+        color_space, kTopLeft_GrSurfaceOrigin, kOpaque_SkAlphaType, kMacUsage);
+    if (slot->mailbox_y.IsZero()) {
+      return nullptr;
+    }
+  }
+
+  slot->io_surface = std::move(io_surface);
+  slot->gmb_iosurface = std::move(gmb_iosurface);
+  return slot;
+#else
+  (void)buffer_id;
+  (void)coded_size;
+  (void)slot_format;
+  (void)color_space;
+  (void)buf_fmt;
+  (void)biplanar;
+  return nullptr;
+#endif
+}
+
+void ExternalVideoSource::SubmitImportedGpuFrameOnSequence(
+    std::unique_ptr<ImportedGpuPayload> payload) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  if (!payload) {
+    return;
+  }
+
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_ || mode_ != BackendMode::kTexture ||
+        !texture_device_.is_bound()) {
+      return;
+    }
+    has_completed_initial_setup_ = true;
+  }
+
+  if (!gpu_channel_ || gpu_channel_->IsLost() || !sii_) {
+    return;
+  }
+
+  const ImportedCacheKey key{payload->surface_key, payload->coded_size,
+                             payload->slot_format};
+  scoped_refptr<TextureSlot> slot;
+
+  if (payload->surface_key != 0) {
+    for (auto it = imported_lru_slots_.begin(); it != imported_lru_slots_.end();
+         ++it) {
+      if ((*it)->import_key == key && !(*it)->in_use_by_consumer) {
+        slot = *it;
+        imported_lru_slots_.erase(it);
+        imported_lru_slots_.push_front(slot);
+        break;
+      }
+    }
+  }
+
+  const gfx::BufferFormat buf_fmt = ToGfxBufferFormat(payload->slot_format);
+  const bool biplanar = IsBiplanarSlotFormat(payload->slot_format);
+
+  if (!slot) {
+    const bool cacheable = (payload->surface_key != 0);
+    const int32_t new_id = next_texture_buffer_id_++;
+
+#if BUILDFLAG(IS_WIN)
+    if (!payload->dxgi_nt_handle.IsValid()) {
+      return;
+    }
+    gfx::GpuMemoryBufferHandle gmb_handle;
+    gmb_handle.type = gfx::DXGI_SHARED_HANDLE;
+    gmb_handle.id = NextGpuMemoryBufferId();
+    gmb_handle.dxgi_handle = std::move(payload->dxgi_nt_handle);
+    gmb_handle.dxgi_token = gfx::DXGIHandleToken();
+
+    auto gmb_dxgi = gpu::GpuMemoryBufferImplDXGI::CreateFromHandle(
+        std::move(gmb_handle), payload->coded_size, buf_fmt,
+        gfx::BufferUsage::GPU_READ, base::DoNothing(), nullptr, nullptr);
+    if (!gmb_dxgi) {
+      return;
+    }
+    constexpr uint32_t kUsage =
+        gpu::SHARED_IMAGE_USAGE_GLES2 | gpu::SHARED_IMAGE_USAGE_RASTER |
+        gpu::SHARED_IMAGE_USAGE_DISPLAY_READ | gpu::SHARED_IMAGE_USAGE_SCANOUT;
+
+    slot = base::MakeRefCounted<TextureSlot>(
+        new_id, payload->coded_size, payload->slot_format,
+        static_cast<uint32_t>(GL_TEXTURE_2D), /*overlay_capable=*/true,
+        /*imported=*/true, cacheable);
+    slot->import_key = key;
+    if (biplanar) {
+      slot->mailbox_y = sii_->CreateSharedImage(
+          gmb_dxgi.get(), nullptr, gfx::BufferPlane::Y, payload->color_space,
+          kTopLeft_GrSurfaceOrigin, kPremul_SkAlphaType, kUsage);
+      slot->mailbox_uv = sii_->CreateSharedImage(
+          gmb_dxgi.get(), nullptr, gfx::BufferPlane::UV, payload->color_space,
+          kTopLeft_GrSurfaceOrigin, kPremul_SkAlphaType, kUsage);
+      if (slot->mailbox_y.IsZero() || slot->mailbox_uv.IsZero()) {
+        DestroySlotSharedImagesOnSequence(*slot);
+        return;
+      }
+    } else {
+      slot->mailbox_y = sii_->CreateSharedImage(
+          gmb_dxgi.get(), nullptr, gfx::BufferPlane::DEFAULT,
+          payload->color_space, kTopLeft_GrSurfaceOrigin, kOpaque_SkAlphaType,
+          kUsage);
+      if (slot->mailbox_y.IsZero()) {
+        return;
+      }
+    }
+    slot->gmb_dxgi = std::move(gmb_dxgi);
+
+#elif BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+    if (payload->native_pixmap_handle.planes.empty()) {
+      return;
+    }
+    auto gmb = std::make_unique<ExternalNativePixmapGmbImpl>(
+        NextGpuMemoryBufferId(), payload->coded_size, buf_fmt,
+        std::move(payload->native_pixmap_handle));
+    constexpr uint32_t kUsage = gpu::SHARED_IMAGE_USAGE_GLES2 |
+                                gpu::SHARED_IMAGE_USAGE_RASTER |
+                                gpu::SHARED_IMAGE_USAGE_DISPLAY_READ;
+    const gfx::BufferFormat plane0_fmt =
+        biplanar ? gfx::BufferFormat::R_8 : buf_fmt;
+    const gfx::BufferPlane plane0 =
+        biplanar ? gfx::BufferPlane::Y : gfx::BufferPlane::DEFAULT;
+    const uint32_t target =
+        gpu::NativeBufferNeedsPlatformSpecificTextureTarget(plane0_fmt, plane0)
+            ? gpu::GetPlatformSpecificTextureTarget()
+            : static_cast<uint32_t>(GL_TEXTURE_2D);
+
+    slot = base::MakeRefCounted<TextureSlot>(
+        new_id, payload->coded_size, payload->slot_format, target,
+        /*overlay_capable=*/false, /*imported=*/true, cacheable);
+    slot->import_key = key;
+    if (biplanar) {
+      slot->mailbox_y = sii_->CreateSharedImage(
+          gmb.get(), gmb_manager_, gfx::BufferPlane::Y, payload->color_space,
+          kTopLeft_GrSurfaceOrigin, kPremul_SkAlphaType, kUsage);
+      slot->mailbox_uv = sii_->CreateSharedImage(
+          gmb.get(), gmb_manager_, gfx::BufferPlane::UV, payload->color_space,
+          kTopLeft_GrSurfaceOrigin, kPremul_SkAlphaType, kUsage);
+      if (slot->mailbox_y.IsZero() || slot->mailbox_uv.IsZero()) {
+        DestroySlotSharedImagesOnSequence(*slot);
+        return;
+      }
+    } else {
+      slot->mailbox_y = sii_->CreateSharedImage(
+          gmb.get(), gmb_manager_, gfx::BufferPlane::DEFAULT,
+          payload->color_space, kTopLeft_GrSurfaceOrigin, kOpaque_SkAlphaType,
+          kUsage);
+      if (slot->mailbox_y.IsZero()) {
+        return;
+      }
+    }
+    slot->gmb = std::move(gmb);
+
+#elif BUILDFLAG(IS_MAC)
+    if (!payload->io_surface || !gmb_manager_) {
+      return;
+    }
+    gfx::GpuMemoryBufferHandle gmb_handle;
+    gmb_handle.type = gfx::IO_SURFACE_BUFFER;
+    gmb_handle.id = NextGpuMemoryBufferId();
+    gmb_handle.io_surface = payload->io_surface;
+
+    auto gmb_iosurface = gpu::GpuMemoryBufferImplIOSurface::CreateFromHandle(
+        gmb_handle, payload->coded_size, buf_fmt,
+        gfx::BufferUsage::SCANOUT_VEA_CPU_READ, base::DoNothing());
+    if (!gmb_iosurface) {
+      return;
+    }
+
+    constexpr uint32_t kMacUsage =
+        gpu::SHARED_IMAGE_USAGE_GLES2 | gpu::SHARED_IMAGE_USAGE_RASTER |
+        gpu::SHARED_IMAGE_USAGE_DISPLAY_READ | gpu::SHARED_IMAGE_USAGE_SCANOUT |
+        gpu::SHARED_IMAGE_USAGE_MACOS_VIDEO_TOOLBOX;
+    const uint32_t target = gpu::GetPlatformSpecificTextureTarget();
+
+    slot = base::MakeRefCounted<TextureSlot>(
+        new_id, payload->coded_size, payload->slot_format, target,
+        /*overlay_capable=*/true, /*imported=*/true, cacheable);
+    slot->import_key = key;
+    if (biplanar) {
+      slot->mailbox_y = sii_->CreateSharedImage(
+          gmb_iosurface.get(), gmb_manager_, gfx::BufferPlane::Y,
+          payload->color_space, kTopLeft_GrSurfaceOrigin, kPremul_SkAlphaType,
+          kMacUsage);
+      slot->mailbox_uv = sii_->CreateSharedImage(
+          gmb_iosurface.get(), gmb_manager_, gfx::BufferPlane::UV,
+          payload->color_space, kTopLeft_GrSurfaceOrigin, kPremul_SkAlphaType,
+          kMacUsage);
+      if (slot->mailbox_y.IsZero() || slot->mailbox_uv.IsZero()) {
+        DestroySlotSharedImagesOnSequence(*slot);
+        return;
+      }
+    } else {
+      slot->mailbox_y = sii_->CreateSharedImage(
+          gmb_iosurface.get(), gmb_manager_, gfx::BufferPlane::DEFAULT,
+          payload->color_space, kTopLeft_GrSurfaceOrigin, kOpaque_SkAlphaType,
+          kMacUsage);
+      if (slot->mailbox_y.IsZero()) {
+        return;
+      }
+    }
+    slot->io_surface = std::move(payload->io_surface);
+    slot->gmb_iosurface = std::move(gmb_iosurface);
+#else
+    (void)buf_fmt;
+    (void)biplanar;
+    return;
+#endif
+
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+    if (payload->sync_fence_fd.is_valid()) {
+      gfx::GpuFenceHandle fh;
+      fh.owned_fd = std::move(payload->sync_fence_fd);
+      auto fence = std::make_unique<gfx::GpuFence>(std::move(fh));
+      sii_->UpdateSharedImage(gpu::SyncToken(), std::move(fence),
+                              slot->mailbox_y);
+    }
+#endif
+
+    const gpu::SyncToken sync_token = sii_->GenVerifiedSyncToken();
+    if (!sync_token.HasData() || gpu_channel_->IsLost()) {
+      DestroySlotSharedImagesOnSequence(*slot);
+      return;
+    }
+    RegisterSlotMailboxesOnSequence(*slot, sync_token);
+    if (cacheable) {
+      imported_lru_slots_.push_front(slot);
+      EvictIdleImportedSlotsIfNeededOnSequence();
+    }
+  } else {
+    // Existing cached SharedImage hit: notify GPU service of updated content.
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+    if (payload->sync_fence_fd.is_valid()) {
+      gfx::GpuFenceHandle fh;
+      fh.owned_fd = std::move(payload->sync_fence_fd);
+      auto fence = std::make_unique<gfx::GpuFence>(std::move(fh));
+      sii_->UpdateSharedImage(gpu::SyncToken(), std::move(fence),
+                              slot->mailbox_y);
+      if (biplanar) {
+        sii_->UpdateSharedImage(gpu::SyncToken(), slot->mailbox_uv);
+      }
+    } else {
+      sii_->UpdateSharedImage(gpu::SyncToken(), slot->mailbox_y);
+      if (biplanar) {
+        sii_->UpdateSharedImage(gpu::SyncToken(), slot->mailbox_uv);
+      }
+    }
+    sii_->Flush();
+#elif BUILDFLAG(IS_MAC)
+    sii_->UpdateSharedImage(gpu::SyncToken(), slot->mailbox_y);
+    if (biplanar) {
+      sii_->UpdateSharedImage(gpu::SyncToken(), slot->mailbox_uv);
+    }
+    sii_->Flush();
+#endif
+  }
+
+  slot->in_use_by_consumer = true;
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_ || mode_ != BackendMode::kTexture ||
+        !texture_device_.is_bound()) {
+      slot->in_use_by_consumer = false;
+      return;
+    }
+    slot->submit_seq = ++next_submit_seq_;
+    slot->in_flight_since = base::TimeTicks::Now();
+    slot->dma_in_progress = false;
+    slot->release_runner = std::move(payload->release_runner);
+    in_flight_texture_slots_[slot->buffer_id] = slot;
+  }
+
+  media::mojom::VideoFrameInfoPtr info = media::mojom::VideoFrameInfo::New();
+  info->timestamp = base::Microseconds(payload->timestamp_us);
+  info->metadata.frame_rate = max_fps_;
+  info->metadata.reference_time = payload->reference_time;
+  info->metadata.allow_overlay = slot->allow_overlay;
+  info->metadata.read_lock_fences_enabled = true;
+  info->pixel_format = ToMediaVideoPixelFormat(payload->slot_format);
+  info->coded_size = payload->coded_size;
+  info->visible_rect = payload->visible_rect;
+  info->is_premapped = false;
+  info->color_space = payload->color_space;
+  texture_device_->OnFrameReadyInBuffer(slot->buffer_id, std::move(info));
+}
+
+void ExternalVideoSource::EvictIdleImportedSlotsIfNeededOnSequence() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  while (imported_lru_slots_.size() > kMaxImportedLruSlots) {
+    bool evicted = false;
+    for (auto it = imported_lru_slots_.rbegin();
+         it != imported_lru_slots_.rend(); ++it) {
+      if (!(*it)->in_use_by_consumer) {
+        scoped_refptr<TextureSlot> victim = *it;
+        imported_lru_slots_.erase(std::next(it).base());
+        if (registered_texture_buffer_ids_.erase(victim->buffer_id) > 0 &&
+            texture_device_.is_bound()) {
+          texture_device_->OnBufferRetired(victim->buffer_id);
+        }
+        DestroySlotSharedImagesOnSequence(*victim);
+        evicted = true;
+        break;
+      }
+    }
+    if (!evicted) {
+      break;
+    }
+  }
+}
+
+void ExternalVideoSource::DestroySlotSharedImagesOnSequence(
+    const TextureSlot& slot) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  if (!sii_) {
+    return;
+  }
+  if (!slot.mailbox_y.IsZero()) {
+    sii_->DestroySharedImage(gpu::SyncToken(), slot.mailbox_y);
+  }
+  if (!slot.mailbox_uv.IsZero()) {
+    sii_->DestroySharedImage(gpu::SyncToken(), slot.mailbox_uv);
+  }
+  sii_->Flush();
+}
+
+void ExternalVideoSource::ReleaseAllTextureResourcesOnSequence(
+    bool retire_on_device) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  std::deque<scoped_refptr<TextureSlot>> free_slots;
+  std::map<int32_t, scoped_refptr<TextureSlot>> in_flight_slots;
+  std::unique_ptr<ColdStartGpuFrame> cold_gpu;
+  {
+    base::AutoLock lock(lock_);
+    free_slots.swap(free_texture_slots_);
+    in_flight_slots.swap(in_flight_texture_slots_);
+    cold_gpu = std::move(cold_start_gpu_frame_);
+    texture_pool_coded_size_ = gfx::Size();
+    texture_alloc_in_flight_ = false;
+    reclaim_in_flight_ = false;
+  }
+  cold_gpu.reset();
+
+  for (const auto& slot : free_slots) {
+    slot->release_runner.RunNow();
+    if (retire_on_device && texture_device_.is_bound() &&
+        registered_texture_buffer_ids_.erase(slot->buffer_id) > 0) {
+      texture_device_->OnBufferRetired(slot->buffer_id);
+    }
+    DestroySlotSharedImagesOnSequence(*slot);
+  }
+  for (const auto& [id, slot] : in_flight_slots) {
+    slot->release_runner.RunNow();
+    slot->in_use_by_consumer = false;
+    DestroySlotSharedImagesOnSequence(*slot);
+  }
+  for (const auto& lru_slot : imported_lru_slots_) {
+    lru_slot->release_runner.RunNow();
+    if (in_flight_slots.find(lru_slot->buffer_id) == in_flight_slots.end()) {
+      if (retire_on_device && texture_device_.is_bound() &&
+          registered_texture_buffer_ids_.erase(lru_slot->buffer_id) > 0) {
+        texture_device_->OnBufferRetired(lru_slot->buffer_id);
+      }
+      DestroySlotSharedImagesOnSequence(*lru_slot);
+    }
+  }
+  imported_lru_slots_.clear();
+  registered_texture_buffer_ids_.clear();
+}
+
+void ExternalVideoSource::SubmitTextureFrameOnSequence(
+    int32_t buffer_id,
+    SlotPixelFormat slot_format,
+    gfx::Size coded_size,
+    gfx::Rect visible_rect,
+    int64_t timestamp_us,
+    base::TimeTicks reference_time,
+    gfx::ColorSpace color_space) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+
+  scoped_refptr<TextureSlot> slot;
+  ScopedGpuReleaseRunner orphan_release;
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_ || mode_ != BackendMode::kTexture ||
+        !texture_device_.is_bound()) {
+      auto it = in_flight_texture_slots_.find(buffer_id);
+      if (it != in_flight_texture_slots_.end()) {
+        orphan_release = std::move(it->second->release_runner);
+        in_flight_texture_slots_.erase(it);
+      }
+      return;
+    }
+    auto it = in_flight_texture_slots_.find(buffer_id);
+    if (it == in_flight_texture_slots_.end()) {
+      return;
+    }
+    it->second->dma_in_progress = false;
+    it->second->in_flight_since = base::TimeTicks::Now();
+    slot = it->second;
+  }
+  orphan_release.RunNow();
+
+  if (!gpu_channel_ || gpu_channel_->IsLost()) {
+    FallbackToSharedMemoryOnSequence("GPU channel lost during frame submit");
+    return;
+  }
+
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_MAC)
+  if (sii_ && slot) {
+    sii_->UpdateSharedImage(gpu::SyncToken(), slot->mailbox_y);
+    if (!slot->mailbox_uv.IsZero()) {
+      sii_->UpdateSharedImage(gpu::SyncToken(), slot->mailbox_uv);
+    }
+    sii_->Flush();
+  }
+#endif
+
+  media::mojom::VideoFrameInfoPtr info = media::mojom::VideoFrameInfo::New();
+  info->timestamp = base::Microseconds(timestamp_us);
+  info->metadata.frame_rate = max_fps_;
+  info->metadata.reference_time = reference_time;
+  info->metadata.allow_overlay = slot->allow_overlay;
+  info->metadata.read_lock_fences_enabled = true;
+  info->pixel_format = ToMediaVideoPixelFormat(slot_format);
+  info->coded_size = coded_size;
+  info->visible_rect = visible_rect;
+  info->is_premapped = false;
+  info->color_space = color_space;
+  texture_device_->OnFrameReadyInBuffer(buffer_id, std::move(info));
+}
+
+void ExternalVideoSource::HandleTextureUploadFailureOnSequence(
+    int32_t buffer_id,
+    const char* reason) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  ScopedGpuReleaseRunner release_runner;
+  {
+    base::AutoLock lock(lock_);
+    auto it = in_flight_texture_slots_.find(buffer_id);
+    if (it != in_flight_texture_slots_.end()) {
+      release_runner = std::move(it->second->release_runner);
+      in_flight_texture_slots_.erase(it);
+    }
+  }
+  release_runner.RunNow();
+  FallbackToSharedMemoryOnSequence(reason ? reason : "GPU upload failed");
+}
+
+void ExternalVideoSource::ReturnTransientDroppedSlot(int32_t buffer_id) {
+  scoped_refptr<TextureSlot> stale_slot;
+  ScopedGpuReleaseRunner release_runner;
+  {
+    base::AutoLock lock(lock_);
+    auto it = in_flight_texture_slots_.find(buffer_id);
+    if (it == in_flight_texture_slots_.end()) {
+      return;
+    }
+    scoped_refptr<TextureSlot> slot = std::move(it->second);
+    in_flight_texture_slots_.erase(it);
+    slot->dma_in_progress = false;
+    release_runner = std::move(slot->release_runner);
+    if (!shut_down_ && mode_ == BackendMode::kTexture && !slot->is_imported &&
+        slot->coded_size == texture_pool_coded_size_ &&
+        slot->slot_format == texture_pool_format_) {
+      free_texture_slots_.push_back(std::move(slot));
+    } else {
+      stale_slot = std::move(slot);
+    }
+  }
+  release_runner.RunNow();
+  if (stale_slot) {
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](scoped_refptr<ExternalVideoSource> self,
+               scoped_refptr<TextureSlot> s) {
+              s->in_use_by_consumer = false;
+              if (!s->cache_in_lru) {
+                if (self->registered_texture_buffer_ids_.erase(s->buffer_id) >
+                        0 &&
+                    self->texture_device_.is_bound()) {
+                  self->texture_device_->OnBufferRetired(s->buffer_id);
+                }
+                self->DestroySlotSharedImagesOnSequence(*s);
+              }
+            },
+            base::WrapRefCounted(this), std::move(stale_slot)));
+  }
+}
+
+void ExternalVideoSource::OnFinishedConsumingBuffer(int32_t buffer_id) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+
+  scoped_refptr<TextureSlot> finished_slot;
+  ScopedGpuReleaseRunner release_runner;
+  bool return_to_pool = false;
+  bool keep_in_lru = false;
+  {
+    base::AutoLock lock(lock_);
+    auto it = in_flight_texture_slots_.find(buffer_id);
+    if (it == in_flight_texture_slots_.end()) {
+      return;
+    }
+    finished_slot = std::move(it->second);
+    in_flight_texture_slots_.erase(it);
+    finished_slot->dma_in_progress = false;
+    release_runner = std::move(finished_slot->release_runner);
+    if (finished_slot->submit_seq > last_completed_seq_) {
+      last_completed_seq_ = finished_slot->submit_seq;
+    }
+
+    if (!finished_slot->is_imported && !shut_down_ &&
+        mode_ == BackendMode::kTexture &&
+        finished_slot->coded_size == texture_pool_coded_size_ &&
+        finished_slot->slot_format == texture_pool_format_) {
+      free_texture_slots_.push_back(finished_slot);
+      return_to_pool = true;
+    } else if (finished_slot->is_imported && finished_slot->cache_in_lru &&
+               !shut_down_ && mode_ == BackendMode::kTexture) {
+      keep_in_lru = true;
+    }
+  }
+
+  release_runner.RunNow();
+  if (return_to_pool || !finished_slot) {
+    return;
+  }
+
+  if (finished_slot->is_imported) {
+    finished_slot->in_use_by_consumer = false;
+    if (keep_in_lru) {
+      EvictIdleImportedSlotsIfNeededOnSequence();
+      return;
+    }
+  }
+
+  if (registered_texture_buffer_ids_.erase(finished_slot->buffer_id) > 0 &&
+      texture_device_.is_bound()) {
+    texture_device_->OnBufferRetired(finished_slot->buffer_id);
+  }
+  DestroySlotSharedImagesOnSequence(*finished_slot);
+}
+
+// ---------------------------------------------------------------------------
+// Pre-reserved SharedMemory fallback backend (2-slot pre-reserved queue)
+// ---------------------------------------------------------------------------
+
+void ExternalVideoSource::ReserveBufferOnSequence() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  if (shmem_ipc_in_flight_) {
+    return;
+  }
+
+  gfx::Size coded_size;
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_ || mode_ != BackendMode::kSharedMemory ||
+        !shmem_device_.is_bound() || desired_coded_size_.IsEmpty() ||
+        reserved_slots_.size() >= kTargetReservedShmemSlots) {
+      reserve_in_flight_ = false;
+      return;
+    }
+    reserve_in_flight_ = true;
+    coded_size = desired_coded_size_;
+  }
+
+  shmem_ipc_in_flight_ = true;
+  shmem_device_->RequestFrameBuffer(
+      coded_size, media::PIXEL_FORMAT_I420, /*strides=*/nullptr,
+      base::BindOnce(&ExternalVideoSource::OnBufferReserved,
+                     base::WrapRefCounted(this), coded_size));
+}
+
+void ExternalVideoSource::OnBufferReserved(gfx::Size requested_coded_size,
+                                           int32_t buffer_id) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  shmem_ipc_in_flight_ = false;
+
+  if (buffer_id == video_capture::mojom::kInvalidBufferId) {
+    bool schedule_retry = false;
+    {
+      base::AutoLock lock(lock_);
+      has_completed_initial_setup_ = true;
+      cold_start_frame_ = nullptr;
+      if (!shut_down_ && mode_ == BackendMode::kSharedMemory &&
+          shmem_device_.is_bound() && reserved_slots_.empty() &&
+          consecutive_empty_reserves_ < kMaxEmptyReserveRetries) {
+        ++consecutive_empty_reserves_;
+        schedule_retry = true;
+      } else {
+        reserve_in_flight_ = false;
+      }
+    }
+    if (schedule_retry) {
+      task_runner_->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&ExternalVideoSource::ReserveBufferOnSequence,
+                         base::WrapRefCounted(this)),
+          kEmptyReserveRetryDelay);
+    }
+    return;
+  }
+
+  scoped_refptr<SharedBufferSlot> slot;
+  scoped_refptr<media::VideoFrame> cold_frame;
+  bool want_another_reserve = false;
+  {
+    base::AutoLock lock(lock_);
+    if (shut_down_ || mode_ != BackendMode::kSharedMemory ||
+        !shmem_device_.is_bound()) {
+      reserve_in_flight_ = false;
+      return;
+    }
+
+    has_completed_initial_setup_ = true;
+    consecutive_empty_reserves_ = 0;
+
+    auto it = shmem_buffers_.find(buffer_id);
+    if (it == shmem_buffers_.end() || !it->second ||
+        !it->second->mapping.IsValid()) {
+      LOG(ERROR) << "cef_external_video: unknown or unmapped buffer "
+                 << buffer_id;
+      reserve_in_flight_ = false;
+      return;
+    }
+    slot = it->second;
+
+    if (cold_start_frame_) {
+      cold_frame = std::move(cold_start_frame_);
+    } else {
+      reserved_slots_.emplace_back(std::move(slot), requested_coded_size);
+      want_another_reserve =
+          (reserved_slots_.size() < kTargetReservedShmemSlots);
+      if (!want_another_reserve) {
+        reserve_in_flight_ = false;
+      }
+    }
+  }
+
+  if (!cold_frame) {
+    if (want_another_reserve) {
+      ReserveBufferOnSequence();
+    }
+    return;
+  }
+
+  const size_t needed = media::VideoFrame::AllocationSize(
+      media::PIXEL_FORMAT_I420, cold_frame->coded_size());
+  if (slot->mapping.size() >= needed &&
+      cold_frame->coded_size() == requested_coded_size) {
+    StreamCopyI420ToMapping(
+        cold_frame->data(media::VideoFrame::kYPlane),
+        cold_frame->stride(media::VideoFrame::kYPlane),
+        cold_frame->data(media::VideoFrame::kUPlane),
+        cold_frame->stride(media::VideoFrame::kUPlane),
+        cold_frame->data(media::VideoFrame::kVPlane),
+        cold_frame->stride(media::VideoFrame::kVPlane),
+        cold_frame->visible_rect().width(),
+        cold_frame->visible_rect().height(), cold_frame->coded_size(),
+        static_cast<uint8_t*>(slot->mapping.memory()));
+    SubmitShmemFrameOnSequence(
+        slot->buffer_id, cold_frame->coded_size(), cold_frame->visible_rect(),
+        cold_frame->timestamp().InMicroseconds(),
+        cold_frame->metadata().reference_time.value_or(base::TimeTicks::Now()),
+        cold_frame->ColorSpace());
+  } else {
+    const int dw = requested_coded_size.width();
+    const int dh = requested_coded_size.height();
+    const int dcw = dw / 2;
+    const int dch = dh / 2;
+    uint8_t* dst_y = static_cast<uint8_t*>(slot->mapping.memory());
+    uint8_t* dst_u = dst_y + static_cast<size_t>(dw) * dh;
+    uint8_t* dst_v = dst_u + static_cast<size_t>(dcw) * dch;
+    libyuv::I420Scale(cold_frame->data(media::VideoFrame::kYPlane),
+                      cold_frame->stride(media::VideoFrame::kYPlane),
+                      cold_frame->data(media::VideoFrame::kUPlane),
+                      cold_frame->stride(media::VideoFrame::kUPlane),
+                      cold_frame->data(media::VideoFrame::kVPlane),
+                      cold_frame->stride(media::VideoFrame::kVPlane),
+                      cold_frame->visible_rect().width(),
+                      cold_frame->visible_rect().height(), dst_y, dw, dst_u,
+                      dcw, dst_v, dcw, dw, dh, libyuv::kFilterBilinear);
+    SubmitShmemFrameOnSequence(
+        slot->buffer_id, requested_coded_size, gfx::Rect(dw, dh),
+        cold_frame->timestamp().InMicroseconds(),
+        cold_frame->metadata().reference_time.value_or(base::TimeTicks::Now()),
+        cold_frame->ColorSpace());
+  }
+}
+
+void ExternalVideoSource::SubmitShmemFrameOnSequence(
+    int32_t buffer_id,
+    gfx::Size coded_size,
+    gfx::Rect visible_rect,
+    int64_t timestamp_us,
+    base::TimeTicks reference_time,
+    gfx::ColorSpace color_space) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  if (!shmem_device_.is_bound()) {
+    base::AutoLock lock(lock_);
+    reserve_in_flight_ = false;
+    return;
+  }
+
+  media::mojom::VideoFrameInfoPtr info = media::mojom::VideoFrameInfo::New();
+  info->timestamp = base::Microseconds(timestamp_us);
+  info->metadata.frame_rate = max_fps_;
+  info->metadata.reference_time = reference_time;
+  info->pixel_format = media::PIXEL_FORMAT_I420;
+  info->coded_size = coded_size;
+  info->visible_rect = visible_rect;
+  info->is_premapped = false;
+  info->color_space = color_space;
+  shmem_device_->OnFrameReadyInBuffer(buffer_id, std::move(info));
+
+  ReserveBufferOnSequence();
+}
+
+void ExternalVideoSource::OnNewBuffer(
+    int32_t buffer_id,
+    media::mojom::VideoBufferHandlePtr buffer_handle,
+    OnNewBufferCallback callback) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  if (buffer_handle->is_unsafe_shmem_region()) {
+    base::WritableSharedMemoryMapping mapping =
+        buffer_handle->get_unsafe_shmem_region().Map();
+    if (mapping.IsValid()) {
+      base::AutoLock lock(lock_);
+      if (!shut_down_) {
+        shmem_buffers_[buffer_id] = base::MakeRefCounted<SharedBufferSlot>(
+            buffer_id, std::move(mapping));
+      }
+    } else {
+      LOG(ERROR) << "cef_external_video: failed to map buffer " << buffer_id;
+    }
+  } else {
+    LOG(ERROR) << "cef_external_video: unexpected buffer handle type";
+  }
+  std::move(callback).Run();
+}
+
+void ExternalVideoSource::OnBufferRetired(int32_t buffer_id) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  base::AutoLock lock(lock_);
+  shmem_buffers_.erase(buffer_id);
+  for (auto it = reserved_slots_.begin(); it != reserved_slots_.end();) {
+    if (it->first && it->first->buffer_id == buffer_id) {
+      it = reserved_slots_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Teardown & Mojo error handlers
+// ---------------------------------------------------------------------------
+
+void ExternalVideoSource::ShutdownOnSequence() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  ReleaseAllTextureResourcesOnSequence(/*retire_on_device=*/false);
+  access_handler_receiver_.reset();
+  texture_device_.reset();
+  sii_.reset();
+  gpu_channel_.reset();
+  gmb_manager_ = nullptr;
+#if BUILDFLAG(IS_WIN)
+  d3d12_uploader_.reset();
+#endif
+
+  shmem_ipc_in_flight_ = false;
+  shmem_device_.reset();
+  producer_receiver_.reset();
+  provider_.reset();
+
+  std::unique_ptr<ColdStartGpuFrame> cold_gpu;
+  {
+    base::AutoLock lock(lock_);
+    shut_down_ = true;
+    device_ready_ = false;
+    reserve_in_flight_ = false;
+    reserved_slots_.clear();
+    cold_start_frame_ = nullptr;
+    cold_gpu = std::move(cold_start_gpu_frame_);
+    shmem_buffers_.clear();
+#if BUILDFLAG(IS_WIN)
+    d3d12_uploader_shared_.reset();
+#endif
+  }
+  cold_gpu.reset();
+}
+
+void ExternalVideoSource::OnProviderError() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  LOG(WARNING) << "cef_external_video: lost connection to the video capture "
+                  "service for device "
+               << device_info_.descriptor.device_id;
+  ShutdownOnSequence();
+}
+
+void ExternalVideoSource::OnTextureDeviceError() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  if (provider_.is_bound()) {
+    FallbackToSharedMemoryOnSequence("TextureVirtualDevice pipe disconnected");
+    return;
+  }
+  OnProviderError();
+}
+
+void ExternalVideoSource::OnShmemDeviceError() {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  OnProviderError();
+}
+
+}  // namespace cef_external_video
+
+// C API (include/cef_external_video.h).
+
+struct _cef_external_video_t {
+  scoped_refptr<cef_external_video::ExternalVideoSource> source;
+};
+
+CEF_EXPORT cef_external_video_t* cef_external_video_create(
+    const char* device_id,
+    const char* label,
+    int max_width,
+    int max_height,
+    float max_fps) {
+  if (!device_id || max_width < 0 || max_height < 0 || !(max_fps >= 0.f))
+    return nullptr;
+  if (max_width == 0)
+    max_width = CEF_EXTERNAL_VIDEO_DEFAULT_MAX_WIDTH;
+  if (max_height == 0)
+    max_height = CEF_EXTERNAL_VIDEO_DEFAULT_MAX_HEIGHT;
+  if (max_fps == 0.f)
+    max_fps = CEF_EXTERNAL_VIDEO_DEFAULT_MAX_FPS;
+  auto source = cef_external_video::ExternalVideoSource::Create(
+      device_id, label ? label : "", gfx::Size(max_width, max_height),
+      max_fps);
+  if (!source)
+    return nullptr;
+  return new _cef_external_video_t{std::move(source)};
+}
+
+CEF_EXPORT int cef_external_video_push_frame(
+    cef_external_video_t* handle,
+    const uint8_t* y_data,
+    int y_stride,
+    const uint8_t* u_data,
+    int u_stride,
+    const uint8_t* v_data,
+    int v_stride,
+    int width,
+    int height,
+    int64_t timestamp_us,
+    const cef_external_video_color_t* color) {
+  if (!handle || !handle->source)
+    return 0;
+  return handle->source->PushFrame(
+             y_data, y_stride, u_data, u_stride, v_data, v_stride, width,
+             height, timestamp_us,
+             cef_external_video::ToGfxColorSpace(color, height))
+             ? 1
+             : 0;
+}
+
+CEF_EXPORT int cef_external_video_push_gpu_frame(
+    cef_external_video_t* handle,
+    const cef_external_video_gpu_frame_t* frame) {
+  if (!handle || !handle->source || !frame)
+    return 0;
+  return handle->source->PushGpuFrame(*frame) ? 1 : 0;
+}
+
+CEF_EXPORT void cef_external_video_destroy(cef_external_video_t* handle) {
+  if (!handle)
+    return;
+  if (handle->source)
+    handle->source->Shutdown();
+  delete handle;
+}
