+#elif defined(ARCH_CPU_ARM64)
+
+void StreamCopyBytes(const uint8_t* src, uint8_t* dst, size_t count) {
+  if (count < 64) {
+    std::memcpy(dst, src, count);
+    return;
+  }
+
+  const uintptr_t misalign = reinterpret_cast<uintptr_t>(dst) & 15u;
+  if (misalign != 0) {
+    const size_t peel = 16u - misalign;
+    std::memcpy(dst, src, peel);
+    src += peel;
+    dst += peel;
+    count -= peel;
+  }
+
+  // Clang lowers consecutive 16-byte __builtin_nontemporal_store calls on
+  // AArch64 to native `stnp q0, q1, [dst]` non-temporal pair instructions.
+  using Vec16B = uint64_t __attribute__((vector_size(16)));
+  while (count >= 64) {
+    Vec16B v0, v1, v2, v3;
+    std::memcpy(&v0, src, 16);
+    std::memcpy(&v1, src + 16, 16);
+    std::memcpy(&v2, src + 32, 16);
+    std::memcpy(&v3, src + 48, 16);
+    auto* d = reinterpret_cast<Vec16B*>(dst);
+    __builtin_nontemporal_store(v0, d);
+    __builtin_nontemporal_store(v1, d + 1);
+    __builtin_nontemporal_store(v2, d + 2);
+    __builtin_nontemporal_store(v3, d + 3);
+    src += 64;
+    dst += 64;
+    count -= 64;
+  }
+
+  if (count > 0) {
+    std::memcpy(dst, src, count);
+  }
+}
+
+[[maybe_unused]] void StreamInterleaveUVPairs(const uint8_t* u,
+                                              const uint8_t* v,
+                                              uint8_t* dst_uv,
+                                              size_t uv_pairs) {
+  const uintptr_t addr = reinterpret_cast<uintptr_t>(dst_uv);
+  if (uv_pairs < 16 || (addr & 1u) != 0) {
+    for (size_t i = 0; i < uv_pairs; ++i) {
+      dst_uv[2 * i] = u[i];
+      dst_uv[2 * i + 1] = v[i];
+    }
+    return;
+  }
+
+  const size_t misalign = addr & 15u;
+  if (misalign != 0) {
+    const size_t peel_pairs = (16u - misalign) / 2u;
+    for (size_t i = 0; i < peel_pairs; ++i) {
+      dst_uv[2 * i] = u[i];
+      dst_uv[2 * i + 1] = v[i];
+    }
+    u += peel_pairs;
+    v += peel_pairs;
+    dst_uv += peel_pairs * 2u;
+    uv_pairs -= peel_pairs;
+  }
+
+  using Vec16B = uint64_t __attribute__((vector_size(16)));
+  while (uv_pairs >= 16) {
+    const uint8x16_t u_vec = vld1q_u8(u);
+    const uint8x16_t v_vec = vld1q_u8(v);
+    const uint8x16x2_t zipped = vzipq_u8(u_vec, v_vec);
+    Vec16B out0, out1;
+    std::memcpy(&out0, &zipped.val[0], 16);
+    std::memcpy(&out1, &zipped.val[1], 16);
+    auto* d = reinterpret_cast<Vec16B*>(dst_uv);
+    __builtin_nontemporal_store(out0, d);
+    __builtin_nontemporal_store(out1, d + 1);
+    u += 16;
+    v += 16;
+    dst_uv += 32;
+    uv_pairs -= 16;
+  }
+
+  for (size_t i = 0; i < uv_pairs; ++i) {
+    dst_uv[2 * i] = u[i];
+    dst_uv[2 * i + 1] = v[i];
+  }
+}
+
+inline void StreamStoreFence() {
+  __asm__ __volatile__("dmb ishst" ::: "memory");
+}
+
+#else
+
+inline void StreamCopyBytes(const uint8_t* src, uint8_t* dst, size_t count) {
+  std::memcpy(dst, src, count);
+}
+
+[[maybe_unused]] inline void StreamInterleaveUVPairs(const uint8_t* u,
+                                                     const uint8_t* v,
+                                                     uint8_t* dst_uv,
+                                                     size_t uv_pairs) {
+  for (size_t i = 0; i < uv_pairs; ++i) {
+    dst_uv[2 * i] = u[i];
+    dst_uv[2 * i + 1] = v[i];
+  }
+}
+
+inline void StreamStoreFence() {}
+
+#endif
+
+void StreamCopyPlane(const uint8_t* src,
+                     int src_stride,
+                     uint8_t* dst,
+                     int dst_stride,
+                     int visible_width,
+                     int visible_height,
+                     int coded_width,
+                     int coded_height) {
+  if (visible_width <= 0 || visible_height <= 0) {
+    return;
+  }
+
+  if (src_stride == coded_width && dst_stride == coded_width &&
+      visible_width == coded_width) {
+    StreamCopyBytes(src, dst,
+                    static_cast<size_t>(coded_width) * visible_height);
+  } else {
+    for (int row = 0; row < visible_height; ++row) {
+      const uint8_t* src_row = src + static_cast<size_t>(row) * src_stride;
+      uint8_t* dst_row = dst + static_cast<size_t>(row) * dst_stride;
+      StreamCopyBytes(src_row, dst_row, static_cast<size_t>(visible_width));
+      if (coded_width > visible_width) {
+        std::memset(dst_row + visible_width, src_row[visible_width - 1],
+                    static_cast<size_t>(coded_width - visible_width));
+      }
+    }
+  }
+
+  if (coded_height > visible_height) {
+    const uint8_t* last_src_row =
+        src + static_cast<size_t>(visible_height - 1) * src_stride;
+    for (int row = visible_height; row < coded_height; ++row) {
+      uint8_t* dst_row = dst + static_cast<size_t>(row) * dst_stride;
+      StreamCopyBytes(last_src_row, dst_row,
+                      static_cast<size_t>(visible_width));
+      if (coded_width > visible_width) {
+        std::memset(dst_row + visible_width, last_src_row[visible_width - 1],
+                    static_cast<size_t>(coded_width - visible_width));
+      }
+    }
+  }
+}
+
+#if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+void StreamInterleaveUVPlane(const uint8_t* u,
+                             int u_stride,
+                             const uint8_t* v,
+                             int v_stride,
+                             uint8_t* dst_uv,
+                             int dst_uv_stride,
+                             int chroma_vis_w,
+                             int chroma_vis_h,
+                             int chroma_coded_w,
+                             int chroma_coded_h) {
+  if (chroma_vis_w <= 0 || chroma_vis_h <= 0) {
+    return;
+  }
+
+  if (u_stride == chroma_coded_w && v_stride == chroma_coded_w &&
+      dst_uv_stride == chroma_coded_w * 2 && chroma_vis_w == chroma_coded_w) {
+    StreamInterleaveUVPairs(
+        u, v, dst_uv, static_cast<size_t>(chroma_coded_w) * chroma_vis_h);
+  } else {
+    for (int row = 0; row < chroma_vis_h; ++row) {
+      const uint8_t* u_row = u + static_cast<size_t>(row) * u_stride;
+      const uint8_t* v_row = v + static_cast<size_t>(row) * v_stride;
+      uint8_t* dst_row = dst_uv + static_cast<size_t>(row) * dst_uv_stride;
+      StreamInterleaveUVPairs(u_row, v_row, dst_row,
+                              static_cast<size_t>(chroma_vis_w));
+      for (int col = chroma_vis_w; col < chroma_coded_w; ++col) {
+        dst_row[2 * col] = u_row[chroma_vis_w - 1];
+        dst_row[2 * col + 1] = v_row[chroma_vis_w - 1];
+      }
+    }
+  }
+
+  if (chroma_coded_h > chroma_vis_h) {
+    const uint8_t* last_u =
+        u + static_cast<size_t>(chroma_vis_h - 1) * u_stride;
+    const uint8_t* last_v =
+        v + static_cast<size_t>(chroma_vis_h - 1) * v_stride;
+    for (int row = chroma_vis_h; row < chroma_coded_h; ++row) {
+      uint8_t* dst_row = dst_uv + static_cast<size_t>(row) * dst_uv_stride;
+      StreamInterleaveUVPairs(last_u, last_v, dst_row,
+                              static_cast<size_t>(chroma_vis_w));
+      for (int col = chroma_vis_w; col < chroma_coded_w; ++col) {
+        dst_row[2 * col] = last_u[chroma_vis_w - 1];
+        dst_row[2 * col + 1] = last_v[chroma_vis_w - 1];
+      }
+    }
+  }
+}
+
+void StreamCopyI420ToNV12Planes(const uint8_t* y,
+                                int y_stride,
+                                const uint8_t* u,
+                                int u_stride,
+                                const uint8_t* v,
+                                int v_stride,
+                                int width,
+                                int height,
+                                const gfx::Size& coded_size,
+                                uint8_t* dst_y,
+                                int dst_y_stride,
+                                uint8_t* dst_uv,
+                                int dst_uv_stride) {
+  const int cw = coded_size.width();
+  const int ch = coded_size.height();
+  const int chroma_vis_w = (width + 1) / 2;
+  const int chroma_vis_h = (height + 1) / 2;
+  const int chroma_coded_w = cw / 2;
+  const int chroma_coded_h = ch / 2;
+
+  StreamCopyPlane(y, y_stride, dst_y, dst_y_stride, width, height, cw, ch);
+  StreamInterleaveUVPlane(u, u_stride, v, v_stride, dst_uv, dst_uv_stride,
+                          chroma_vis_w, chroma_vis_h, chroma_coded_w,
+                          chroma_coded_h);
+  StreamStoreFence();
+}
