+diff --git build/config/win/BUILD.gn build/config/win/BUILD.gn
+index a507539..cfe223e 100644
+--- build/config/win/BUILD.gn
++++ build/config/win/BUILD.gn
+@@ -97,6 +97,12 @@ config("compiler") {
+     # See https://crbug.com/1089996 issue #2 for details.
+     cflags += [ "/D__WRL_ENABLE_FUNCTION_STATICS__" ]
+ 
++    # MSVC 14.5x (VS 2026) STL headers, which ATL's cstringt.h includes for
++    # feature macros, refuse to compile with Clang < 20. Chromium's bundled
++    # clang is older, and with libc++ only a tiny part of the MSVC STL is
++    # reached via ATL, so allow the mismatch.
++    cflags += [ "/D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH" ]
++
+     # Tell clang which version of MSVC to emulate.
+     cflags += [ "-fmsc-version=1916" ]
+ 
