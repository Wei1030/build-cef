+// Returns a 16x16 I420 black VideoFrame backed by process-static planes (zero
+// pixel-buffer heap allocation) while preserving |source_frame|'s natural_size
+// and timestamp so videoWidth/videoHeight remain stable and hardware capture
+// buffers are immediately released.
+scoped_refptr<media::VideoFrame> CreateMinimalBlackFrame(
+    const media::VideoFrame& source_frame) {
+  static constexpr int kBlackDim = 16;
+  alignas(64) static uint8_t kBlackY[kBlackDim * kBlackDim] = {0};
+  alignas(64) static uint8_t kBlackUV[(kBlackDim / 2) * (kBlackDim / 2)] = {
+      0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
+      0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
+      0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
+      0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
+      0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80,
+      0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80};
+
+  const gfx::Size coded_size(kBlackDim, kBlackDim);
+  const gfx::Rect visible_rect(coded_size);
+  const gfx::Size natural_size = source_frame.natural_size().IsEmpty()
+                                     ? coded_size
+                                     : source_frame.natural_size();
+  scoped_refptr<media::VideoFrame> black_frame =
+      media::VideoFrame::WrapExternalYuvData(
+          media::PIXEL_FORMAT_I420, coded_size, visible_rect, natural_size,
+          /*y_stride=*/kBlackDim, /*u_stride=*/kBlackDim / 2,
+          /*v_stride=*/kBlackDim / 2, kBlackY, kBlackUV, kBlackUV,
+          source_frame.timestamp());
+  if (black_frame) {
+    black_frame->metadata().MergeMetadataFrom(source_frame.metadata());
+    black_frame->metadata().texture_owner = false;
+    black_frame->metadata().read_lock_fences_enabled = false;
+  }
+  return black_frame;
+}
